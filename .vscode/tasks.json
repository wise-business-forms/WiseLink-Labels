{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/WiseLabels.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-to-AZWBFDEV",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/WiseLabels.csproj",
                "--output",
                "\\\\azwbfdev\\c$\\IIS_SITES\\Wise4Labels"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"            
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/WiseLabels.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
