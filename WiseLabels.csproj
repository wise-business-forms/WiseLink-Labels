<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>$(MSBuildProjectDirectory)\Documentation\WiseLabels.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DinkToPdf" Version="1.0.8" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.103.0" />
    <PackageReference Include="Microsoft.Graph.Core" Version="3.2.5" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.2" />
    <PackageReference Include="Microsoft.Identity.Web.MicrosoftGraph" Version="4.3.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.3.1" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.3" />
    <ProjectReference Include="..\CERM.DataAccess\CERM.DataAccess.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure appsettings are always published (fixes "database connection not configured" when deployed) -->
    <Content Update="appsettings.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.*.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
  <None Include="Libraries\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>Always</CopyToPublishDirectory>
  </None>
</ItemGroup>
  <ItemGroup>
    <Compile Remove="CERM.DataAccess\**" />
    <Content Remove="CERM.DataAccess\**" />
    <EmbeddedResource Remove="CERM.DataAccess\**" />
    <None Remove="CERM.DataAccess\**" />
  </ItemGroup>
