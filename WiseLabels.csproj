<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>C:\Users\pmenefee\source\WiseLink-Labels\Documentation\WiseLabels.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <ProjectReference Include="..\CERM.DataAccess\CERM.DataAccess.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ensure appsettings are always published (fixes "database connection not configured" when deployed) -->
    <Content Update="appsettings.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.*.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\img\" />
  </ItemGroup>
