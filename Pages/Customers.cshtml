                        <dt>Min Quantity</dt><dd>${formatNumber(quoteData.MinimumCount || quoteData.minimumCount)}</dd>
                        <dt>Max Quantity</dt><dd>${formatNumber(quoteData.MaximumCount || quoteData.maximumCount)}</dd>
                    </dl>
                `;

                customerQuoteDetailsContent.innerHTML = detailsHtml;

