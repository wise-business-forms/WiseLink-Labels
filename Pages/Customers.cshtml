@page "/Customers"
@model CustomersModel
@{
    ViewData["Title"] = "Customers";
    Layout = "_Layout";

    // Server-side pagination constants (must match JS)
    const int rowsPerPage = 100;
    const int maxPagesToShow = 10;
    var totalCustomers = Model.Customers.Count;
    var totalPages = Math.Max(1, (int)Math.Ceiling(totalCustomers / (double)rowsPerPage));
    var startPage = 1;
    var endPage = Math.Min(maxPagesToShow, totalPages);
}

<style>
    .customer-details-panel {
        position: sticky;
        top: 1rem;
        align-self: flex-start;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .customer-quotes-list,
    .customer-quote-details {
        max-height: calc(100vh - 12rem);
        overflow-y: auto;
    }

    /* Full width for customers page */
    .customers-page .dashboard-main {
        padding: 2rem 0;
        max-width: 100%;
        width: 100%;
    }

    .customers-page .admin-page-title {
        padding: 0 2.5rem;
    }

    .customers-page .alert,
    .customers-page .mb-3:has(#searchInput),
    .customers-page .pagination {
        margin-left: 2.5rem;
        margin-right: 2.5rem;
    }

    .customers-content {
        width: 100%;
        padding: 0 2.5rem;
    }

    .customers-table-container {
        width: 100%;
    }

    #customersTable {
        width: 100%;
        table-layout: auto;
    }

    /* Contact row styles */
    .customer-row {
        cursor: pointer;
    }

    /* Hide rows beyond first page until JS takes over */
    .customer-row.initially-hidden {
        display: none;
    }

    /* Modal styles */
    .contact-list-item {
        transition: background-color 0.2s;
    }

    .contact-list-item:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="customers-page">
<div class="dashboard-container">
    @await Html.PartialAsync("_LeftSidebar")
    <main class="dashboard-main">
        <h1 class="admin-page-title">Customers</h1>

        @if (Model.IsFiltered && !string.IsNullOrWhiteSpace(Model.FilteredByUserId))
        {
            <div class="alert alert-info mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <svg width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                        <path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                    <span>
                        <strong>Filtered View:</strong> Showing only customers assigned to <code>@Model.FilteredByUserId</code>
                    </span>
                </div>
            </div>
        }

        <div class="mb-3">
            <input type="text" id="searchInput" class="form-control" placeholder="Search customers by name..." />
        </div>
        @* Server-side rendered pagination for instant display *@
        <ul id="paginationControlsTop" class="pagination">
            <li class="page-item disabled"><a class="page-link" href="#" data-page="0">&laquo; Previous</a></li>
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item@(i == 1 ? " active" : "")"><a class="page-link" href="#" data-page="@i">@i</a></li>
            }
            <li class="page-item@(totalPages <= 1 ? " disabled" : "")"><a class="page-link" href="#" data-page="2">Next &raquo;</a></li>
        </ul>
        <div class="customers-content">
            <div id="customersTableContainer" class="customers-table-container">
                <table class="table table-striped table-hover" id="customersTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th style="width: 400px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customersTableBody">
                        @{ var rowIndex = 0; }
                        @foreach (var customer in Model.Customers)
                        {
                            var isHidden = rowIndex >= rowsPerPage;
                            <tr class="customer-row@(isHidden ? " initially-hidden" : "")" data-customer-id="@customer.Id" data-customer-name="@customer.Name">
                                <td>@customer.Id</td>
                                <td>@customer.Name</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" 
                                                class="btn btn-outline-success btn-new-quote" 
                                                data-customer-id="@customer.Id"
                                                data-customer-name="@customer.Name"
                                                title="Create new quote">
                                            New Quote
                                        </button>
                                        <button type="button" 
                                                class="btn btn-outline-primary btn-view-orders" 
                                                data-customer-id="@customer.Id"
                                                data-customer-name="@customer.Name"
                                                title="View past orders">
                                            Past Orders
                                        </button>
                                        <a href="/Customers/Profile?customerId=@customer.Id" 
                                           class="btn btn-outline-secondary"
                                           title="View customer profile">
                                            Profile
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            rowIndex++;
                        }
                    </tbody>
                </table>
            </div>
            <aside id="customerDetailsPanel" class="customer-details-panel is-hidden">
                <h2 class="customer-details-title">Past Orders</h2>
                <div id="customerDetailsContent" class="customer-details-content"></div>
                <div id="customerQuotesList" class="customer-quotes-list">
                    <table class="table table-sm customer-quotes-table">
                        <thead>
                            <tr>
                                <th scope="col">Calculation ID</th>
                                <th scope="col">Estimate ID</th>
                                <th scope="col">Description</th>
                            </tr>
                        </thead>
                        <tbody id="customerQuotesTableBody">
                            <tr class="customer-quotes-empty">
                                <td colspan="3">Select a customer to view their past quotes.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div id="customerQuoteDetails" class="customer-quote-details is-hidden">
                    <button type="button" id="customerQuoteBackButton" class="btn btn-link customer-quote-back">&larr; Back to quotes</button>
                    <div id="customerQuoteDetailsContent"></div>
                    <div id="customerQuoteDetailsActions" class="customer-quote-actions"></div>
                </div>
            </aside>
        </div>
        @* Server-side rendered pagination for instant display *@
        <ul id="paginationControlsBottom" class="pagination">
            <li class="page-item disabled"><a class="page-link" href="#" data-page="0">&laquo; Previous</a></li>
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item@(i == 1 ? " active" : "")"><a class="page-link" href="#" data-page="@i">@i</a></li>
            }
            <li class="page-item@(totalPages <= 1 ? " disabled" : "")"><a class="page-link" href="#" data-page="2">Next &raquo;</a></li>
        </ul>
    </main>
</div>

<form method="post" asp-page-handler="UseQuote" id="useQuoteForm" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SelectedCalculationId" id="selectedCalculationId" />
    <input type="hidden" name="SelectedEstimateId" id="selectedEstimateId" />
    <input type="hidden" name="SelectedCustomerId" id="selectedCustomerId" />
    <input type="hidden" name="SelectedCustomerName" id="selectedCustomerName" />
    <input type="hidden" name="SelectedDescription" id="selectedDescription" />
    <input type="hidden" name="SelectedMaterial" id="selectedMaterial" />
    <input type="hidden" name="SelectedSubstrateId" id="selectedSubstrateId" />
    <input type="hidden" name="SelectedReferenceAtCustomer" id="selectedReferenceAtCustomer" />
    <input type="hidden" name="SelectedSize" id="selectedSize" />
    <input type="hidden" name="SelectedLabelShape" id="selectedLabelShape" />
    <input type="hidden" name="SelectedLabelWidth" id="selectedLabelWidth" />
    <input type="hidden" name="SelectedLabelHeight" id="selectedLabelHeight" />
    <input type="hidden" name="SelectedLabelRadius" id="selectedLabelRadius" />
    <input type="hidden" name="SelectedColour" id="selectedColour" />
    <input type="hidden" name="SelectedWinding" id="selectedWinding" />
    <input type="hidden" name="SelectedPackingProcedureId" id="selectedPackingProcedureId" />
    <input type="hidden" name="SelectedColourCodeId" id="selectedColourCodeId" />
    <input type="hidden" name="SelectedFinishingTypeId" id="selectedFinishingTypeId" />
    <input type="hidden" name="SelectedMinCount" id="selectedMinCount" />
    <input type="hidden" name="SelectedMaxCount" id="selectedMaxCount" />
</form>

<!-- Contact Selection Modal -->
<div class="modal fade" id="contactSelectionModal" tabindex="-1" aria-labelledby="contactSelectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contactSelectionModalLabel">Select Contact for New Quote</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong>Customer:</strong> <span id="modalCustomerName"></span></p>
                <div id="contactSelectionList" class="list-group">
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading contacts...</span>
                        </div>
                        <p class="mt-2 mb-0 text-muted">Loading contacts...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const tableBody = document.getElementById('customersTableBody');
        const paginationControlsTop = document.getElementById('paginationControlsTop');
        const paginationControlsBottom = document.getElementById('paginationControlsBottom');
        const rowsPerPage = 100;
        const maxPagesToShow = 10;
        const customerDetailsPanel = document.getElementById('customerDetailsPanel');
        const customerDetailsContent = document.getElementById('customerDetailsContent');
        const customerQuotesList = document.getElementById('customerQuotesList');
        const customerQuotesTableBody = document.getElementById('customerQuotesTableBody');
        const customerQuoteDetails = document.getElementById('customerQuoteDetails');
        const customerQuoteDetailsContent = document.getElementById('customerQuoteDetailsContent');
        const customerQuoteDetailsActions = document.getElementById('customerQuoteDetailsActions');
        const customerQuoteBackButton = document.getElementById('customerQuoteBackButton');
        const useQuoteForm = document.getElementById('useQuoteForm');
        const selectedEstimateInput = document.getElementById('selectedEstimateId');
        const selectedCustomerIdInput = document.getElementById('selectedCustomerId');
        const selectedCustomerNameInput = document.getElementById('selectedCustomerName');
        const selectedRowClass = 'customer-row-selected';
        const quotesPlaceholderMessage = 'Select a customer to view their past quotes.';
        const quotesLoadingMessage = 'Loading quotes...';
        const quotesEmptyMessage = 'No quotes were found for this customer.';
        const quotesErrorMessage = 'Unable to load quotes right now.';
        let currentPage = 1;
        let isPaginationBusy = false;

        // Modal elements
        const contactModal = new bootstrap.Modal(document.getElementById('contactSelectionModal'));
        const modalCustomerName = document.getElementById('modalCustomerName');
        const contactSelectionList = document.getElementById('contactSelectionList');

        // Store all rows initially (before any filtering/pagination)
        const allCustomerRows = Array.from(tableBody.querySelectorAll('tr.customer-row'));
        const customerRows = allCustomerRows.map(customerRow => ({ customerRow }));
        let filteredRows = [...customerRows];
        let currentQuotes = [];
        let selectedCustomerId = null;
        let selectedCustomerName = null;

        // Handle New Quote button click
        async function handleNewQuoteClick(customerId, customerName) {
            selectedCustomerId = customerId;
            selectedCustomerName = customerName;

            modalCustomerName.textContent = customerName;
            contactSelectionList.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading contacts...</span>
                    </div>
                    <p class="mt-2 mb-0 text-muted">Loading contacts...</p>
                </div>
            `;

            contactModal.show();

            try {
                const response = await fetch(`/api/customer-contacts?customerId=${encodeURIComponent(customerId)}`);
                if (!response.ok) throw new Error('Failed to load contacts');

                const contacts = await response.json();

                if (contacts.length === 0) {
                    contactSelectionList.innerHTML = `
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-person-x fs-1"></i>
                            <p class="mt-2 mb-0">No contacts found for this customer.</p>
                            <button type="button" class="btn btn-sm btn-primary mt-3" onclick="proceedWithoutContact()">
                                Continue Without Contact
                            </button>
                        </div>
                    `;
                } else {
                    contactSelectionList.innerHTML = contacts.map(contact => `
                        <button type="button" class="list-group-item list-group-item-action contact-list-item" 
                                onclick="selectContact('${escapeHtml(contact.fullName)}', '${escapeHtml(contact.email || '')}', '${escapeHtml(contact.phone || '')}')">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">${escapeHtml(contact.fullName)}</h6>
                                    ${contact.jobTitle ? `<small class="text-muted d-block">${escapeHtml(contact.jobTitle)}</small>` : ''}
                                    ${contact.email ? `<small class="text-muted"><i class="bi bi-envelope"></i> ${escapeHtml(contact.email)}</small>` : ''}
                                </div>
                                <i class="bi bi-arrow-right-circle fs-5 text-primary"></i>
                            </div>
                        </button>
                    `).join('');
                }
            } catch (error) {
                console.error('Error loading contacts:', error);
                contactSelectionList.innerHTML = `
                    <div class="alert alert-danger mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> Failed to load contacts. Please try again.
                    </div>
                `;
            }
        }

        // Global function for contact selection
        window.selectContact = function(contactName, contactEmail, contactPhone) {
            contactModal.hide();

            const params = new URLSearchParams({
                customerId: selectedCustomerId,
                customerName: selectedCustomerName,
                contactName: contactName,
                contactEmail: contactEmail || '',
                contactPhone: contactPhone || ''
            });

            window.location.href = `/GetQuote?${params.toString()}`;
        };

        // Global function for proceeding without contact
        window.proceedWithoutContact = function() {
            contactModal.hide();

            const params = new URLSearchParams({
                customerId: selectedCustomerId,
                customerName: selectedCustomerName
            });

            window.location.href = `/GetQuote?${params.toString()}`;
        };

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        const selectedDescriptionInput = document.getElementById('selectedDescription');
        const selectedMaterialInput = document.getElementById('selectedMaterial');
        const quoteRequestFields = [
            { key: 'estimateId', label: 'Estimate ID' },
            { key: 'customerId', label: 'Customer ID' },
            { key: 'customerDisplayName', label: 'Customer Name' },
            { key: 'name', label: 'Contact Name' },
            { key: 'email', label: 'Email' },
            { key: 'phone', label: 'Phone' },
            { key: 'referenceType', label: 'Reference Type' },
            { key: 'referenceValue', label: 'Reference Value' },
            { key: 'description', label: 'Description' },
            { key: 'shape', label: 'Shape' },
            { key: 'labelWidth', label: 'Label Width' },
            { key: 'labelHeight', label: 'Label Height' },
            { key: 'diameter', label: 'Diameter' },
            { key: 'corners', label: 'Corners' },
            { key: 'cuttingDie', label: 'Cutting Die' },
            { key: 'printing', label: 'Printing' },
            { key: 'material', label: 'Material' },
            { key: 'colorCode', label: 'Color Code' },
            { key: 'finish', label: 'Finish' },
            { key: 'applicationMethod', label: 'Application Method' },
            { key: 'unwindDirection', label: 'Unwind Direction' },
            { key: 'totalQuantity', label: 'Total Quantity' },
            { key: 'quantities', label: 'Quantities' },
            { key: 'artworkOption', label: 'Artwork Option' },
            { key: 'shapeValue', label: 'Shape Value' },
            { key: 'cornersValue', label: 'Corners Value' },
            { key: 'materialValue', label: 'Material Value' },
            { key: 'colorCodeValue', label: 'Color Code Value' },
            { key: 'finishValue', label: 'Finish Value' },
            { key: 'applicationMethodValue', label: 'Application Method Value' },
            { key: 'unwindDirectionValue', label: 'Unwind Direction Value' },
            { key: 'artworkOptionValue', label: 'Artwork Option Value' },
            { key: 'cuttingDieValue', label: 'Cutting Die Value' },
            { key: 'printingValue', label: 'Printing Value' },
            {
                key: 'createdDate',
                label: 'Created Date',
                format: value => formatDateValue(value)
            }
        ];

        function createEmptyQuoteRequest() {
            return {
                estimateId: '',
                customerId: '',
                customerDisplayName: '',
                name: '',
                email: '',
                phone: '',
                referenceType: '',
                referenceValue: '',
                description: '',
                shape: '',
                labelWidth: '',
                labelHeight: '',
                diameter: '',
                corners: '',
                cuttingDie: '',
                printing: '',
                material: '',
                colorCode: '',
                finish: '',
                applicationMethod: '',
                unwindDirection: '',
                totalQuantity: '',
                quantities: [],
                artworkOption: '',
                shapeValue: '',
                cornersValue: '',
                materialValue: '',
                colorCodeValue: '',
                finishValue: '',
                applicationMethodValue: '',
                unwindDirectionValue: '',
                artworkOptionValue: '',
                cuttingDieValue: '',
                printingValue: '',
                createdDate: ''
            };
        }

        function normalizeQuoteData(rawQuote) {
            const normalized = createEmptyQuoteRequest();
            normalized.estimateId = rawQuote.estimateId ?? rawQuote.EstimateId ?? '';
            normalized.customerId = rawQuote.customerId ?? rawQuote.CustomerId ?? selectedCustomerId ?? '';
            normalized.customerDisplayName = rawQuote.customerName ?? rawQuote.CustomerName ?? selectedCustomerName ?? '';
            normalized.name = rawQuote.contactName ?? rawQuote.ContactName ?? '';
            normalized.email = rawQuote.email ?? rawQuote.Email ?? '';
            normalized.phone = rawQuote.phoneNumber ?? rawQuote.PhoneNumber ?? '';
            normalized.referenceType = 'Past Quote';
            normalized.referenceValue = normalized.estimateId;
            normalized.description = rawQuote.description ?? rawQuote.Description ?? '';
            normalized.material = rawQuote.material ?? rawQuote.Material ?? '';
            normalized.createdDate = rawQuote.orderDate ?? rawQuote.OrderDate ?? rawQuote.deliveryDate ?? rawQuote.DeliveryDate ?? '';
            normalized.orderDate = rawQuote.orderDate ?? rawQuote.OrderDate ?? '';
            normalized.deliveryDate = rawQuote.deliveryDate ?? rawQuote.DeliveryDate ?? '';
            normalized.statusCode = rawQuote.statusCode ?? rawQuote.StatusCode ?? '';
            return normalized;
        }

        function formatQuoteFieldValue(value) {
            if (Array.isArray(value)) {
                return value.length ? value.join(', ') : '—';
            }
            if (value === undefined || value === null || value === '') {
                return '—';
            }
            return value;
        }

        function renderQuotesPlaceholder(message) {
            if (!customerQuotesTableBody) {
                return;
            }
            currentQuotes = [];

            // Check if this is the "no quotes found" message and we have a customer selected
            if (message === quotesEmptyMessage && selectedCustomerId && selectedCustomerName) {
                customerQuotesTableBody.innerHTML = `
                    <tr class="customer-quotes-empty">
                        <td colspan="3" style="text-align: center; padding: 2rem;">
                            <p class="mb-3">${message}</p>
                            <button type="button" class="btn btn-primary btn-sm" id="createNewQuoteBtn">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 0.5rem;">
                                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                </svg>
                                Create a New Quote
                            </button>
                        </td>
                    </tr>`;

                // Add click handler for the create new quote button
                const createBtn = document.getElementById('createNewQuoteBtn');
                if (createBtn) {
                    createBtn.addEventListener('click', function() {
                        createNewQuoteForCustomer();
                    });
                }
            } else {
                customerQuotesTableBody.innerHTML = `<tr class="customer-quotes-empty"><td colspan="3">${message}</td></tr>`;
            }

            showQuotesList();
        }

        function showQuotesList() {
            if (!customerQuotesList || !customerQuoteDetails) {
                return;
            }
            customerQuotesList.classList.remove('is-hidden');
            customerQuoteDetails.classList.add('is-hidden');
            if (customerQuoteDetailsActions) {
                customerQuoteDetailsActions.innerHTML = '';
            }
        }

        function createNewQuoteForCustomer() {
            if (!selectedCustomerId || !selectedCustomerName) {
                console.error('Missing customer information');
                return;
            }

            // Trigger the modal to select a contact
            handleNewQuoteClick(selectedCustomerId, selectedCustomerName);
        }

        function getSubstrateDescription(substrate) {
            // Handle null/undefined
            if (!substrate) {
                return '';
            }

            // Handle string (simple substrate description)
            if (typeof substrate === 'string') {
                return substrate;
            }

            // Handle object with Descriptions array
            if (substrate.Descriptions || substrate.descriptions) {
                const descriptions = substrate.Descriptions || substrate.descriptions;

                if (Array.isArray(descriptions)) {
                    // Try to find en-US description first
                    const enUS = descriptions.find(d => 
                        (d.ISOLanguageCode || d.isoLanguageCode || '').toLowerCase() === 'en-us'
                    );

                    if (enUS && (enUS.Description || enUS.description)) {
                        return enUS.Description || enUS.description;
                    }

                    // Fallback to first available description
                    if (descriptions.length > 0) {
                        const fallback = descriptions[0];
                        return fallback.Description || fallback.description || '';
                    }
                }
            }

            // Fallback to direct properties
            return substrate.Description || substrate.description || '';
        }

        async function showQuoteDetails(quote) {
            if (!customerQuoteDetails || !customerQuoteDetailsContent) {
                return;
            }

            const calculationId = quote.calculationId || '';
            if (!calculationId) {
                customerQuoteDetailsContent.innerHTML = '<p class="text-danger">No calculation ID available for this quote.</p>';
                customerQuotesList?.classList.add('is-hidden');
                customerQuoteDetails.classList.remove('is-hidden');
                return;
            }

            // Show loading state
            customerQuoteDetailsContent.innerHTML = '<p class="text-muted">Loading quote details...</p>';
            customerQuotesList?.classList.add('is-hidden');
            customerQuoteDetails.classList.remove('is-hidden');

            try {
                // Fetch full quote details from CERM API
                const response = await fetch(`/Api/CermCalculation?calculationId=${encodeURIComponent(calculationId)}`, {
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error(`Failed to load quote details: ${response.status}`);
                }

                const result = await response.json();
                const quoteData = result.Data || result.data || result;

                // Extract substrate information
                const substrateObj = quoteData.Substrate || quoteData.substrate;
                const substrateDescription = getSubstrateDescription(substrateObj);
                const substrateId = quoteData.SubstrateId || quoteData.substrateId || '';

                // Build detailed view from CERM API response
                const detailsHtml = `
                    <div style="background: #f8f9fa; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                        <div style="display: flex; gap: 2rem; flex-wrap: wrap; align-items: center; justify-content: space-between;">
                            <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
                                <div>
                                    <div style="font-size: 0.75rem; color: #6c757d; text-transform: uppercase; margin-bottom: 0.25rem;">Estimate ID</div>
                                    <div style="font-size: 1.25rem; font-weight: 600; color: #0d6efd;">${quoteData.EstimateId || quoteData.estimateId || '—'}</div>
                                </div>
                                <div>
                                    <div style="font-size: 0.75rem; color: #6c757d; text-transform: uppercase; margin-bottom: 0.25rem;">Calculation ID</div>
                                    <div style="font-size: 1.25rem; font-weight: 600; color: #0d6efd;">${quoteData.Id || quoteData.id || calculationId}</div>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-primary customer-quote-select-top">Use This Quote</button>
                            </div>
                        </div>
                    </div>
                    <dl class="quote-details-grid quote-details-full">
                        <dt>Description</dt><dd>${quoteData.Description || quoteData.description || '—'}</dd>
                        <dt>Customer Reference</dt><dd>${quoteData.ReferenceAtCustomer || quoteData.referenceAtCustomer || '—'}</dd>
                        <dt>Size</dt><dd>${quoteData.Size || quoteData.size || '—'}</dd>
                        <dt>Width</dt><dd>${quoteData.LabelWidth || quoteData.labelWidth || '—'}"</dd>
                        <dt>Height</dt><dd>${quoteData.LabelHeight || quoteData.labelHeight || '—'}"</dd>
                        <dt>Radius</dt><dd>${quoteData.LabelRadius || quoteData.labelRadius || '—'}"</dd>
