                    topButton.dataset.customerId = selectedCustomerId || '';
                    topButton.dataset.customerName = selectedCustomerName || '';
                    topButton.dataset.description = quoteData.Description || quoteData.description || '';
                    topButton.dataset.material = substrateDescription || '';
                    topButton.dataset.substrateId = substrateId;
                    topButton.dataset.referenceAtCustomer = quoteData.ReferenceAtCustomer || quoteData.referenceAtCustomer || '';
                    topButton.dataset.size = quoteData.Size || quoteData.size || '';
                    topButton.dataset.labelShape = quoteData.LabelShape || quoteData.labelShape || '';
                    topButton.dataset.labelWidth = quoteData.LabelWidth || quoteData.labelWidth || '';
                    topButton.dataset.labelHeight = quoteData.LabelHeight || quoteData.labelHeight || '';
                    topButton.dataset.labelRadius = quoteData.LabelRadius || quoteData.labelRadius || '';
                    topButton.dataset.colour = quoteData.Colour || quoteData.colour || '';
                    topButton.dataset.winding = quoteData.Winding || quoteData.winding || '';
                    topButton.dataset.packingProcedureId = quoteData.PackingProcedureId || quoteData.packingProcedureId || '';
                    topButton.dataset.colourCodeId = quoteData.ColourCodeId || quoteData.colourCodeId || '';
                    topButton.dataset.finishingTypeId = quoteData.FinishingTypeId || quoteData.finishingTypeId || '';
                    topButton.dataset.minCount = quoteData.MinimumCount || quoteData.minimumCount || '';
                    topButton.dataset.maxCount = quoteData.MaximumCount || quoteData.maximumCount || '';
                }

                if (customerQuoteDetailsActions) {
                    customerQuoteDetailsActions.innerHTML = '<button type="button" class="btn btn-primary customer-quote-select">Use This Quote</button>';
                    const selectButton = customerQuoteDetailsActions.querySelector('.customer-quote-select');
                    if (selectButton) {
                        selectButton.dataset.calculationId = quoteData.Id || quoteData.id || calculationId;
                        selectButton.dataset.estimateId = quoteData.EstimateId || quoteData.estimateId || calculationId;
                        selectButton.dataset.customerId = selectedCustomerId || '';
                        selectButton.dataset.customerName = selectedCustomerName || '';
                        selectButton.dataset.description = quoteData.Description || quoteData.description || '';
                        selectButton.dataset.material = substrateDescription || ''; // Use the extracted en-US description
                        selectButton.dataset.substrateId = substrateId;
                        selectButton.dataset.referenceAtCustomer = quoteData.ReferenceAtCustomer || quoteData.referenceAtCustomer || '';
                        selectButton.dataset.size = quoteData.Size || quoteData.size || '';
                        selectButton.dataset.labelShape = quoteData.LabelShape || quoteData.labelShape || '';
                        selectButton.dataset.labelWidth = quoteData.LabelWidth || quoteData.labelWidth || '';
                        selectButton.dataset.labelHeight = quoteData.LabelHeight || quoteData.labelHeight || '';
                        selectButton.dataset.labelRadius = quoteData.LabelRadius || quoteData.labelRadius || '';
                        selectButton.dataset.colour = quoteData.Colour || quoteData.colour || '';
                        selectButton.dataset.winding = quoteData.Winding || quoteData.winding || '';
                        selectButton.dataset.packingProcedureId = quoteData.PackingProcedureId || quoteData.packingProcedureId || '';
                        selectButton.dataset.colourCodeId = quoteData.ColourCodeId || quoteData.colourCodeId || '';
                        selectButton.dataset.finishingTypeId = quoteData.FinishingTypeId || quoteData.finishingTypeId || '';
                        selectButton.dataset.minCount = quoteData.MinimumCount || quoteData.minimumCount || '';
                        selectButton.dataset.maxCount = quoteData.MaximumCount || quoteData.maximumCount || '';
                    }
                }
            } catch (error) {
                console.error('Failed to load quote details from CERM API:', error);
                customerQuoteDetailsContent.innerHTML = `
                    <div class="alert alert-warning">
                        <strong>Unable to load quote details</strong>
                        <p class="mb-0 small">The CERM API is not responding. Please try again later.</p>
                    </div>
                `;
            }
        }

        function formatLabelShape(shape) {
            const shapeMap = { '1': 'Rectangle', '2': 'Square', '3': 'Circle', '4': 'Oval' };
            return shapeMap[shape] || shape || '—';
        }

        function formatWinding(winding) {
            const windingMap = { '1': 'Rolled', '2': 'Sheeted', '10': 'Sheeted' };
            return windingMap[winding] || winding || '—';
        }

        function formatNumber(num) {
            if (!num) return '—';
            return Number(num).toLocaleString();
        }

        async function loadCustomerQuotes(customerId) {
            if (!customerQuotesTableBody || !customerId) {
                return;
            }

            renderQuotesPlaceholder(quotesLoadingMessage);
            try {
                // Call CERM API via our backend proxy
                const response = await fetch(`/Api/CermCustomerCalculations?customerId=${encodeURIComponent(customerId)}`);
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('API error response:', errorText);
                    throw new Error(`Network response was not ok: ${response.status}`);
                }

                const result = await response.json();
                console.log('CERM API response:', result);

                // CERM API returns: { "Meta": { "TotalCount": 93 }, "Data": [...] }
                const quotes = result.Data || result.data || [];

                if (!Array.isArray(quotes)) {
                    console.error('Expected array but got:', typeof quotes, quotes);
                    renderQuotesPlaceholder(quotesEmptyMessage);
                    return;
                }

                if (quotes.length === 0) {
                    renderQuotesPlaceholder(quotesEmptyMessage);
                    return;
                }

                console.log(`Loaded ${quotes.length} quotes from CERM API`);

                customerQuotesTableBody.innerHTML = '';
                currentQuotes = [];

                // Sort quotes by calculation ID in descending order (greatest to least)
                const sortedQuotes = quotes.sort((a, b) => {
                    const idA = parseInt((a.Id || a.id || '0'), 10);
                    const idB = parseInt((b.Id || b.id || '0'), 10);
                    return idB - idA; // Descending order
                });

                sortedQuotes.forEach(quote => {
                    const calculationId = quote.Id || quote.id || '';
                    const estimateId = quote.EstimateId || quote.estimateId || '';
                    const description = quote.Description || quote.description || '';

                    // Store the raw quote data for later use
                    currentQuotes.push({
                        calculationId: calculationId,
                        estimateId: estimateId,
                        description: description,
                        rawData: quote
                    });

                    const quoteRow = document.createElement('tr');
                    quoteRow.dataset.calculationId = calculationId;
                    quoteRow.dataset.estimateId = estimateId;
                    quoteRow.innerHTML = `
                        <td>${calculationId || '—'}</td>
                        <td>${estimateId || '—'}</td>
                        <td>${description || '—'}</td>
                    `;
                    customerQuotesTableBody.appendChild(quoteRow);
                });

                showQuotesList();
            } catch (error) {
                console.error('Failed to load quotes', error);
                renderQuotesPlaceholder(quotesErrorMessage);
            }
        }

        function formatDateValue(value) {
            if (!value) {
                return '—';
            }

            const parsedDate = new Date(value);
            if (Number.isNaN(parsedDate.getTime())) {
                return '—';
            }

            return parsedDate.toLocaleDateString();
        }

        function clearSelection() {
            tableBody.querySelectorAll('.' + selectedRowClass).forEach(row => row.classList.remove(selectedRowClass));
            if (customerDetailsPanel && customerDetailsContent) {
                customerDetailsPanel.classList.add('is-hidden');
                customerDetailsContent.textContent = '';
            }
            renderQuotesPlaceholder(quotesPlaceholderMessage);
            showQuotesList();
            selectedCustomerId = null;
            selectedCustomerName = null;
        }

        function renderPage(page) {
            clearSelection();
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const pageRows = filteredRows.slice(start, end);

            // Use requestAnimationFrame for smoother DOM updates
            requestAnimationFrame(() => {
                // Hide all rows
                customerRows.forEach(({ customerRow }) => {
                    customerRow.style.display = 'none';
                });

                // Show rows for current page
                pageRows.forEach(({ customerRow }) => {
                    customerRow.style.display = '';
                });
            });

            currentPage = page;
        }

        function renderPagination() {
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / rowsPerPage));

            // Function to build pagination HTML
            const buildPaginationHTML = () => {
                const fragment = document.createDocumentFragment();

                let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
                let endPage = startPage + maxPagesToShow - 1;

                if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = Math.max(1, endPage - maxPagesToShow + 1);
                }

                // Previous button
                const prevLi = document.createElement('li');
                prevLi.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
                const prevA = document.createElement('a');
                prevA.className = 'page-link';
                prevA.href = '#';
                prevA.innerHTML = '&laquo; Previous';
                prevA.dataset.page = currentPage - 1;
                prevLi.appendChild(prevA);
                fragment.appendChild(prevLi);

                // Page numbers
                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement('li');
                    li.className = 'page-item' + (i === currentPage ? ' active' : '');
                    const a = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.textContent = i;
                    a.dataset.page = i;
                    li.appendChild(a);
                    fragment.appendChild(li);
                }

                // Next button
                const nextLi = document.createElement('li');
                nextLi.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
                const nextA = document.createElement('a');
                nextA.className = 'page-link';
                nextA.href = '#';
                nextA.innerHTML = 'Next &raquo;';
                nextA.dataset.page = currentPage + 1;
                nextLi.appendChild(nextA);
                fragment.appendChild(nextLi);

                return fragment;
            };

            // Update both pagination controls
            paginationControlsTop.innerHTML = '';
            paginationControlsTop.appendChild(buildPaginationHTML());

            paginationControlsBottom.innerHTML = '';
            paginationControlsBottom.appendChild(buildPaginationHTML());
        }

        // Single delegated event handler for pagination (faster than individual listeners)
        function handlePaginationClick(event) {
            const link = event.target.closest('.page-link');
            if (!link) return;
            event.preventDefault();

            const pageItem = link.closest('.page-item');
            if (pageItem.classList.contains('disabled') || pageItem.classList.contains('active')) {
                return;
            }

            const targetPage = parseInt(link.dataset.page, 10);
            if (isNaN(targetPage) || targetPage < 1) return;

            const totalPages = Math.ceil(filteredRows.length / rowsPerPage);
            if (targetPage > totalPages) return;

            // Prevent rapid clicks from queuing up
            if (isPaginationBusy) return;
            isPaginationBusy = true;

            // Add loading cursor to indicate processing
            document.body.style.cursor = 'wait';

            // Use setTimeout to allow the UI to update with the loading state
            setTimeout(() => {
                currentPage = targetPage;
                renderPage(currentPage);
                renderPagination();

                document.body.style.cursor = '';
                isPaginationBusy = false;

                // Scroll to top of table
                const table = document.getElementById('customersTable');
                if (table) {
                    table.scrollIntoView({ behavior: 'instant', block: 'start' });
                }
            }, 0);
        }

        paginationControlsTop.addEventListener('click', handlePaginationClick);
        paginationControlsBottom.addEventListener('click', handlePaginationClick);

        customerQuotesTableBody?.addEventListener('click', function(event) {
            const row = event.target.closest('tr');
            if (!row || row.classList.contains('customer-quotes-empty')) {
                return;
            }

            const calculationId = row.dataset.calculationId;
            const quote = currentQuotes.find(q => q.calculationId === calculationId);
            if (quote) {
                showQuoteDetails(quote);
            }
        });

        customerQuoteBackButton?.addEventListener('click', function(e) {
            e.preventDefault();
            showQuotesList();
        });

        customerQuoteDetailsContent?.addEventListener('click', function(event) {
            const button = event.target.closest('.customer-quote-select-top');
            if (!button || !useQuoteForm) {
                return;
            }

            // Populate all hidden form fields from button data attributes
            document.getElementById('selectedCalculationId').value = button.dataset.calculationId ?? '';
            document.getElementById('selectedEstimateId').value = button.dataset.estimateId ?? '';
            document.getElementById('selectedCustomerId').value = button.dataset.customerId ?? '';
            document.getElementById('selectedCustomerName').value = button.dataset.customerName ?? '';
            document.getElementById('selectedDescription').value = button.dataset.description ?? '';
            document.getElementById('selectedMaterial').value = button.dataset.material ?? '';
            document.getElementById('selectedSubstrateId').value = button.dataset.substrateId ?? '';
            document.getElementById('selectedReferenceAtCustomer').value = button.dataset.referenceAtCustomer ?? '';
            document.getElementById('selectedSize').value = button.dataset.size ?? '';
            document.getElementById('selectedLabelShape').value = button.dataset.labelShape ?? '';
            document.getElementById('selectedLabelWidth').value = button.dataset.labelWidth ?? '';
            document.getElementById('selectedLabelHeight').value = button.dataset.labelHeight ?? '';
            document.getElementById('selectedLabelRadius').value = button.dataset.labelRadius ?? '';
            document.getElementById('selectedColour').value = button.dataset.colour ?? '';
            document.getElementById('selectedWinding').value = button.dataset.winding ?? '';
            document.getElementById('selectedPackingProcedureId').value = button.dataset.packingProcedureId ?? '';
            document.getElementById('selectedColourCodeId').value = button.dataset.colourCodeId ?? '';
            document.getElementById('selectedFinishingTypeId').value = button.dataset.finishingTypeId ?? '';
            document.getElementById('selectedMinCount').value = button.dataset.minCount ?? '';
            document.getElementById('selectedMaxCount').value = button.dataset.maxCount ?? '';

            useQuoteForm.submit();
        });

        customerQuoteDetailsActions?.addEventListener('click', function(event) {
            const button = event.target.closest('.customer-quote-select');
            if (!button || !useQuoteForm) {
                return;
            }

            // Populate all hidden form fields from button data attributes
            document.getElementById('selectedCalculationId').value = button.dataset.calculationId ?? '';
            document.getElementById('selectedEstimateId').value = button.dataset.estimateId ?? '';
            document.getElementById('selectedCustomerId').value = button.dataset.customerId ?? '';
            document.getElementById('selectedCustomerName').value = button.dataset.customerName ?? '';
            document.getElementById('selectedDescription').value = button.dataset.description ?? '';
            document.getElementById('selectedMaterial').value = button.dataset.material ?? '';
            document.getElementById('selectedSubstrateId').value = button.dataset.substrateId ?? '';
            document.getElementById('selectedReferenceAtCustomer').value = button.dataset.referenceAtCustomer ?? '';
            document.getElementById('selectedSize').value = button.dataset.size ?? '';
            document.getElementById('selectedLabelShape').value = button.dataset.labelShape ?? '';
            document.getElementById('selectedLabelWidth').value = button.dataset.labelWidth ?? '';
            document.getElementById('selectedLabelHeight').value = button.dataset.labelHeight ?? '';
            document.getElementById('selectedLabelRadius').value = button.dataset.labelRadius ?? '';
            document.getElementById('selectedColour').value = button.dataset.colour ?? '';
            document.getElementById('selectedWinding').value = button.dataset.winding ?? '';
            document.getElementById('selectedPackingProcedureId').value = button.dataset.packingProcedureId ?? '';
            document.getElementById('selectedColourCodeId').value = button.dataset.colourCodeId ?? '';
            document.getElementById('selectedFinishingTypeId').value = button.dataset.finishingTypeId ?? '';
            document.getElementById('selectedMinCount').value = button.dataset.minCount ?? '';
            document.getElementById('selectedMaxCount').value = button.dataset.maxCount ?? '';

            useQuoteForm.submit();
        });

        // Handle button clicks on customer rows
        tableBody.addEventListener('click', async function(event) {
            // Handle "New Quote" button
            const newQuoteBtn = event.target.closest('.btn-new-quote');
            if (newQuoteBtn) {
                event.stopPropagation();
                const customerId = newQuoteBtn.dataset.customerId;
                const customerName = newQuoteBtn.dataset.customerName;
                await handleNewQuoteClick(customerId, customerName);
                return;
            }

            // Handle "Past Orders" button
            const viewOrdersBtn = event.target.closest('.btn-view-orders');
            if (viewOrdersBtn) {
                event.stopPropagation();
                const customerId = viewOrdersBtn.dataset.customerId;
                const customerName = viewOrdersBtn.dataset.customerName;

                if (!customerId || !customerName) {
                    console.error('Missing customer ID or name');
                    return;
                }

                // Remove selection from all rows
                tableBody.querySelectorAll('.' + selectedRowClass).forEach(r => r.classList.remove(selectedRowClass));

                // Add selection to the button's parent row
                const row = viewOrdersBtn.closest('tr');
                if (row) {
                    row.classList.add(selectedRowClass);
                }

                selectedCustomerId = customerId;
                selectedCustomerName = customerName;

                if (customerDetailsPanel && customerDetailsContent) {
                    customerDetailsPanel.classList.remove('is-hidden');
                    loadCustomerQuotes(customerId);
                }
                return;
            }

            // Handle row click (for viewing quotes)
            const customerRow = event.target.closest('tr.customer-row');
            if (customerRow && !event.target.closest('a')) {
                const customerId = customerRow.dataset.customerId;
                const customerName = customerRow.dataset.customerName;

                // Toggle selection
                if (customerRow.classList.contains(selectedRowClass)) {
                    clearSelection();
                } else {
                    clearSelection();
                    customerRow.classList.add(selectedRowClass);
                    selectedCustomerId = customerId;
                    selectedCustomerName = customerName;

                    if (customerDetailsPanel) {
                        customerDetailsPanel.classList.remove('is-hidden');
                    }

                    await loadCustomerQuotes(customerId);
                }
            }
        });

        // No longer need separate event handlers - consolidated into one

        // Initial setup - pagination is already server-rendered, just set up quotes placeholder
        // Remove the 'initially-hidden' class as JS now controls visibility via inline style
        customerRows.forEach(({ customerRow }) => {
            customerRow.classList.remove('initially-hidden');
        });

        // Apply initial page state (first page is already visible from server render)
        // Only need to set display:none on rows that should be hidden
        const initialStart = 0;
        const initialEnd = rowsPerPage;
        customerRows.forEach(({ customerRow }, index) => {
            customerRow.style.display = index >= initialEnd ? 'none' : '';
        });

        renderQuotesPlaceholder(quotesPlaceholderMessage);

        // Search/filter functionality
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();

                if (searchTerm === '') {
                    // Show all rows when search is empty
                    filteredRows = [...customerRows];
                } else {
                    // Filter rows based on search term
                    filteredRows = customerRows.filter(({ customerRow }) => {
                        const customerName = (customerRow.cells[1]?.textContent || '').toLowerCase();
                        const customerId = (customerRow.cells[0]?.textContent || '').toLowerCase();
                        return customerName.includes(searchTerm) || customerId.includes(searchTerm);
                    });
                }

                // Reset to first page and re-render
                currentPage = 1;
                renderPage(currentPage);
                renderPagination();
                clearSelection();
            });
        }
    });
</script>
