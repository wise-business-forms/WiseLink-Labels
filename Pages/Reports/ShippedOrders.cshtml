@page
@model WiseLabels.Pages.Reports.ShippedOrdersModel
@{
    ViewData["Title"] = "Shipped Orders Report";
    Layout = "_Layout";
}

<div class="reports-page">
    <div class="dashboard-container">
        @await Html.PartialAsync("_LeftSidebar")
        <main class="dashboard-main">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="admin-page-title">Shipped Orders Report</h1>
            </div>

            <div class="alert alert-info text-center py-5" role="alert">
                <i class="bi bi-truck fs-1 d-block mb-3"></i>
                <h5>Coming Soon</h5>
                <p class="mb-0">The Shipped Orders report will be available here soon.</p>
            </div>
        </main>
    </div>
</div>
