        <section class="invoice-panels">
            <article class="info-panel">
                <h3>Bill To</h3>
                <p style="font-weight:600;">@FormatMaybeValue(Model.QuoteRequest?.Company)</p>
                <p>Attn: @FormatMaybeValue(Model.QuoteRequest?.Name)</p>
                <p>@FormatMaybeValue(Model.QuoteRequest?.Email)</p>
                <p>@FormatMaybeValue(Model.QuoteRequest?.Phone)</p>
            </article>
            <article class="info-panel">
                <h3>Project</h3>
                <p>Description: @FormatMaybeValue(Model.QuoteRequest?.Description)</p>
                <p>Reference: @FormatMaybeValue(Model.QuoteRequest?.ReferenceValue)</p>
                <p>Artwork: @FormatMaybeValue(Model.QuoteRequest?.ArtworkOption)</p>
                <p>Comments: @FormatMaybeValue(Model.QuoteRequest?.Comments)</p>
            </article>
            <article class="info-panel">
                <h3>Specifications</h3>
                <p>Shape: @Capitalize(Model.QuoteRequest?.Shape)</p>
                <p>Size: @(string.IsNullOrWhiteSpace(Model.QuoteRequest?.Diameter) ? FormatDimension(Model.QuoteRequest?.LabelWidth, Model.QuoteRequest?.LabelHeight) : $"{Model.QuoteRequest?.Diameter}\" Diameter")</p>
                <p>Material: @FormatMaybeValue(Model.QuoteRequest?.Material)</p>
                <p>Finish: @FormatMaybeValue(Model.QuoteRequest?.Finish)</p>
            </article>
        </section>
        -->
        <section class="info-panel" style="margin-bottom:2rem;">
            <h3>Production Details</h3>
            <p style="margin: 0.35rem 0 0;">
                Project Name: @FormatMaybeValue(Model.QuoteRequest?.Description)
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:1.25rem; font-size:0.95rem;">
                <div>
                    <p style="margin:0.15rem 0;">Printing: @FormatMaybeValue(Model.QuoteRequest?.Printing)</p>
                    <p style="margin:0.15rem 0;">Color Code: @FormatMaybeValue(Model.QuoteRequest?.ColorCode)</p>
                    <p style="margin:0.15rem 0;">Unwind Direction: @FormatMaybeValue(Model.QuoteRequest?.UnwindDirection)</p>
                </div>
                <div>
                    <p style="margin:0.15rem 0;">Corners: @FormatMaybeValue(Model.QuoteRequest?.Corners)</p>
                    <p style="margin:0.15rem 0;">Die Size: @FormatMaybeValue(Model.QuoteRequest?.DieSizeInfo)</p>
                    <p style="margin:0.15rem 0;">Cutting Die: @FormatMaybeValue(Model.QuoteRequest?.CuttingDie)</p>
                    <p style="margin:0.15rem 0;">Application: @FormatMaybeValue(Model.QuoteRequest?.ApplicationMethod)</p>
                    <p style="margin:0.15rem 0;">Packing: @FormatMaybeValue(Model.QuoteRequest?.PackingProcedure)</p>
                </div>
                <div>
                    <p style="margin:0.15rem 0;">Quantities: @(
                        Model.QuoteRequest?.Quantities?.Count > 0
                            ? string.Join(", ", Model.QuoteRequest.Quantities)
                            : FormatMaybeValue(Model.QuoteRequest?.TotalQuantity))
                    </p>
                    <p style="margin:0.15rem 0;">Customer: @FormatMaybeValue(Model.QuoteRequest?.CustomerDisplayName)</p>
                    <p style="margin:0.15rem 0;">Shape Outline: @FormatMaybeValue(Model.QuoteRequest?.ShapeValue)</p>
                </div>
            </div>
        </section>

        <table class="line-items">
            <thead>
                <tr>
                    <th style="width: 25%;" class="text-right">Quantity</th>
                    <th style="width: 25%;" class="text-right">Unit Price</th>
                    <th style="width: 30%;" class="text-right">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @if (pricingRows.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No pricing information has been provided yet.</td>
                    </tr>
                }
                else
                {
                    foreach (var price in pricingRows)
                    {
                        var qtyLabel = price.Quantity?.ToString("N0")
                            ?? (Model.QuoteRequest?.Quantities?.Count > 0 ? string.Empty : "—");
                        <tr>
                            <td class="text-right">@(string.IsNullOrWhiteSpace(qtyLabel) ? "—" : qtyLabel) pcs.</td>
                            <td class="text-right">@FormatCurrency(price.UnitPrice)</td>
                            <td class="text-right">@FormatCurrency(price.TotalPrice)</td>
                        </tr>
                    }
                }

                
            </tbody>
        </table>

        <section class="additional-charges">
            <h3>Additional Charges (if applicable)</h3>
            <table>
                <thead>
                    <tr>
                        <th style="width: 55%;">Description</th>
                        <th style="width: 20%;" class="text-right">Price</th>
                        <th style="width: 15%;">Units</th>
                    </tr>
                </thead>
                <tbody>
                    @* Additional line items for custom die and other charges *@
                    @if (Model.QuoteRequest?.IsCustomDie == true)
                    {
                        <tr style="background: #fef3c7;">
                            <td style="font-weight: 600;">
                                <span style="color: #92400e;">⚠️</span> Custom Die Fabrication
                                <br />
                                <small style="color: #78350f; font-weight: normal;">
                                    Die Size: @FormatMaybeValue(Model.QuoteRequest?.DieSizeInfo)
                                </small>
                            </td>
                            <td class="text-right" style="font-weight: 600;">@FormatCurrency(Model.CustomDiePrice)</td>
                            <td style="font-weight: 600;">@(Model.CustomDieUnit ?? "each")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align:center; color:#94a3b8; font-style:italic;">
                                No additional charges were added to this quote.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="notes">
            <strong>Next Steps</strong>

            <p style="margin: 0.35rem 0 0;">
                <ol>
                    <li>Please confirm that each specification is final. Any changes after submission may require a new quote or amended lead time.</li>
                    <li>Click Confirm & Submit below.</li>
                </ol>

            </p>
        </section>

        <p style="text-align: center; margin-top: 2rem; font-size: 0.95rem; color: #475569;">
            Thank you for partnering with WiseLabels. We look forward to supporting your next release.
        </p>

        <form method="post" id="confirm-form">
            @Html.AntiForgeryToken()
            <div class="action-buttons">
                <button type="submit" asp-page-handler="Edit" class="btn btn-outline-secondary btn-lg">Edit</button>
                <button type="submit" asp-page-handler="Confirm" class="btn btn-primary btn-lg" id="confirm-submit-btn">Confirm &amp; Submit</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ApiPayloadJson) || !string.IsNullOrEmpty(Model.FormValuesJson))
        {
            <section style="margin-top:3rem;">
                <div class="row g-4">
                    @if (!string.IsNullOrEmpty(Model.ApiPayloadJson))
                    {
                        <div class="col-md-6">
                            <div class="card border-info h-100">
                                <div class="card-header bg-info text-white">
                                    <h2 class="h5 mb-0">Debug: API Payload</h2>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-2">Payload submitted to CERM.</p>
                                    <pre class="bg-light p-3 rounded border" style="max-height: 600px; overflow-y: auto; font-size: 0.875rem; white-space: pre-wrap; word-wrap: break-word; margin-bottom: 0;"><code>@Model.ApiPayloadJson</code></pre>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.FormValuesJson))
                    {
                        <div class="col-md-6">
                            <div class="card border-success h-100">
                                <div class="card-header bg-success text-white">
                                    <h2 class="h5 mb-0">Debug: Form Values</h2>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-2">Raw form data captured prior to submission.</p>
                                    <pre class="bg-light p-3 rounded border" style="max-height: 600px; overflow-y: auto; font-size: 0.875rem; white-space: pre-wrap; word-wrap: break-word; margin-bottom: 0;"><code>@Model.FormValuesJson</code></pre>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</div>

@if (Model.QuoteRequest != null)
{
    <script id="quote-payload-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuoteRequest, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
}

<script>
    function printInvoice() {
        window.print();
    }
</script>

<script src="~/js/site.js"></script>
<script src="~/js/submit.js" asp-append-version="true"></script>
