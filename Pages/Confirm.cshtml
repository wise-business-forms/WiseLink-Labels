@page
@model WiseLabels.Pages.ConfirmModel
@using WiseLabels.Models
@using System.Globalization
@{
    ViewData["Title"] = "Confirm Quote Request";

    string FormatReferenceType(string? t) => t switch
    {
        "company-name" => "Company Name",
        "account-number" => "Account Number",
        "purchase-order-number" => "Purchase Order Number",
        "invoice-number" => "Invoice Number",
        _ => "Reference"
    };

    string FormatMaybeValue(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string FormatDimension(string? width, string? height)
    {
        if (string.IsNullOrWhiteSpace(width) && string.IsNullOrWhiteSpace(height))
        {
            return "—";
        }
        return $"{width ?? "?"}\" × {height ?? "?"}\"";
    }
    string FormatCurrency(decimal? value) => value.HasValue ? value.Value.ToString("C2") : "$ -";
    string Capitalize(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "—";
        }
        return text.Length == 1 ? char.ToUpper(text[0]).ToString() : char.ToUpper(text[0]) + text[1..];
    }

    string FormatQuoteDate(DateTime date)
    {
        var culture = CultureInfo.InvariantCulture;
        return $"{date.ToString("ddd", culture)}, {date:MMM dd, yyyy}";
    }

    var issuedOn = DateTime.Today;
    var expiresOn = issuedOn.AddDays(30);
    var quoteReference = !string.IsNullOrWhiteSpace(Model.QuoteRequest?.ReferenceValue)
        ? Model.QuoteRequest.ReferenceValue
        : (!string.IsNullOrWhiteSpace(Model.QuoteRequest?.Description) ? Model.QuoteRequest.Description : "Pending Reference");

    var pricingRows = Model.PriceBreakdown?.ToList() ?? new List<QuotePriceBreakdown>();
    if (!pricingRows.Any() && Model.QuoteRequest?.Quantities?.Count > 0)
    {
        pricingRows = Model.QuoteRequest.Quantities
            .Select(q => new QuotePriceBreakdown { Quantity = q })
            .ToList();
    }
}

<style>
    .invoice-container {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .invoice-wrapper {
        max-width: 860px;
        margin: 0 auto;
        padding: 2.5rem;
        background: #fff;
        border: 1px solid #d9dee6;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
        color: #0f172a;
    }

    .print-panel {
        flex: 0 0 220px;
        background: #0f172a;
        color: #fff;
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.15);
        position: sticky;
        top: 1.5rem;
        height: fit-content;
    }

    .print-panel h3 {
        margin-top: 0;
        font-size: 1.05rem;
        font-weight: 600;
    }

    .print-panel p {
        margin-bottom: 1rem;
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 1.75rem;
        margin-bottom: 1.75rem;
    }

    .print-button {
        background: #fff;
        color: #0f172a;
        border: none;
        border-radius: 999px;
        padding: 0.45rem 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .print-button:hover {
        background: rgba(255,255,255,0.85);
    }

    .invoice-meta {
        text-align: right;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #e0f2fe;
        color: #0369a1;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .invoice-panels {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .info-panel {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        background: #f8fafc;
    }

    .info-panel h3 {
        margin-top: 0;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #475569;
    }

    .info-panel p {
        margin: 0.15rem 0;
    }

    .line-items {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .line-items thead {
        background: #0f172a;
        color: #fff;
    }

    .line-items th,
    .line-items td {
        padding: 0.85rem 0.75rem;
        border: 1px solid #e2e8f0;
    }

    .line-items td.text-muted {
        color: #94a3b8;
    }

    .text-right {
        text-align: right;
    }

    .totals {
        width: 320px;
        margin-left: auto;
        border-collapse: collapse;
    }

    .totals td {
        padding: 0.55rem 0.35rem;
    }

    .totals tr:last-child td {
        font-size: 1.2rem;
        font-weight: 600;
        border-top: 2px solid #0f172a;
        padding-top: 0.9rem;
    }

    .notes {
        margin-top: 2rem;
        padding: 1.25rem;
        border-left: 4px solid #0ea5e9;
        background: #ecfeff;
        border-radius: 10px;
        color: #0f172a;
    }

    .additional-charges {
        margin-top: 2rem;
    }

    .additional-charges h3 {
        margin: 0 0 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
    }

    .additional-charges table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .additional-charges th,
    .additional-charges td {
        border: 1px solid #e2e8f0;
        padding: 0.75rem;
        text-align: left;
    }

    .additional-charges th {
        background: #f1f5f9;
        color: #475569;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
    }

    .action-buttons {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    @@media print {
        body {
            background: #fff;
        }

        .invoice-container {
            display: block;
            width: 100%;
        }

        .invoice-wrapper {
            border: none;
            box-shadow: none;
            padding: 0;
            margin: 0 auto;
        }

        .print-panel {
            display: none !important;
        }

        header.invoice-header {
            display: flex !important;
        }

        .action-buttons,
        .action-buttons * {
            display: none !important;
        }
    }
</style>

<div class="invoice-container">
    <aside class="print-panel">
        <h3>Print Options</h3>
        <p>Print a clean copy of this confirmation without the sidebar controls.</p>
        <button type="button" class="print-button" onclick="printInvoice()">Print Quote DRAFT</button>
        <p class="mt-4" style="font-size:0.8rem; color: rgba(255,255,255,0.65);">
            Want to make a tweak? Choose Edit to return to the quote form and keep all current entries intact.
        </p>
    </aside>

    <div class="invoice-wrapper">
        <header class="invoice-header">
            <div class="invoice-branding">
                <p>
                    601 Vanguard Road<br />
                    Anderson SC, 29625<br />
                    (888) 817-7036 • labels@wbf.com
                </p>
            </div>
            <div style="flex:0 0 auto; padding:0 1.5rem; display:flex; align-items:center;">
                <img src="~/img/wise-logo-blue.png" alt="WiseLabels" style="max-height:72px; width:auto;" />
            </div>
            <div class="invoice-meta">
                <span class="badge">
                    <span>Quote Draft</span>
                </span>
                <h2 style="margin: 0.5rem 0 0;">@quoteReference</h2>
                <p style="margin: 0.2rem 0;">Quote Date @FormatQuoteDate(issuedOn)</p>
                <p style="margin: 0.2rem 0;">Quote expires on @FormatQuoteDate(expiresOn)</p>
            </div>
        </header>

        <p style="margin-bottom:1.5rem; font-size:0.95rem; color:#0f172a; line-height:1.6;">
            Thank you for the opportunity to quote. This quote is not complete.  To complete the quote click Confirm & Submit below.
        </p>
