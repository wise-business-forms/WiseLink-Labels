@page
@model WiseLabels.Pages.SuccessModel
@using WiseLabels.Models
@using System.Globalization
@{
    ViewData["Title"] = Model.ApiSuccess ? "Quote Submitted Successfully" : "Quote Request Received";

    string FormatMaybeValue(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string FormatDimension(string? width, string? height)
    {
        if (string.IsNullOrWhiteSpace(width) && string.IsNullOrWhiteSpace(height))
        {
            return "—";
        }
        return $"{width ?? "?"}\" × {height ?? "?"}\"";
    }
    string FormatCurrency(decimal? value) => value.HasValue ? value.Value.ToString("C2") : "$ -";
    string Capitalize(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "—";
        }
        return text.Length == 1 ? char.ToUpper(text[0]).ToString() : char.ToUpper(text[0]) + text[1..];
    }
    string FormatQuoteDate(DateTime date)
    {
        var culture = CultureInfo.InvariantCulture;
        return $"{date.ToString("ddd", culture)}, {date:MMM dd, yyyy}";
    }
    string FormatSubmittedDate(DateTime date) => date.ToString("MMM dd, yyyy 'at' h:mm tt 'EST'");

    string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Bytes";
        var k = 1024.0;
        var sizes = new[] { "Bytes", "KB", "MB", "GB" };
        var i = (int)Math.Floor(Math.Log(bytes) / Math.Log(k));
        return $"{Math.Round(bytes / Math.Pow(k, i), 2)} {sizes[i]}";
    }

    var quoteReference = Model.DisplayQuoteId ?? Model.QuoteId ?? "Pending Reference";
    var issuedOn = Model.SubmittedDateEastern;
    var expiresOn = issuedOn.AddDays(30);
    var pricingRows = Model.PriceBreakdown?.ToList() ?? new List<QuotePriceBreakdown>();
    if (!pricingRows.Any() && Model.QuoteRequest?.Quantities?.Count > 0)
    {
        pricingRows = Model.QuoteRequest.Quantities.Select(q => new QuotePriceBreakdown { Quantity = q }).ToList();
    }

    var subtotal = pricingRows.Where(p => p.TotalPrice.HasValue).Sum(p => p.TotalPrice!.Value);
    var discount = 0m;
    var shipping = 0m;
    var tax = 0m;
    var totalDue = subtotal - discount + shipping + tax;
    var hasPriceValues = pricingRows.Any(p => p.TotalPrice.HasValue || p.UnitPrice.HasValue);
    var statusMessage = Model.ApiSuccess
        ? "Quote submitted successfully."
        : (string.IsNullOrWhiteSpace(Model.CermErrorMessage)
            ? "Quote request was captured, but CERM did not return a confirmation."
            : Model.CermErrorMessage);
}

<style>
    .invoice-container {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .invoice-wrapper {
        max-width: 860px;
        margin: 0 auto;
        padding: 2.5rem;
        background: #fff;
        border: 1px solid #d9dee6;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
        color: #0f172a;
    }

    .print-panel {
        flex: 0 0 220px;
        background: #0f172a;
        color: #fff;
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.15);
        position: sticky;
        top: 1.5rem;
        height: fit-content;
    }

    .print-panel h3 {
        margin-top: 0;
        font-size: 1.05rem;
        font-weight: 600;
    }

    .print-panel p {
        margin-bottom: 1rem;
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
    }

    .print-button {
        width: 100%;
        background: #fff;
        color: #0f172a;
        border: none;
        border-radius: 999px;
        padding: 0.45rem 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease;
        margin-bottom: 0.75rem;
    }

    .print-button:hover {
        background: rgba(255,255,255,0.85);
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 1.75rem;
        margin-bottom: 1.75rem;
    }

    .invoice-meta {
        text-align: right;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #e0f2fe;
        color: #0369a1;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-banner {
        border-left: 4px solid #0ea5e9;
        background: #ecfeff;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .status-banner.error {
        border-left-color: #f87171;
        background: #fef2f2;
        color: #991b1b;
    }

    .invoice-panels {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .info-panel {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        background: #f8fafc;
    }

    .info-panel h3 {
        margin-top: 0;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #475569;
    }

    .info-panel p {
        margin: 0.15rem 0;
    }

    .line-items {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .line-items thead {
        background: #0f172a;
        color: #fff;
    }

    .line-items th,
    .line-items td {
        padding: 0.85rem 0.75rem;
        border: 1px solid #e2e8f0;
    }

    .totals {
        width: 320px;
        margin-left: auto;
        border-collapse: collapse;
    }

    .totals td {
        padding: 0.55rem 0.35rem;
    }

    .totals tr:last-child td {
        font-size: 1.2rem;
        font-weight: 600;
        border-top: 2px solid #0f172a;
        padding-top: 0.9rem;
    }

    .notes {
        margin-top: 2rem;
        padding: 1.25rem;
        border-left: 4px solid #0ea5e9;
        background: #ecfeff;
        border-radius: 10px;
        color: #0f172a;
    }

    .additional-charges {
        margin-top: 2rem;
    }

    .additional-charges h3 {
        margin: 0 0 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
    }

    .additional-charges table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .additional-charges th,
    .additional-charges td {
        border: 1px solid #e2e8f0;
        padding: 0.75rem;
        text-align: left;
    }

    .additional-charges th {
        background: #f1f5f9;
        color: #475569;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
    }

    .action-buttons {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    @@media print {
        body {
            background: #fff;
        }

        .invoice-container
        {
            display: block;
            width: 100%;
        }

        .invoice-wrapper {
            border: none;
            box-shadow: none;
            padding: 0;
            margin: 0 auto;
        }

        .print-panel {
            display: none !important;
        }

        header.invoice-header {
            display: flex !important;
        }

        .action-buttons,
        .action-buttons * {
            display: none !important;
        }
    }
</style>

<div class="invoice-container">
    <aside class="print-panel">
        <h3>Quote Actions</h3>
        <p>Download or print the confirmation that includes your CERM reference.</p>
        <button type="button" id="print-btn" class="print-button">Print Quote</button>
        <!--<button type="button" id="pdf-btn" class="print-button">Download PDF</button>-->
        <p style="font-size:0.85rem; color:rgba(255,255,255,0.75);">
            Reference: <strong>@quoteReference</strong><br />
            Submitted: @FormatSubmittedDate(issuedOn)
        </p>
    </aside>

    <div class="invoice-wrapper">
        <header class="invoice-header">
            <div class="invoice-branding">
                <p>
                    601 Vanguard Road<br />
                    Anderson SC, 29625<br />
                    (888) 817-7036 • labels@wbf.com
                </p>
            </div>
            <div style="flex:0 0 auto; padding:0 1.5rem; display:flex; align-items:center;">
                <img src="~/img/wise-logo-blue.png" alt="WiseLabels" style="max-height:72px; width:auto;" />
            </div>
            <div class="invoice-meta">
                <span class="badge">
                    <span>@(Model.ApiSuccess ? "Quote Confirmation" : "Quote Received")</span>
                </span>
                <h2 style="margin: 0.5rem 0 0;">@quoteReference</h2>
                <p style="margin: 0.2rem 0;">Submitted @FormatQuoteDate(issuedOn)</p>
                <p style="margin: 0.2rem 0;">Quote expires on @FormatQuoteDate(expiresOn)</p>
            </div>
        </header>

        <div class="@(Model.ApiSuccess ? "status-banner" : "status-banner error")">
            <strong>@(Model.ApiSuccess ? "Success" : "Attention")</strong>
            <p style="margin:0.25rem 0 0;">@statusMessage</p>
            @if (Model.EmailSent && !string.IsNullOrWhiteSpace(Model.QuoteRequest?.Email))
            {
                <p style="margin:0.25rem 0 0;">Confirmation sent to <strong>@Model.QuoteRequest.Email</strong>.</p>
            }
            else if (!Model.EmailSent && !string.IsNullOrWhiteSpace(Model.QuoteRequest?.Email))
            {
                <p style="margin:0.25rem 0 0;">We could not send email to <strong>@Model.QuoteRequest.Email</strong>. Please retain this reference.</p>
            }
        </div>
        <!--
        <section class="invoice-panels">
            <article class="info-panel">
                <h3>Bill To</h3>
                <p style="font-weight:600;">@FormatMaybeValue(Model.QuoteRequest?.Company)</p>
                <p>Attn: @FormatMaybeValue(Model.QuoteRequest?.Name)</p>
                <p>@FormatMaybeValue(Model.QuoteRequest?.Email)</p>
                <p>@FormatMaybeValue(Model.QuoteRequest?.Phone)</p>
            </article>
            <article class="info-panel">
                <h3>Submission</h3>
                <p>Estimate ID: @FormatMaybeValue(Model.CermEstimateId ?? Model.CermCalculationId)</p>
                <p>Internal ID: @FormatMaybeValue(Model.QuoteId)</p>
                <p>Submitted: @FormatSubmittedDate(issuedOn)</p>
                <p>Status: @(Model.ApiSuccess ? "Delivered to CERM" : "Pending manual review")</p>
            </article>
            <article class="info-panel">
                <h3>Project</h3>
                <p>Description: @FormatMaybeValue(Model.QuoteRequest?.Description)</p>
                <p>Reference: @FormatMaybeValue(Model.QuoteRequest?.ReferenceValue)</p>
                <p>Artwork: @FormatMaybeValue(Model.QuoteRequest?.ArtworkOption)</p>
                <p>Comments: @FormatMaybeValue(Model.QuoteRequest?.Comments)</p>
            </article>
        </section>
        -->
        <section class="info-panel" style="margin-bottom:2rem;">
            <h3>Production Details</h3>
            <div style="display:flex; flex-wrap:wrap; gap:1.25rem; font-size:0.95rem;">
                <div>
                    <p style="margin:0.15rem 0;">Shape: @Capitalize(Model.QuoteRequest?.Shape)</p>
                    <p style="margin:0.15rem 0;">Size: @(string.IsNullOrWhiteSpace(Model.QuoteRequest?.Diameter)
                        ? FormatDimension(Model.QuoteRequest?.LabelWidth, Model.QuoteRequest?.LabelHeight)
                        : $"{Model.QuoteRequest?.Diameter}\" Diameter")
                    </p>
                    <p style="margin:0.15rem 0;">
                        Die Size: @FormatMaybeValue(Model.QuoteRequest?.DieSizeInfo)
                        @if (Model.QuoteRequest?.IsCustomDie == true)
                        {
                            <span style="background:#fef3c7; color:#92400e; padding:0.15rem 0.5rem; border-radius:4px; font-size:0.85rem; font-weight:600; margin-left:0.5rem;">
                                ⚠️ CUSTOM DIE
                            </span>
                        }
                    </p>
                    <p style="margin:0.15rem 0;">Corners: @FormatMaybeValue(Model.QuoteRequest?.Corners)</p>
                </div>
                <div>
                    <p style="margin:0.15rem 0;">Material: @FormatMaybeValue(Model.QuoteRequest?.Material)</p>
                    <p style="margin:0.15rem 0;">Finish: @FormatMaybeValue(Model.QuoteRequest?.Finish)</p>
                    <p style="margin:0.15rem 0;">Printing: @FormatMaybeValue(Model.QuoteRequest?.Printing)</p>
                    <p style="margin:0.15rem 0;">Packing: @FormatMaybeValue(Model.QuoteRequest?.PackingProcedure)</p>
                </div>
                <div>
                    <p style="margin:0.15rem 0;">Application: @FormatMaybeValue(Model.QuoteRequest?.ApplicationMethod)</p>
                    <p style="margin:0.15rem 0;">Unwind: @FormatMaybeValue(Model.QuoteRequest?.UnwindDirection)</p>
                    <p style="margin:0.15rem 0;">Quantities: @(
                        Model.QuoteRequest?.Quantities?.Count > 0
                            ? string.Join(", ", Model.QuoteRequest.Quantities)
                            : FormatMaybeValue(Model.QuoteRequest?.TotalQuantity))
                    </p>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.QuoteRequest?.UploadedFileName))
        {
            <section class="info-panel" style="margin-bottom:2rem;">
                <h3>Uploaded File</h3>
                <div style="display:flex; align-items:center; gap:1rem; margin-top:0.75rem;">
                    <div style="flex:1;">
                        <p style="margin:0.15rem 0; font-weight:600;">
                            📎 @Model.QuoteRequest.UploadedFileOriginalName
                        </p>
                        <p style="margin:0.15rem 0; color:#64748b; font-size:0.875rem;">
                            @FormatFileSize(Model.QuoteRequest.UploadedFileSize ?? 0)
                            @if (!string.IsNullOrWhiteSpace(Model.QuoteRequest.UploadedFileContentType))
                            {
                                <span> • @Model.QuoteRequest.UploadedFileContentType</span>
                            }
                        </p>
                    </div>
                    <div>
                        <a href="/uploads/quotes/@Model.QuoteRequest.UploadedFileName" 
                           target="_blank" 
                           class="btn btn-outline-primary btn-sm"
                           download="@Model.QuoteRequest.UploadedFileOriginalName">
                            Download File
                        </a>
                    </div>
                </div>
            </section>
        }

        <table class="line-items">
            <thead>
                <tr>
                    <th style="width: 25%;" class="text-right">Quantity</th>
                    <th style="width: 25%;" class="text-right">Unit Price</th>
                    <th style="width: 30%;" class="text-right">Line Total</th>
                    <th style="width: 20%;" class="text-right">Currency</th>
                </tr>
            </thead>
            <tbody>
                @if (pricingRows.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center" style="color:#94a3b8;">Pricing will be supplied after estimator review.</td>
                    </tr>
                }
                else
                {
                    foreach (var price in pricingRows)
                    {
                        <tr>
                            <td class="text-right">@(price.Quantity?.ToString("N0") ?? "—")</td>
                            <td class="text-right">@FormatCurrency(price.UnitPrice)</td>
                            <td class="text-right">@FormatCurrency(price.TotalPrice)</td>
                            <td class="text-right">@(string.IsNullOrWhiteSpace(price.Currency) ? "USD" : price.Currency)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @await Html.PartialAsync("_AdditionalCharges", (IReadOnlyList<WiseLabels.Models.QuoteLineItem>)(Model.QuoteRequest?.LineItems ?? new List<WiseLabels.Models.QuoteLineItem>()))

        <section class="notes">
            <strong>Notes & Next Steps</strong>
            <p style="margin: 0.35rem 0 0;">
                Keep this confirmation handy when referencing estimate <strong>@quoteReference</strong>.
            </p>
        </section>

        <p style="margin-top:1.5rem; margin-bottom:1.5rem; font-size:0.95rem; color:#0f172a; line-height:1.6;">
            Please include this quote reference when placing an order. Freight is estimated and subject to change at shipment. Quotes expire after 30 days.
            Dies and tooling are a one-time charge. Materials should be tested in production and end-use environments to confirm fit for purpose.
        </p>

        <p style="text-align: center; margin-top: 2rem; font-size: 0.95rem; color: #475569;">
            Thank you for partnering with WiseLabels. We look forward to supporting your next release.
        </p>

        <div class="action-buttons">
            <a href="/" class="btn btn-primary btn-lg">Submit Another Quote</a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ApiResponseJson))
        {
            <!--
            <section style="margin-top:3rem;">
                <div class="card">
                    <div class="card-header">
                        <h2 class="h5 mb-0">CERM API Response</h2>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">Raw response from the quote submission API:</p>
                        <pre class="bg-light p-3 rounded border" style="max-height: 500px; overflow-y: auto; font-size: 0.875rem; white-space: pre-wrap; word-wrap: break-word; margin-bottom: 0;"><code>@Model.ApiResponseJson</code></pre>
                    </div>
                </div>
            </section>
            -->
        }

        @if (!string.IsNullOrEmpty(Model.ApiRequestJson))
        {
            <div class="card mt-4 border-secondary" style="font-family:'Segoe UI',Roboto,Arial,sans-serif;">
                <div class="card-header bg-secondary bg-opacity-10 p-2">
                    <h6 class="mb-0">
                        <button class="btn btn-link text-decoration-none w-100 text-start d-flex justify-content-between align-items-center py-0"
                                type="button" data-bs-toggle="collapse"
                                data-bs-target="#debugApiRequestCollapse"
                                aria-expanded="false" aria-controls="debugApiRequestCollapse">
                            <span>&#x1F527; Debug: CERM API Request JSON</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </button>
                    </h6>
                </div>
                <div class="collapse" id="debugApiRequestCollapse">
                    <div class="card-body p-3">
                        <p class="text-muted small mb-2">JSON payload sent to CERM API:</p>
                        <pre class="bg-light p-3 rounded border" style="max-height: 500px; overflow-y: auto; font-size: 0.875rem; white-space: pre-wrap; word-wrap: break-word; margin-bottom: 0;"><code>@Model.ApiRequestJson</code></pre>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const printBtn = document.getElementById('print-btn');
        const pdfBtn = document.getElementById('pdf-btn');
        const quoteId = '@Model.QuoteId';
        const cermEstimateId = '@(Model.CermEstimateId ?? "")';
        const cermCalculationId = '@(Model.CermCalculationId ?? "")';
        const pdfId = cermEstimateId || cermCalculationId || quoteId;
        const submittedDate = '@Model.SubmittedDate.ToString("yyyy-MM-dd")';

        if (printBtn) {
            printBtn.addEventListener('click', function() {
                window.print();
            });
        }

        if (pdfBtn) {
            pdfBtn.addEventListener('click', async function() {
                const originalText = pdfBtn.textContent;
                pdfBtn.disabled = true;
                pdfBtn.textContent = 'Downloading PDF...';

                if (!pdfId) {
                    alert('Missing calculation id for PDF download.');
                    pdfBtn.disabled = false;
                    pdfBtn.textContent = originalText;
                    return;
                }

                try {
                    const url = `?handler=Pdf&calculationId=${encodeURIComponent(pdfId)}`;
                    const resp = await fetch(url, { method: 'GET' });

                    if (!resp.ok) {
                        const message = await resp.text().catch(() => '');
                        if (resp.status === 404) {
                            throw new Error(message || 'PDF not found (404).');
                        }
                        throw new Error(message || `Error downloading PDF (${resp.status}).`);
                    }

                    const blob = await resp.blob();
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = pdfId
                        ? `quote-${pdfId}-${submittedDate}.pdf`
                        : `quote-request-${submittedDate}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(downloadUrl);
                } catch (e) {
                    alert(`Unable to download PDF: ${e?.message || e}`);
                } finally {
                    pdfBtn.disabled = false;
                    pdfBtn.textContent = originalText;
                }
            });
        }
    });
</script>
}

