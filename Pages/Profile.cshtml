@page
@model WiseLabels.Pages.ProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="dashboard-container">
    @await Html.PartialAsync("_LeftSidebar")
    <main class="dashboard-main">
        <div class="container-fluid">
            <h1 class="dashboard-page-title">
                <i class="bi bi-person-circle"></i> User Profile
            </h1>

            <!-- Access Level Alert -->
            @if (Model.HasFullAccess)
            {
                <div class="alert alert-success" role="alert">
                    <strong><i class="bi bi-shield-check"></i> Full Access</strong>
                    <p class="mb-0">@Model.AccessLevelDescription</p>
                </div>
            }
            else if (Model.HasLimitedAccess)
            {
                <div class="alert alert-info" role="alert">
                    <strong><i class="bi bi-shield"></i> Limited Access</strong>
                    <p class="mb-0">@Model.AccessLevelDescription</p>
                </div>
            }
            else
            {
                <div class="alert alert-secondary" role="alert">
                    <strong><i class="bi bi-info-circle"></i> Basic Access</strong>
                    <p class="mb-0">@Model.AccessLevelDescription</p>
                </div>
            }

            <!-- Basic Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Basic Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-bold" style="width: 200px;">Display Name:</td>
                                <td>@Model.DisplayName</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Email:</td>
                                <td>@Model.Email</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.UserPrincipalName))
                            {
                                <tr>
                                    <td class="fw-bold">User Principal Name:</td>
                                    <td>@Model.UserPrincipalName</td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.ObjectId))
                            {
                                <tr>
                                    <td class="fw-bold">Object ID:</td>
                                    <td><code class="small">@Model.ObjectId</code></td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.TenantId))
                            {
                                <tr>
                                    <td class="fw-bold">Tenant ID:</td>
                                    <td><code class="small">@Model.TenantId</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Access Permissions -->
            <div class="card mb-4">
                <div class="card-header bg-gradient text-black">
                    <h5 class="mb-0">Access Permissions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted">Access Level</h6>
                            @if (Model.HasFullAccess)
                            {
                                <span class="badge bg-success fs-6">Full Access</span>
                            }
                            else if (Model.HasLimitedAccess)
                            {
                                <span class="badge bg-info fs-6">Limited Access</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">Basic Access</span>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted">User Override</h6>
                            @if (Model.IsFullAccessUser)
                            {
                                <span class="badge bg-warning text-dark fs-6">Full Access User Override</span>
                            }
                            else if (Model.IsLimitedAccessUser)
                            {
                                <span class="badge bg-warning text-dark fs-6">Limited Access User Override</span>
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </div>
                    </div>

                    @if (Model.MatchedFullAccessGroups.Any())
                    {
                        <div class="mt-3">
                            <h6 class="text-success">Matched Full Access Groups:</h6>
                            <ul class="list-unstyled">
                                @foreach (var group in Model.MatchedFullAccessGroups)
                                {
                                    <li><span class="badge bg-success">@group</span></li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.MatchedLimitedAccessGroups.Any())
                    {
                        <div class="mt-3">
                            <h6 class="text-info">Matched Limited Access Groups:</h6>
                            <ul class="list-unstyled">
                                @foreach (var group in Model.MatchedLimitedAccessGroups)
                                {
                                    <li><span class="badge bg-info">@group</span></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <!-- Groups & Roles -->
            @if (Model.Groups.Any() || Model.Roles.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Groups & Roles</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Groups.Any())
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold">Azure AD Groups (@Model.Groups.Count total):</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var group in Model.Groups)
                                    {
                                        <span class="badge bg-primary">@group</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold">Azure AD Groups:</h6>
                                <p class="text-muted">No groups found. Group claims may need to be enabled in Azure AD.</p>
                            </div>
                        }

                        @if (Model.Roles.Any())
                        {
                            <div>
                                <h6 class="fw-bold">Roles:</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var role in Model.Roles)
                                    {
                                        <span class="badge bg-secondary">@role</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- All Claims (Collapsible - for debugging) -->
            @if (Model.AllClaims.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <button class="btn btn-link text-white text-decoration-none w-100 text-start p-0" type="button" 
                                    data-bs-toggle="collapse" data-bs-target="#claimsCollapse" aria-expanded="false">
                                All Claims (Click to expand)
                            </button>
                        </h5>
                    </div>
                    <div class="collapse" id="claimsCollapse">
                        <div class="card-body">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Claim Type</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model.AllClaims.OrderBy(c => c.Key))
                                    {
                                        <tr>
                                            <td><code class="small">@claim.Key</code></td>
                                            <td class="text-break">@claim.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Back Button -->
            <div class="text-center mt-4">
                <a asp-page="/Index" class="btn btn-outline-primary">Back to Dashboard</a>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        // Optional: Auto-expand claims if in development
        @if (Model.AllClaims.Count > 0)
        {
            <text>
            // Auto-expand on load for convenience
            // document.getElementById('claimsCollapse').classList.add('show');
            </text>
        }
    </script>
}
