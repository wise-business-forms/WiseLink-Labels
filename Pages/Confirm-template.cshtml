            <p style="margin: 0.15rem 0;">@shipTo.Address</p>
        </article>
        <article class="info-panel">
            <h3>Summary</h3>
            <p style="margin: 0.15rem 0;">Payment Terms: Net 15</p>
            <p style="margin: 0.15rem 0;">Customer PO: 550174-A</p>
            <p style="margin: 0.15rem 0;">CSR: Dana Hensley</p>
            <p style="margin: 0.15rem 0;">Estimator: Chris Schroeder</p>
        </article>
    </section>
    -->
    <table class="line-items">
        <thead>
            <tr>
                <th style="width: 15%;" class="text-right">Quantity</th>
                <th style="width: 15%;" class="text-right">Unit Price</th>
                <th style="width: 18%;" class="text-right">Line Total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in lineItems)
        {
            var lineTotal = (item.Quantity / unitPerPrice) * item.UnitPrice;
            <tr>
                <td class="text-right">@item.Quantity.ToString("N0")</td>
                <td class="text-right">@Money(item.UnitPrice)</td>
                <td class="text-right">@Money(lineTotal)</td>
            </tr>
        }
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td>Subtotal</td>
            <td class="text-right">@Money(subtotal)</td>
        </tr>
        <tr>
            <td>Promotional Discount</td>
            <td class="text-right">-@Money(discount)</td>
        </tr>
        <tr>
            <td>Shipping & Handling</td>
            <td class="text-right">@Money(shipping)</td>
        </tr>
        <tr>
            <td>Tax (@(taxRate * 100):0.##%)</td>
            <td class="text-right">@Money(tax)</td>
        </tr>
        <tr>
            <td>Total Due</td>
            <td class="text-right">@Money(totalDue)</td>
        </tr>
    </table>
    <section class="fine-print">
        Payment Terms - Net 30 Lead Time - TBD
        Orders are subject to +-10% overruns and underruns unless otherwise noted.
    </section>
    <section class="notes">
        <strong>Notes & Next Steps</strong>
        <p style="margin: 0.35rem 0 0;">
            Project Name: Bob's Test'
        </p>
    </section>
    <p style="margin-top:1.5rem; margin-bottom:1.5rem; font-size:0.95rem; color:#0f172a; line-height:1.6;">
        Please refer to Quote # when placing an order. Shipping / freight costs are not included in price unless specified. Shipping / freight costs are estimatedand could increase at the time the order is shipped. Quotes expire after 30 days. Dies and tooling are a one-time charge. FOB shipping point unlessotherwise stated. Pricing is subject to change upon receipt of artwork, if not provided with the quote request. Materials should be tested in the printing,label application, and end use environments to ensure proper performance. Material samples available upon request. Hard proofs are required at noextra charge for new orders greater than $3,000.
    </p>
    <section class="additional-charges">
        <h3>Additional Charges (if applicable)</h3>
        <table>
            <thead>
                <tr>
                    <th style="width: 55%;">Description</th>
                    <th style="width: 10%;"></th>
                    <th style="width: 20%;" class="text-right">Price</th>
                    <th style="width: 15%;">Units</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>PDF Proof</td>
                    <td>per Proof</td>
                    <td>$ - </td>
                    <td>each</td>                    
                </tr>
                <!--
                <tr>
                    <td colspan="4" style="text-align:center; color:#94a3b8; font-style:italic;">
                        No additional charges were added to this quote.
                    </td>
                </tr>
                -->
            </tbody>
        </table>
    </section>
    <p style="text-align: center; margin-top: 2rem; font-size: 0.95rem; color: #475569;">
        Thank you for partnering with WiseLabels. We look forward to supporting your next release.
    </p>
</div>
</div>

<script>
    function printInvoice() {
        window.print();
    }
</script>
