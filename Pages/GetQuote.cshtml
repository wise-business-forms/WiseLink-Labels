        <script>
        (function () {
            const collapseEl = document.getElementById('debugFormValuesCollapse');
            const tbody = document.getElementById('debug-form-tbody');
            const form = document.getElementById('quote-form');
            if (!collapseEl || !tbody || !form) return;

            const GROUPS = {
                'Customer':      ['customerId','customerDisplayName'],
                'Contact':       ['name','company','email','phone','comments'],
                'Reference':     ['referenceType','referenceValue','description'],
                'Shape':         ['shape','shapeValue','corners','cornersValue'],
                'Dimensions':    ['labelWidth','labelHeight','diameter'],
                'Die':           ['existingDie','cuttingDieValue','dieSizeInfo','isCustomDie'],
                'Material':      ['material','materialDisplay','materialValue'],
                'Printing':      ['printing','printingValue','colorCode','colorCodeValue'],
                'Finish':        ['finish','finishValue'],
                'Packing':       ['packingProcedure','packingProcedureValue'],
                'Application':   ['applicationMethod','applicationMethodValue'],
                'Unwind':        ['unwindDirection','unwindDirectionValue'],
                'Quantities':    ['totalQuantity','quantity'],
                'Artwork':       ['artworkOption','artworkOptionValue'],
                'Press Proof':   ['needsPressProof','pressProofQuantity'],
                'Spot Color':    ['needsSpotColorPlateChange','spotColorPlateChangeQuantity'],
                'Color Changes': ['colorChanges','digitalVersionChanges'],
            };
            const GROUP_CLASSES = {
                Customer:'table-primary', Shape:'table-info', Dimensions:'table-info',
                Material:'table-success', Printing:'table-warning', Finish:'table-warning',
                Quantities:'table-danger', Die:'table-secondary'
            };

            function esc(s) {
                return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            function render() {
                const data = {};
                for (const [k, v] of new FormData(form).entries()) {
                    if (k === '__RequestVerificationToken') continue;
                    if (k in data) {
                        data[k] = Array.isArray(data[k]) ? [...data[k], v] : [data[k], v];
                    } else {
                        data[k] = v;
                    }
                }

                const rows = [], seen = new Set();
                for (const [group, keys] of Object.entries(GROUPS)) {
                    let hdr = false;
                    for (const key of keys) {
                        if (!(key in data)) continue;
                        seen.add(key);
                        if (!hdr) {
                            rows.push(`<tr class="table-secondary"><td colspan="2" class="fw-bold small py-1 px-2 text-uppercase letter-spacing-1">${group}</td></tr>`);
                            hdr = true;
                        }
                        const val = Array.isArray(data[key]) ? data[key].join(', ') : data[key];
                        const disp = val === '' ? '<em class="text-muted">(empty)</em>' : `<code>${esc(val)}</code>`;
                        rows.push(`<tr class="${GROUP_CLASSES[group] ?? ''}"><td class="fw-semibold small">${esc(key)}</td><td>${disp}</td></tr>`);
                    }
                }

                const extras = Object.keys(data).filter(k => !seen.has(k));
                if (extras.length) {
                    rows.push(`<tr class="table-secondary"><td colspan="2" class="fw-bold small py-1 px-2 text-uppercase">Other</td></tr>`);
                    for (const k of extras) {
                        const val = Array.isArray(data[k]) ? data[k].join(', ') : data[k];
                        rows.push(`<tr><td class="fw-semibold small">${esc(k)}</td><td><code>${esc(val)}</code></td></tr>`);
                    }
                }

                tbody.innerHTML = rows.length
                    ? rows.join('')
                    : '<tr><td colspan="2" class="text-muted text-center">No form data found</td></tr>';
            }

            collapseEl.addEventListener('show.bs.collapse', render);
            form.addEventListener('input',  () => { if (collapseEl.classList.contains('show')) render(); });
            form.addEventListener('change', () => { if (collapseEl.classList.contains('show')) render(); });
            ['shapeSelectionChanged','printingSelectionChanged','unwindSelectionChanged','cornerSelectionChanged']
                .forEach(e => window.addEventListener(e, () => {
                    if (collapseEl.classList.contains('show')) setTimeout(render, 50);
                }));
        })();
        </script>

