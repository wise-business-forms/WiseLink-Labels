            (function () {
                const unwindOptions = document.querySelectorAll('.unwind-option');
                const unwindInput = document.getElementById('unwind-input');
                const unwindValueInput = document.getElementById('unwind-value-input');
                if (!unwindOptions.length || !unwindInput || !unwindValueInput) {
                    return;
                }

                function setActive(button, raiseEvent = false) {
                    unwindOptions.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    // Store the numeric ID in unwindDirectionValue for CERM API
                    const numericId = button.dataset.value || '';
                    const label = button.dataset.label || '';
                    unwindValueInput.value = numericId;
                    unwindInput.value = label; // Keep label for display/confirmation

                    if (raiseEvent) {
                        window.dispatchEvent(new CustomEvent('unwindSelectionChanged', {
                            detail: {
                                value: numericId,
                                label: label,
                                key: (numericId || '').toLowerCase()
                            }
                        }));
                    }
                }

                unwindOptions.forEach(button => {
                    button.addEventListener('click', function () {
                        setActive(this, true);
                    });
                });

                // Check for active button from server-side rendering first
                let initialActive = document.querySelector('.unwind-option.active');

                // If no active button but we have a saved value in the hidden input, try to match it
                if (!initialActive && (unwindInput.value || unwindValueInput.value)) {
                    const savedValue = (unwindValueInput.value || unwindInput.value).trim();
                    // Try to find a button that matches the saved value
                    initialActive = Array.from(unwindOptions).find(btn => {
                        const btnValue = btn.dataset.value || '';
                        const btnLabel = btn.dataset.label || '';
                        // Match by ID, label, or if saved value starts with the button's ID
                        return btnValue === savedValue ||
                               btnLabel.toLowerCase() === savedValue.toLowerCase() ||
                               savedValue.startsWith(btnValue + ' ') ||
                               savedValue.startsWith(btnValue + '-');
                    });
                }

                if (initialActive) {
                    setActive(initialActive);
                } else if (unwindOptions.length) {
                    // Default to first option only if no saved value
                    setActive(unwindOptions[0]);
                }
            })();

            (function () {
                const colorChangesSection = document.getElementById('color-changes-section');
                const colorChangesInput = document.getElementById('color-changes');
                const digitalVersionChangesSection = document.getElementById('digital-version-changes-section');
                const digitalVersionChangesInput = document.getElementById('digital-version-changes');
                const lineItemsSection = document.getElementById('line-items-section');
                const lineItemsWarningAlert = document.getElementById('line-items-warning-alert');
                const pressProofCheckbox = document.getElementById('needs-press-proof');
                const pressProofQuantityInput = document.getElementById('press-proof-quantity');
                const spotColorCheckbox = document.getElementById('needs-spot-color-plate-change');
                const spotColorQuantityInput = document.getElementById('spot-color-plate-change-quantity');

                if (!colorChangesSection || !colorChangesInput || !digitalVersionChangesSection || !digitalVersionChangesInput || !lineItemsSection) {
                    console.warn('Missing printing-dependent field elements');
                    return;
                }

                let userHasInteracted = false;

                function removeLineItemsAttention() {
                    if (!lineItemsSection) return;

                    userHasInteracted = true;
                    lineItemsSection.classList.remove('needs-attention');
                    if (lineItemsWarningAlert) {
                        lineItemsWarningAlert.classList.add('d-none');
                    }
                }

                function checkLineItemsAttention() {
                    // Check if we're from a saved quote
                    const savedQuoteElement = document.getElementById('saved-quote-data');
                    if (!savedQuoteElement || !lineItemsSection) {
                        return;
                    }

                    // Check if line items section is visible
                    if (lineItemsSection.classList.contains('d-none')) {
                        return;
                    }

                    // If user has already interacted with any field, don't re-apply highlighting
                    if (userHasInteracted) {
                        return;
                    }

                    // Check if any visible numeric inputs have no value or are still at the default 0 (not user-entered)
                    // Only highlight if the fields appear to be untouched
                    const colorChangesUntouched = !colorChangesSection.classList.contains('d-none') && !colorChangesInput.value;
                    const digitalVersionUntouched = !digitalVersionChangesSection.classList.contains('d-none') && !digitalVersionChangesInput.value;
                    const hasUntouchedFields = colorChangesUntouched || digitalVersionUntouched;

                    if (hasUntouchedFields) {
                        lineItemsSection.classList.add('needs-attention');
                        if (lineItemsWarningAlert) {
                            lineItemsWarningAlert.classList.remove('d-none');
                        }
                    } else {
                        lineItemsSection.classList.remove('needs-attention');
                        if (lineItemsWarningAlert) {
                            lineItemsWarningAlert.classList.add('d-none');
                        }
                    }
                }

                function updatePrintingDependentFields(printingLabel) {
                    const labelLower = (printingLabel || '').toLowerCase();
                    const isSpotPrinting = labelLower.includes('spot');
                    const isProcessColor = labelLower.includes('process') && labelLower.includes('color');

                    console.log('Printing selection:', printingLabel, '| Spot:', isSpotPrinting, '| Process Color:', isProcessColor);

                    // Show/hide color changes for spot printing
                    colorChangesSection.classList.toggle('d-none', !isSpotPrinting);
                    if (!isSpotPrinting) {
                        colorChangesInput.value = ''; // Clear instead of setting to 0
                    }

                    // Show/hide digital version changes for process color
                    digitalVersionChangesSection.classList.toggle('d-none', !isProcessColor);
                    if (!isProcessColor) {
                        digitalVersionChangesInput.value = ''; // Clear instead of setting to 0
                    }

                    // Show line items section if any subsection is visible
                    const hasVisibleLineItems = isSpotPrinting || isProcessColor;
                    lineItemsSection.classList.toggle('d-none', !hasVisibleLineItems);

                    // Check if we need attention styling (only if user hasn't interacted yet)
                    checkLineItemsAttention();
                }

                // Remove highlighting on ANY interaction with line items fields
                colorChangesInput.addEventListener('input', removeLineItemsAttention);
                colorChangesInput.addEventListener('change', removeLineItemsAttention);
                digitalVersionChangesInput.addEventListener('input', removeLineItemsAttention);
                digitalVersionChangesInput.addEventListener('change', removeLineItemsAttention);

                if (pressProofCheckbox) {
                    pressProofCheckbox.addEventListener('change', removeLineItemsAttention);
                }
                if (pressProofQuantityInput) {
                    pressProofQuantityInput.addEventListener('input', removeLineItemsAttention);
                    pressProofQuantityInput.addEventListener('change', removeLineItemsAttention);
                }
                if (spotColorCheckbox) {
                    spotColorCheckbox.addEventListener('change', removeLineItemsAttention);
                }
                if (spotColorQuantityInput) {
                    spotColorQuantityInput.addEventListener('input', removeLineItemsAttention);
                    spotColorQuantityInput.addEventListener('change', removeLineItemsAttention);
                }

                // Listen for printing selection changes
                window.addEventListener('printingSelectionChanged', event => {
                    updatePrintingDependentFields(event.detail?.label || '');
                });

                // Check initial state
                const printingInput = document.getElementById('printing-input');
                if (printingInput && printingInput.value) {
                    updatePrintingDependentFields(printingInput.value);
                }
            })();

            (function () {
                const finishSelect = document.getElementById('finish-select');
                const finishValueInput = document.getElementById('finish-value');
                const finishLoading = document.getElementById('finish-loading');
                const finishError = document.getElementById('finish-error');
                const finishRetry = document.getElementById('finish-retry');
                const filtersElement = document.getElementById('printing-finish-filters');
                const finishSection = document.getElementById('finish-section');
                const finishWarningAlert = document.getElementById('finish-warning-alert');

                if (!finishSelect || !filtersElement || !finishValueInput) {
                    return;
                }

                const initialValue = (finishSelect.dataset.initialValue || '').trim();
                let selectedValue = initialValue;
                let currentPrintingKey = null;
                let allFinishes = [];

                const printingFinishFilters = (() => {
                    try {
                        const parsed = JSON.parse(filtersElement.textContent || '{}');
                        return Object.keys(parsed || {}).reduce((acc, key) => {
                            acc[key.toLowerCase()] = (parsed[key] || []).map(v => (v || '').toString().toLowerCase());
                            return acc;
                        }, {});
                    }
                    catch {
                        return {};
                    }
                })();

                function getDescription(item) {
                    const descriptions = item.Descriptions || item.descriptions || [];
                    const en = descriptions.find(d => (d.ISOLanguageCode || d.isoLanguageCode || '').toLowerCase() === "en-us");
                    const fallback = descriptions[0];
                    return (en && (en.Description || en.description))
                        || (fallback && (fallback.Description || fallback.description))
                        || item.Id
                        || item.id
                        || 'Unknown Finish';
                }

                function getId(item) {
                    return item.Id || item.id || '';
                }

                function rebuildOptions(items) {
                    // Only show "Select a finish" if no value has been selected yet
                    const hasSelectedValue = selectedValue && selectedValue !== '';
                    finishSelect.innerHTML = hasSelectedValue ? '' : '<option value="">Select a finish</option>';

                    if (!items.length) {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No finishes available for this printing option';
                        option.disabled = true;
                        option.selected = true;
                        finishSelect.appendChild(option);
                        finishValueInput.value = '';
                        return;
                    }

                    items.forEach(item => {
                        const id = getId(item);
                        const description = getDescription(item);
                        const option = document.createElement('option');
                        option.value = description;  // Use description as value for display on Confirm/Success
                        option.textContent = description;  // Show description to user
                        option.dataset.finishId = id;  // Store ID in data attribute for API
                        finishSelect.appendChild(option);
                    });

                    // Try to match by description first, then fall back to ID
                    const normalizedSelected = (selectedValue || '').toLowerCase();
                    let matchingOption = Array.from(finishSelect.options).find(opt => 
                        opt.value.toLowerCase() === normalizedSelected);
                    if (!matchingOption) {
                        // Fall back to matching by ID (for backwards compatibility with saved data)
                        matchingOption = Array.from(finishSelect.options).find(opt => 
                            (opt.dataset.finishId || '').toLowerCase() === normalizedSelected);
                    }
                    if (matchingOption) {
                        matchingOption.selected = true;
                        finishValueInput.value = matchingOption.dataset.finishId || '';
                    }

                    // Check if we should add needs-attention styling
                    // Add it if options are loaded, we're from a saved quote, and no finish is selected
                    const savedQuoteElement = document.getElementById('saved-quote-data');
                    if (savedQuoteElement && finishSection && !finishSelect.value && items.length > 0) {
                        finishSection.classList.add('needs-attention');
                    }
                }

                function applyFilter() {
                    if (!allFinishes.length) {
                        return;
                    }

                    const keywords = currentPrintingKey ? (printingFinishFilters[currentPrintingKey] || []) : [];
                    const filtered = keywords.length === 0
                        ? allFinishes
                        : allFinishes.filter(item => {
                            const description = getDescription(item).toLowerCase();
                            return keywords.some(keyword => description.includes(keyword));
                        });

                    rebuildOptions(filtered);
                }

                finishSelect.addEventListener('change', () => {
                    selectedValue = finishSelect.value;
                    // Get the ID from the selected option's data attribute
                    const selectedOption = finishSelect.options[finishSelect.selectedIndex];
                    finishValueInput.value = selectedOption?.dataset.finishId || '';

                    // Remove needs-attention styling and hide warning alert when a selection is made
                    if (selectedValue && selectedValue !== '') {
                        if (finishSection) {
                            finishSection.classList.remove('needs-attention');
                        }
                        if (finishWarningAlert) {
                            finishWarningAlert.classList.add('d-none');
                        }
                        // Rebuild options to remove "Select a finish" after selection
                        applyFilter();
                    }
                });

                window.addEventListener('printingSelectionChanged', event => {
                    currentPrintingKey = (event.detail?.key || '').toLowerCase();
                    applyFilter();
                });

                async function loadFinishes() {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 15000);
                    try {
                        finishLoading.classList.remove('d-none');
                        finishError.classList.add('d-none');
                        finishRetry?.classList.add('d-none');
                        const response = await fetch('/Api/FinishingTypes', { headers: { 'Accept': 'application/json' }, signal: controller.signal });
                        clearTimeout(timeoutId);
                        if (!response.ok) {
                            const errorData = await response.json().catch(() => ({ error: 'Unable to load finishes right now.' }));
                            throw new Error(errorData.error || `Unable to load finishes (${response.status})`);
                        }

                        const payload = await response.json();
                        const items = payload.materials || payload.data || payload.items || payload.results || payload;
                        if (!Array.isArray(items) || items.length === 0) {
                            throw new Error('No finishes were returned.');
                        }
                        allFinishes = items;
                        applyFilter();
                    } catch (error) {
                        clearTimeout(timeoutId);
                        const message = error.name === 'AbortError' ? 'Loading timed out. Please retry.' : (error.message || 'Unable to load finishes right now.');
                        console.error('Failed to load finishes', error);
                        finishError.textContent = message;
                        finishError.classList.remove('d-none');
                        finishRetry?.classList.remove('d-none');
                        finishSelect.innerHTML = '<option value="">Unable to load finishes</option>';
                    } finally {
                        finishLoading.classList.add('d-none');
                    }
                }

                const activePrinting = document.querySelector('.printing-option.active');
                if (activePrinting) {
                    currentPrintingKey = (activePrinting.dataset.printingKey || activePrinting.dataset.value || '').toLowerCase();
                }

                finishRetry?.addEventListener('click', loadFinishes);
                _apiLoaders.push(loadFinishes);
            })();

            // Packing Procedures Loader
            (function () {
                const packingProcedureSelect = document.getElementById('packing-procedure-select');
                const packingProcedureLoading = document.getElementById('packing-procedure-loading');
                const packingProcedureError = document.getElementById('packing-procedure-error');
                const packingRetry = document.getElementById('packing-retry');

                if (!packingProcedureSelect || !packingProcedureLoading || !packingProcedureError) {
                    return;
                }

                const savedValue = packingProcedureSelect.dataset.initialValue || '';
                let selectedValue = savedValue;

                function getDescription(item) {
                    const descriptions = item.Descriptions || item.descriptions || [];
                    const en = descriptions.find(d => (d.ISOLanguageCode || d.isoLanguageCode || '').toLowerCase() === "en-us");
                    const fallback = descriptions[0];
                    return (en && (en.Description || en.description))
                        || (fallback && (fallback.Description || fallback.description))
                        || item.Id
                        || item.id
                        || 'Unknown Procedure';
                }

                function rebuildOptions(items) {
                    // Only show "Select a packing procedure" if no value has been selected yet
                    const hasSelectedValue = selectedValue && selectedValue !== '';
                    packingProcedureSelect.innerHTML = hasSelectedValue ? '' : '<option value="">Select a packing procedure</option>';

                    if (items.length === 0) {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No packing procedures available for quick quote';
                        option.disabled = true;
                        packingProcedureSelect.appendChild(option);
                        return;
                    }

                    items.forEach(item => {
                        const description = getDescription(item);
                        const option = document.createElement('option');
                        option.value = description;
                        option.textContent = description;
                        packingProcedureSelect.appendChild(option);
                    });

                    if (selectedValue) {
                        const normalizedSaved = selectedValue.toLowerCase();
                        const matchingOption = Array.from(packingProcedureSelect.options).find(
                            opt => opt.value.toLowerCase() === normalizedSaved
                        );
                        if (matchingOption) {
                            matchingOption.selected = true;
                        }
                    }
                }

                async function loadPackingProcedures() {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 15000);
                    try {
                        packingProcedureLoading.classList.remove('d-none');
                        packingProcedureError.classList.add('d-none');
                        packingRetry?.classList.add('d-none');

                        const response = await fetch('/Api/PackingProcedures', { headers: { 'Accept': 'application/json' }, signal: controller.signal });
                        clearTimeout(timeoutId);
                        if (!response.ok) {
                            const errorData = await response.json().catch(() => ({ error: 'Unable to load packing procedures right now.' }));
                            throw new Error(errorData.error || `Unable to load packing procedures (${response.status})`);
                        }

                        const payload = await response.json();
                        const allItems = payload.Data || payload.data || payload.Items || payload.items || payload.Results || payload.results || payload;

                        if (!Array.isArray(allItems)) {
                            throw new Error('Invalid response format from packing procedures API.');
                        }

                        // Filter to only show items where AllowQuickQuote is true
                        const items = allItems.filter(item => item.AllowQuickQuote === true || item.allowQuickQuote === true);

                        rebuildOptions(items);
                    } catch (error) {
                        clearTimeout(timeoutId);
                        const message = error.name === 'AbortError' ? 'Loading timed out. Please retry.' : (error.message || 'Unable to load packing procedures right now.');
                        console.error('Failed to load packing procedures', error);
                        packingProcedureError.textContent = message;
                        packingProcedureError.classList.remove('d-none');
                        packingRetry?.classList.remove('d-none');
                        packingProcedureSelect.innerHTML = '<option value="">Unable to load packing procedures</option>';
                    } finally {
                        packingProcedureLoading.classList.add('d-none');
                    }
                }

                packingRetry?.addEventListener('click', loadPackingProcedures);

                // Add change event listener to track selection and rebuild options
                packingProcedureSelect.addEventListener('change', () => {
                    selectedValue = packingProcedureSelect.value;
                    
                    // Show/hide packing quantity field based on selection
                    const packingQuantitySection = document.getElementById('packing-quantity-section');
                    const packingProcedureValueInput = document.getElementById('packing-procedure-value');
                    
                    if (packingQuantitySection && packingProcedureValueInput) {
                        const selectedText = selectedValue.toLowerCase();
                        const isRoll = selectedText.includes('roll');
                        
                        // Show quantity input for rolls, hide for sheets
                        if (isRoll) {
                            packingQuantitySection.classList.remove('d-none');
                            packingProcedureValueInput.value = '102'; // Roll ID
                        } else if (selectedText.includes('sheet')) {
                            packingQuantitySection.classList.add('d-none');
                            packingProcedureValueInput.value = '202'; // Sheet ID
                            // Clear quantity when switching to sheet
                            const packingQuantityInput = document.getElementById('packing-quantity');
                            if (packingQuantityInput) {
                                packingQuantityInput.value = '';
                            }
                        } else {
                            packingQuantitySection.classList.add('d-none');
                            packingProcedureValueInput.value = ''; // Unknown type
                        }
                    }
                    
                    // Rebuild options to remove "Select a packing procedure" after selection
                    if (selectedValue && selectedValue !== '') {
                        // Get current items from the select element
                        const currentItems = Array.from(packingProcedureSelect.options)
                            .filter(opt => opt.value !== '')
                            .map(opt => ({
                                Descriptions: [{ Description: opt.textContent }]
                            }));
                        rebuildOptions(currentItems);
                    }
                });

                _apiLoaders.push(loadPackingProcedures);

                // Initialize packing quantity visibility on page load
                setTimeout(() => {
                    const initialValue = packingProcedureSelect.value || savedValue;
                    if (initialValue) {
                        const packingQuantitySection = document.getElementById('packing-quantity-section');
                        const packingProcedureValueInput = document.getElementById('packing-procedure-value');
                        
                        if (packingQuantitySection && packingProcedureValueInput) {
                            const selectedText = initialValue.toLowerCase();
                            const isRoll = selectedText.includes('roll');
                            
                            if (isRoll) {
                                packingQuantitySection.classList.remove('d-none');
                                if (!packingProcedureValueInput.value) {
                                    packingProcedureValueInput.value = '102';
                                }
                            } else if (selectedText.includes('sheet')) {
                                if (!packingProcedureValueInput.value) {
                                    packingProcedureValueInput.value = '202';
                                }
                            }
                        }
                    }
                }, 100);
            })();

            // Fire API loaders sequentially: Material -> Printing -> Finish -> Packing.
            // First call acquires and caches the OAuth token; subsequent calls hit the cache.
            (async function runApiLoadersSequentially() {
                for (const loader of _apiLoaders) {
                    await loader();
                }
            })();

            // Custom Combobox Class
            class Combobox {
                constructor(element, options = []) {
                    this.element = element;
                    this.input = element.querySelector('.custom-combobox-input');
                    this.dropdown = element.querySelector('.custom-combobox-dropdown');
                    this.arrow = element.querySelector('.custom-combobox-arrow');
                    this.options = options;
                    this.filteredOptions = [...options];
                    this.highlightedIndex = -1;
                    this.isOpen = false;

                    this.init();
                }

                init() {
                    this.input.addEventListener('click', () => this.open());
                    this.input.addEventListener('input', (e) => this.handleInput(e));
                    this.input.addEventListener('keydown', (e) => this.handleKeydown(e));
                    this.input.addEventListener('blur', () => this.handleBlur());

                    this.arrow.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        if (this.isOpen) {
                            this.close();
                        } else {
                            this.open();
                        }
                    });

                    this.renderOptions();
                }

                setOptions(options) {
                    this.options = options;
                    this.filteredOptions = [...options];
                    if (this.isOpen) {
                        this.renderOptions();
                    }
                }

                open() {
                    this.isOpen = true;
                    this.element.classList.add('open');
                    this.filteredOptions = [...this.options];
                    this.renderOptions();
                    this.highlightedIndex = -1;
                }

                close() {
                    this.isOpen = false;
                    this.element.classList.remove('open');
                    this.highlightedIndex = -1;
                }

                handleInput(e) {
                    const value = e.target.value.trim();

                    if (!this.isOpen) {
                        this.open();
                    }

                    // Smart filtering: show close matches and values that start with the input
                    const numValue = parseFloat(value);
                    const isValidNumber = !isNaN(numValue) && value !== '';

                    if (isValidNumber) {
                        // Show values close to the entered number and values that start with the input
                        const tolerance = 0.5; // Show values within ±0.5 inches

                        this.filteredOptions = this.options
                            .map(option => {
                                const optionNum = parseFloat(option);
                                const startsWithInput = option.startsWith(value);
                                const isCloseMatch = !isNaN(optionNum) && Math.abs(optionNum - numValue) <= tolerance;

                                // Calculate distance for sorting
                                let distance = Infinity;
                                if (!isNaN(optionNum)) {
                                    distance = Math.abs(optionNum - numValue);
                                }

                                return {
                                    value: option,
                                    distance,
                                    startsWithInput,
                                    isCloseMatch
                                };
                            })
                            .filter(item => item.isCloseMatch || item.startsWithInput)
                            .sort((a, b) => {
                                // Prioritize close matches, then sort by distance
                                if (a.isCloseMatch && !b.isCloseMatch) return -1;
                                if (!a.isCloseMatch && b.isCloseMatch) return 1;
                                return a.distance - b.distance;
                            })
                            .slice(0, 10) // Limit to 10 results
                            .map(item => item.value);
                    } else if (value !== '') {
                        // Text-based filtering for non-numeric input
                        this.filteredOptions = this.options
                            .filter(option => option.toLowerCase().includes(value.toLowerCase()))
                            .slice(0, 10);
                    } else {
                        // Show all options if input is empty
                        this.filteredOptions = [...this.options];
                    }

                    this.renderOptions();
                    this.highlightedIndex = -1;

                    // Dispatch custom input event for die size sync
                    this.input.dispatchEvent(new CustomEvent('combobox-input', {
                        detail: { value: e.target.value }
                    }));
                }

                handleKeydown(e) {
                    if (!this.isOpen && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
                        e.preventDefault();
                        this.open();
                        return;
                    }

                    if (!this.isOpen) return;

                    switch(e.key) {
                        case 'ArrowDown':
                            e.preventDefault();
                            this.highlightNext();
                            break;
                        case 'ArrowUp':
                            e.preventDefault();
                            this.highlightPrevious();
                            break;
                        case 'Enter':
                            e.preventDefault();
                            if (this.highlightedIndex >= 0) {
                                this.selectOption(this.filteredOptions[this.highlightedIndex]);
                            }
                            break;
                        case 'Escape':
                            e.preventDefault();
                            this.close();
                            break;
                    }
                }

                handleBlur() {
                    setTimeout(() => {
                        this.close();
                    }, 200);
                }

                highlightNext() {
                    if (this.filteredOptions.length === 0) return;

                    this.highlightedIndex = Math.min(
                        this.highlightedIndex + 1, 
                        this.filteredOptions.length - 1
                    );
                    this.updateHighlight();
                    this.scrollToHighlighted();
                }

                highlightPrevious() {
                    if (this.filteredOptions.length === 0) return;

                    this.highlightedIndex = Math.max(this.highlightedIndex - 1, 0);
                    this.updateHighlight();
                    this.scrollToHighlighted();
                }

                updateHighlight() {
                    const items = this.dropdown.querySelectorAll('.custom-combobox-option:not(.no-results)');
                    items.forEach((item, index) => {
                        if (index === this.highlightedIndex) {
                            item.classList.add('highlighted');
                        } else {
                            item.classList.remove('highlighted');
                        }
                    });
                }

                scrollToHighlighted() {
                    const highlighted = this.dropdown.querySelector('.highlighted');
                    if (highlighted) {
                        highlighted.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                }

                selectOption(value) {
                    this.input.value = value;
                    this.close();

                    this.input.dispatchEvent(new CustomEvent('combobox-select', { 
                        detail: { value },
                        bubbles: true
                    }));
                }

                renderOptions() {
                    this.dropdown.innerHTML = '';

                    if (this.filteredOptions.length === 0) {
                        const li = document.createElement('li');
                        li.className = 'custom-combobox-option no-results';
                        li.textContent = 'No matches found';
                        this.dropdown.appendChild(li);
                        return;
                    }

                    this.filteredOptions.forEach((option, index) => {
                        const li = document.createElement('li');
                        li.className = 'custom-combobox-option';
                        li.textContent = `${option}"`;

                        li.addEventListener('mousedown', (e) => {
                            e.preventDefault();
                        });

                        li.addEventListener('click', () => {
                            this.selectOption(option);
                        });

                        this.dropdown.appendChild(li);
                    });
                }
            }

            (function () {
                const dieSection = document.getElementById('existing-die-section');
                const dieSelect = document.getElementById('existing-die-select');
                const dieLoading = document.getElementById('die-loading');
                const dieError = document.getElementById('die-error');
                const printingInput = document.getElementById('printing-input');
                const widthInput = document.getElementById('label-width');
                const heightInput = document.getElementById('label-height');
                const widthComboboxEl = document.getElementById('width-combobox');
                const heightComboboxEl = document.getElementById('height-combobox');
                const radiusComboboxEl = document.getElementById('radius-combobox');
                const radiusSelect = document.getElementById('label-radius');
                const radiusInput = radiusSelect; // Alias for consistency with clearRadiusOptions

                if (!dieSection || !dieSelect || !dieLoading || !dieError || !printingInput || 
                    !widthInput || !heightInput || !radiusSelect || !widthComboboxEl || !heightComboboxEl || !radiusComboboxEl) {
                    return;
                }

                // Initialize comboboxes
                const widthCombobox = new Combobox(widthComboboxEl, []);
                const heightCombobox = new Combobox(heightComboboxEl, []);
                const radiusCombobox = new Combobox(radiusComboboxEl, []);

                let dieOptionsCache = [];
                let cachedPrintingKey = null;
                let suppressRadiusSync = false;
                let suppressDimensionSync = false;
                let radiusInitialValue = (radiusSelect.dataset.initialValue || '').trim();
                let widthInitialValue = (widthInput.dataset.initialValue || '').trim();
                let heightInitialValue = (heightInput.dataset.initialValue || '').trim();
                const widthToHeights = new Map();
                const heightToWidths = new Map();
                const dimensionMap = new Map();
                const customDieWarning = document.getElementById('custom-die-warning');
                const customDimensionsSpan = document.getElementById('custom-dimensions');
                const customDieWarningRadius = document.getElementById('custom-die-warning-radius');
                const customRadiusSpan = document.getElementById('custom-radius');

                function formatDimension(value) {
                    const num = Number(value);
                    if (!Number.isFinite(num)) {
                        return '';
                    }
                    return (Math.round(num * 1000) / 1000).toString();
                }

                function checkCustomDieWarning() {
                    const widthValue = widthInput.value.trim();
                    const heightValue = heightInput.value.trim();
                    const isCustomDieInput = document.getElementById('is-custom-die');
                    const dieSizeInfoInput = document.getElementById('die-size-info');

                    // Only show warning if both dimensions are entered
                    if (!widthValue || !heightValue) {
                        customDieWarning?.classList.add('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        return;
                    }

                    // Square corners are standard cut — any dimension is valid, no custom die needed
                    const cornersInput = document.getElementById('corners-input');
                    if ((cornersInput?.value || '').toLowerCase() === 'square') {
                        customDieWarning?.classList.add('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = `${widthValue}" × ${heightValue}"`;
                        return;
                    }

                    // Check if this combination exists in our die sizes
                    const key = `${widthValue}|${heightValue}`;
                    const hasMatchingDie = dimensionMap.has(key);
                    const dieSizeInfo = `${widthValue}" × ${heightValue}"`;

                    // ALWAYS update hidden fields with current dimensions
                    if (dieSizeInfoInput) {
                        dieSizeInfoInput.value = dieSizeInfo;
                    }

                    if (!hasMatchingDie && customDieWarning && customDimensionsSpan) {
                        // Show custom die warning
                        customDimensionsSpan.textContent = dieSizeInfo;
                        customDieWarning.classList.remove('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'true';
                    } else {
                        // Hide warning if dimensions match a die, but still capture the size
                        customDieWarning?.classList.add('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                    }
                }

                function checkCustomDieWarningRadius() {
                    const radiusValue = radiusInput.value.trim();

                    if (!radiusValue) {
                        customDieWarningRadius?.classList.add('d-none');
                        return;
                    }

                    // Check if this radius exists in our die sizes
                    const hasMatchingDie = dieOptionsCache.some(option => {
                        const dieRadius = formatDimension(option.Radius__ ?? option.radius__ ?? '');
                        return dieRadius === radiusValue;
                    });

                    if (!hasMatchingDie && customDieWarningRadius && customRadiusSpan) {
                        customRadiusSpan.textContent = `${radiusValue}"`;
                        customDieWarningRadius.classList.remove('d-none');
                    } else {
                        customDieWarningRadius?.classList.add('d-none');
                    }
                }

                function clearWidthOptions(preserveValue = false) {
                    const currentValue = preserveValue ? widthInput.value : '';
                    widthCombobox.setOptions([]);
                    suppressDimensionSync = true;
                    widthInput.value = currentValue;
                    suppressDimensionSync = false;
                }

                function clearHeightOptions(preserveValue = false) {
                    const currentValue = preserveValue ? heightInput.value : '';
                    heightCombobox.setOptions([]);
                    suppressDimensionSync = true;
                    heightInput.value = currentValue;
                    suppressDimensionSync = false;
                }

                function clearRadiusOptions(preserveValue = false) {
                    const currentValue = preserveValue ? radiusInput.value : '';
                    radiusCombobox.setOptions([]);
                    suppressRadiusSync = true;
                    radiusInput.value = currentValue;
                    suppressRadiusSync = false;
                    if (!preserveValue) {
                        customDieWarningRadius?.classList.add('d-none');
                    }
                }

                function clearDimensions() {
                    suppressDimensionSync = true;
                    widthInput.value = '';
                    heightInput.value = '';
                    suppressDimensionSync = false;
                    suppressRadiusSync = true;
                    radiusSelect.value = '';
                    suppressRadiusSync = false;
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                }

                function selectDieByDimensions(widthValue, heightValue) {
                    const key = `${widthValue}|${heightValue}`;
                    const match = dimensionMap.get(key);
                    if (!match) {
                        return false;
                    }
                    if (dieSelect.value !== match.dieValue) {
                        dieSelect.value = match.dieValue;
                    }
                    return true;
                }

                function syncRadiusSelection(radiusValue) {
                    if (!radiusInput) {
                        return;
                    }
                    suppressRadiusSync = true;
                    radiusInput.value = radiusValue || '';
                    suppressRadiusSync = false;
                }

                function syncDimensionsFromDie() {
                    const option = dieSelect.selectedOptions[0];
                    if (!option || !option.value) {
                        // No die selected - don't clear user values, just exit
                        // Users should be able to enter custom dimensions without selecting a die
                        return;
                    }

                    const widthValue = formatDimension(option.dataset.width);
                    const heightValue = formatDimension(option.dataset.height);
                    suppressDimensionSync = true;

                    // Simply set the values - datalist will show suggestions
                    if (widthValue) {
                        widthInput.value = widthValue;
                    }
                    if (heightValue) {
                        heightInput.value = heightValue;
                    }

                    suppressDimensionSync = false;
                    const radiusValue = formatDimension(option.dataset.radius);
                    syncRadiusSelection(radiusValue);

                    // Update die size info (should not be custom since we selected from die list)
                    checkCustomDieWarning();
                    checkCustomDieWarningRadius();

                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                }

                function rebuildWidthHeightOptions() {
                    // Preserve current values before clearing
                    const currentWidth = widthInput.value.trim();
                    const currentHeight = heightInput.value.trim();

                    // Clear options but preserve the values
                    clearWidthOptions(true);
                    clearHeightOptions(true);
                    dimensionMap.clear();
                    widthToHeights.clear();
                    heightToWidths.clear();

                    dieOptionsCache.forEach(option => {
                        const ref = option.StnsRef || option.stnsRef || '';
                        const widthValue = formatDimension(option.etiket_b ?? option.etiket_B ?? '');
                        const heightValue = formatDimension(option.etiket_h ?? option.etiket_H ?? '');
                        if (!ref || !widthValue || !heightValue) {
                            return;
                        }
                        const key = `${widthValue}|${heightValue}`;
                        if (!dimensionMap.has(key)) {
                            dimensionMap.set(key, {
                                dieValue: ref,
                                width: widthValue,
                                height: heightValue,
                                radius: formatDimension(option.Radius__ ?? option.radius__ ?? '')
                            });
                        }
                        if (!widthToHeights.has(widthValue)) {
                            widthToHeights.set(widthValue, new Set());
                        }
                        widthToHeights.get(widthValue).add(heightValue);
                        if (!heightToWidths.has(heightValue)) {
                            heightToWidths.set(heightValue, new Set());
                        }
                        heightToWidths.get(heightValue).add(widthValue);
                    });

                    if (!widthToHeights.size) {
                        // No options available - values already preserved by clearWidthOptions/clearHeightOptions
                        return;
                    }

                    // Populate comboboxes with available die sizes
                    const sortedWidths = Array.from(widthToHeights.keys()).sort((a, b) => parseFloat(a) - parseFloat(b));
                    widthCombobox.setOptions(sortedWidths);

                    const sortedHeights = Array.from(heightToWidths.keys()).sort((a, b) => parseFloat(a) - parseFloat(b));
                    heightCombobox.setOptions(sortedHeights);

                    // Values are already preserved, but ensure they're still there after setOptions
                    // Only restore if they were cleared by setOptions
                    if (!widthInput.value && currentWidth) {
                        widthInput.value = currentWidth;
                    }
                    if (!heightInput.value && currentHeight) {
                        heightInput.value = currentHeight;
                    }
                }

                function rebuildRadiusOptions() {
                    // Preserve current value before clearing
                    const currentRadius = radiusInput.value.trim();

                    // Clear options but preserve the value
                    clearRadiusOptions(true);
                    const radiusMap = new Map();
                    dieOptionsCache.forEach(option => {
                        const radiusRaw = option.Radius__ ?? option.radius__ ?? option.radius ?? '';
                        const ref = option.StnsRef || option.stnsRef || '';
                        if (!radiusRaw || !ref) {
                            return;
                        }
                        const radiusValue = formatDimension(radiusRaw);
                        if (!radiusValue) {
                            return;
                        }
                        if (!radiusMap.has(radiusValue)) {
                            radiusMap.set(radiusValue, { dieValue: ref });
                        }
                    });

                    if (radiusMap.size === 0) {
                        // No options available - value already preserved by clearRadiusOptions
                        return;
                    }

                    // Populate combobox with available radius values
                    const sortedRadii = Array.from(radiusMap.keys())
                        .sort((a, b) => parseFloat(a) - parseFloat(b));

                    radiusCombobox.setOptions(sortedRadii);

                    // Value is already preserved, but ensure it's still there after setOptions
                    if (!radiusInput.value && currentRadius) {
                        radiusInput.value = currentRadius;
                    }
                }

                function clearDieOptions(message = 'Select a die size') {
                    dieSelect.innerHTML = `<option value="">${message}</option>`;
                    clearRadiusOptions(false); // Clear radius since it's tied to die selection
                    // Don't call clearDimensions() - preserve user-entered width/height values
                    // Users should be able to keep their custom dimensions even when die options aren't available
                }

                function rebuildDieOptions() {
                    dieSelect.innerHTML = '<option value="">Select a die size</option>';
                    if (!dieOptionsCache.length) {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No die sizes available';
                        option.disabled = true;
                        option.selected = true;
                        dieSelect.appendChild(option);

                        // Don't clear dimensions when no die sizes available - user may have custom values
                        // Just rebuild the options without any suggestions
                        rebuildWidthHeightOptions();
                        rebuildRadiusOptions();
                        return;
                    }

                    dieOptionsCache.forEach(option => {
                        const dieOption = document.createElement('option');
                        const ref = option.StnsRef || option.stnsRef || '';
                        const description = option.StnsOms || option.stnsOms || ref || 'Unnamed Die';
                        const across = option.etiket_b ?? option.etiket_B ?? '';
                        const around = option.etiket_h ?? option.etiket_H ?? '';
                        const radius = option.Radius__ ?? option.radius__ ?? '';
                        dieOption.value = ref;
                        dieOption.textContent = description;
                        if (across || around) {
                            dieOption.textContent += ` (${across}" x ${around}")`;
                        }
                        if (radius) {
                            dieOption.textContent += ` • Radius ${radius}"`;
                        }
                        if (across) dieOption.dataset.width = across;
                        if (around) dieOption.dataset.height = around;
                        if (radius) dieOption.dataset.radius = radius;
                        dieSelect.appendChild(dieOption);
                    });

                    rebuildWidthHeightOptions();
                    rebuildRadiusOptions();

                    // Only sync dimensions if user has selected an initial die
                    // or if we can match their entered dimensions to a die
                    if (widthInitialValue && heightInitialValue) {
                        selectDieByDimensions(widthInitialValue, heightInitialValue);
                        syncDimensionsFromDie();
                        widthInitialValue = '';
                        heightInitialValue = '';
                    } else if (dieSelect.value) {
                        // Die is already selected, sync its dimensions
                        syncDimensionsFromDie();
                    }
                    // If no die is selected, DON'T call syncDimensionsFromDie() as it would clear user values
                }

                async function loadDieOptions({ suppressErrors = false } = {}) {
                    const printingSelection = (printingInput.value || '').trim();
                    if (!printingSelection) {
                        if (!suppressErrors) {
                            dieError.textContent = 'Select a printing option to see die sizes.';
                            dieError.classList.remove('d-none');
                        } else {
                            dieError.classList.add('d-none');
                        }
                        clearDieOptions('Select a printing option to see die sizes');
                        return;
                    }

                    if (cachedPrintingKey === printingSelection && dieOptionsCache.length) {
                        rebuildDieOptions();
                        return;
                    }

                    dieLoading.classList.remove('d-none');
                    dieError.classList.add('d-none');

                    try {
                        const response = await fetch(`/Api/CuttingDie?printing=${encodeURIComponent(printingSelection)}`, {
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!response.ok) {
                            const errorPayload = await response.json().catch(() => ({ }));
                            throw new Error(errorPayload.error || `Unable to load die sizes (${response.status})`);
                        }

                        const payload = await response.json();
                        dieOptionsCache = payload.cuttingDieOptions || payload.data || payload.items || payload.results || [];
                        cachedPrintingKey = printingSelection;
                        rebuildDieOptions();
                    } catch (error) {
                        console.error('Failed to load die sizes', error);
                        dieError.textContent = error.message || 'Unable to load die sizes right now.';
                        dieError.classList.remove('d-none');
                        clearDieOptions('Unable to load die sizes');
                    } finally {
                        dieLoading.classList.add('d-none');
                    }
                }

                dieSelect.addEventListener('change', () => {
                    syncDimensionsFromDie();
                });

                // Radius input handling
                radiusInput.addEventListener('input', () => {
                    if (suppressRadiusSync) {
                        return;
                    }
                    checkCustomDieWarningRadius();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                // Use combobox-select event for radius selection from dropdown
                radiusInput.addEventListener('combobox-select', (e) => {
                    if (suppressRadiusSync) return;
                    checkCustomDieWarningRadius();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                widthInput.addEventListener('input', () => {
                    if (suppressDimensionSync) {
                        return;
                    }
                    const widthValue = widthInput.value.trim();

                    if (!widthValue) {
                        dieSelect.value = '';
                        customDieWarning?.classList.add('d-none');
                        // Clear hidden fields
                        const isCustomDieInput = document.getElementById('is-custom-die');
                        const dieSizeInfoInput = document.getElementById('die-size-info');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        if (typeof validateLabelSize === 'function') validateLabelSize();
                        if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                        return;
                    }

                    // Check if this matches a die size with the current height
                    const heightValue = heightInput.value.trim();
                    if (heightValue && selectDieByDimensions(widthValue, heightValue)) {
                        syncDimensionsFromDie();
                        return;
                    }

                    // Custom value or no match - check and update warning
                    dieSelect.value = '';
                    checkCustomDieWarning();
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                heightInput.addEventListener('input', () => {
                    if (suppressDimensionSync) {
                        return;
                    }
                    const heightValue = heightInput.value.trim();

                    if (!heightValue) {
                        dieSelect.value = '';
                        customDieWarning?.classList.add('d-none');
                        // Clear hidden fields
                        const isCustomDieInput = document.getElementById('is-custom-die');
                        const dieSizeInfoInput = document.getElementById('die-size-info');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        if (typeof validateLabelSize === 'function') validateLabelSize();
                        if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                        return;
                    }

                    // Check if this matches a die size with the current width
                    const widthValue = widthInput.value.trim();
                    if (widthValue && selectDieByDimensions(widthValue, heightValue)) {
                        syncDimensionsFromDie();
                        return;
                    }

                    // Custom value or no match - check and update warning
                    dieSelect.value = '';
                    checkCustomDieWarning();
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                // Use combobox-select event for die size selection
                widthInput.addEventListener('combobox-select', (e) => {
                    if (suppressDimensionSync) return;

                    const widthValue = e.detail.value;
                    const heightValue = heightInput.value.trim();

                    if (heightValue && selectDieByDimensions(widthValue, heightValue)) {
                        syncDimensionsFromDie();
                    }

                    checkCustomDieWarning();
                });

                heightInput.addEventListener('combobox-select', (e) => {
                    if (suppressDimensionSync) return;

                    const heightValue = e.detail.value;
                    const widthValue = widthInput.value.trim();

                    if (widthValue && selectDieByDimensions(widthValue, heightValue)) {
                        syncDimensionsFromDie();
                    }

                    checkCustomDieWarning();
                });

                window.addEventListener('cornerSelectionChanged', () => {
                    checkCustomDieWarning();
                });

                window.addEventListener('printingSelectionChanged', () => {
                    cachedPrintingKey = null;
                    dieOptionsCache = [];
                    loadDieOptions({ suppressErrors: true });
                });

                if ((printingInput.value || '').trim()) {
                    loadDieOptions({ suppressErrors: true });
                } else {
                    clearDieOptions('Select a printing option to see die sizes');
                }
            })();

            (function () {
                const addButton = document.getElementById('add-quantity');
                const rows = Array.from(document.querySelectorAll('#quantity-list .quantity-row'));
                const quantitiesSection = document.getElementById('quantities-section');
                const quantitiesWarningAlert = document.getElementById('quantities-warning-alert');

                if (!addButton || !rows.length) {
                    return;
                }

                function checkQuantitiesAttention() {
                    // Check if we're from a saved quote
                    const savedQuoteElement = document.getElementById('saved-quote-data');
                    if (!savedQuoteElement || !quantitiesSection) {
                        return;
                    }

                    // Check if any quantity input has a value
                    const hasAnyQuantity = rows.some(row => {
                        const input = row.querySelector('input[name="quantity"]');
                        return input && input.value && input.value.trim() !== '';
                    });

                    if (!hasAnyQuantity) {
                        quantitiesSection.classList.add('needs-attention');
                        if (quantitiesWarningAlert) {
                            quantitiesWarningAlert.classList.remove('d-none');
                        }
                    } else {
                        quantitiesSection.classList.remove('needs-attention');
                        if (quantitiesWarningAlert) {
                            quantitiesWarningAlert.classList.add('d-none');
                        }
                    }
                }

                function updateAddState() {
                    const hasHidden = rows.some(row => row.classList.contains('d-none'));
                    addButton.disabled = !hasHidden;
                }

                function showNextRow() {
                    const next = rows.find(row => row.classList.contains('d-none'));
                    if (next) {
                        next.classList.remove('d-none');
                    }
                }

                addButton.addEventListener('click', () => {
                    showNextRow();
                    updateAddState();
                    // Adding a row is a user action, remove highlighting
                    if (quantitiesSection) {
                        quantitiesSection.classList.remove('needs-attention');
                        if (quantitiesWarningAlert) {
                            quantitiesWarningAlert.classList.add('d-none');
                        }
                    }
                });

                rows.forEach(row => {
                    const removeBtn = row.querySelector('.remove-quantity');
                    const input = row.querySelector('input[name="quantity"]');
                    if (!input) {
                        return;
                    }

                    // Remove highlighting immediately when any value is entered
                    input.addEventListener('input', () => {
                        if (input.value) {
                            quantitiesSection?.classList.remove('needs-attention');
                            quantitiesWarningAlert?.classList.add('d-none');
                        } else {
                            checkQuantitiesAttention();
                        }
                    });

                    input.addEventListener('change', () => {
                        checkQuantitiesAttention();
                    });

                    if (removeBtn) {
                        removeBtn.addEventListener('click', () => {
                            input.value = '';
                            row.classList.add('d-none');
                            updateAddState();
                            checkQuantitiesAttention(); // Re-check after removal
                        });
                    }
                });

                updateAddState();

                // Check initial state on page load
                checkQuantitiesAttention();
            })();
        </script>
            </div>
        </div>
    </main>

    <!-- AI Chat Assistant Popup Panel -->
    <div id="chat-assistant" class="chat-assistant-panel">
        <div class="chat-assistant-header">
