@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
<script>
    // Chat Assistant Functionality
    (function() {
        const chatPanel = document.getElementById('chat-assistant');
        const chatToggle = document.getElementById('chat-toggle');
        const chatClose = document.getElementById('chat-close');
        const chatMessages = document.getElementById('chat-messages');
        const chatInput = document.getElementById('chat-input');
        const chatSend = document.getElementById('chat-send');
        const chatClear = document.getElementById('chat-clear');

        if (!chatPanel || !chatToggle) return;

        // Configure marked
        marked.setOptions({ breaks: true, gfm: true });

        // Toggle chat panel
        chatToggle.addEventListener('click', () => {
            chatPanel.classList.add('open');
            chatToggle.classList.add('hidden');
            chatInput.focus();
        });

        chatClose.addEventListener('click', () => {
            chatPanel.classList.remove('open');
            chatToggle.classList.remove('hidden');
        });

        function appendMessage(text, role = 'user') {
            const bubble = document.createElement('div');
            bubble.className = `chat-message ${role}`;

            if (role === 'assistant') {
                const rawHtml = marked.parse(text);
                bubble.innerHTML = DOMPurify.sanitize(rawHtml);
            } else {
                bubble.textContent = text.trim();
            }

            chatMessages.appendChild(bubble);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return bubble;
        }

        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;

            appendMessage(message, 'user');
            chatInput.value = '';

            const assistantBubble = appendMessage('…', 'assistant');
            let rawResponse = '';

            try {
                const response = await fetch('/Api/ChatStream', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'text/event-stream'
                    },
                    body: JSON.stringify({ message: message })
                });

                if (!response.ok) {
                    throw new Error(`Server error: ${response.status}`);
                }

                const reader = response.body?.getReader();
                if (!reader) throw new Error('Response body not available');

                const decoder = new TextDecoder();
                let buffer = '';
                let quoteData = null;
                let chunkCount = 0;

                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n\n');
                    buffer = lines.pop() || '';

                    for (const line of lines) {
                        if (!line.trim() || !line.startsWith('data: ')) continue;

                        try {
                            const jsonStr = line.substring(6);
                            const data = JSON.parse(jsonStr);

                            console.log('SSE chunk received:', data);
                            chunkCount++;

                            if (data.content) {
                                rawResponse += data.content;
                            }

                            if (data.quoteData && data.quoteData !== null) {
                                quoteData = data.quoteData;
                            }

                            if (data.done) break;
                        } catch (err) {
                            console.warn('Parse error:', err, 'Line:', line);
                        }
                    }
                }

                console.log(`Received ${chunkCount} chunks, total length: ${rawResponse.length}`);
                console.log('Complete response:', rawResponse);

                // The server has already parsed and extracted the message
                // rawResponse contains the plain text message, not JSON
                let displayMessage = rawResponse;

                if (!rawResponse || rawResponse.trim().length === 0) {
                    displayMessage = '?? The AI returned an empty response. This might mean:\n\n' +
                        '- Ollama is not running\n' +
                        '- The model is not loaded\n' +
                        '- There was a server error\n\n' +
                        'Please check the server logs and make sure Ollama is running.';
                }
                // No JSON parsing needed - server already did that!

                const rawHtml = marked.parse(displayMessage || 'No response');
                assistantBubble.innerHTML = DOMPurify.sanitize(rawHtml);

                // Populate form if quote data extracted
                if (quoteData) {
                    populateQuoteForm(quoteData);

                    const notification = document.createElement('div');
                    notification.className = 'chat-message assistant';
                    notification.innerHTML = '<strong>? Form Updated!</strong><br>I\'ve filled in the quote form with the details you provided. Please review and adjust as needed.';
                    chatMessages.appendChild(notification);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }

            } catch (error) {
                assistantBubble.textContent = `Error: ${error.message}`;
                assistantBubble.style.background = '#fee2e2';
                assistantBubble.style.color = '#991b1b';
            }
        }

        function populateQuoteForm(data) {
            console.log('Populating form with:', data);

            // Description - simple text field
            if (data.description) {
                const descField = document.getElementById('description');
                if (descField) {
                    descField.value = data.description;
                    console.log('? Set description:', data.description);
                }
            }

            // Shape - click the button
            if (data.shape) {
                const shapeBtn = document.querySelector(`[data-shape-key="${data.shape}"]`);
                if (shapeBtn) {
                    shapeBtn.click();
                    console.log('? Clicked shape:', data.shape);
                } else {
                    console.warn('? Shape button not found for:', data.shape);
                }
            }

            // Width - input field with datalist
            if (data.labelWidth) {
                const widthField = document.getElementById('label-width');
                if (widthField) {
                    widthField.value = data.labelWidth;
                    // Trigger input event to sync with die selection
                    widthField.dispatchEvent(new Event('input', { bubbles: true }));
                    console.log('? Set width:', data.labelWidth);
                } else {
                    console.warn('? Width field not found');
                }
            }

            // Height - input field with datalist
            if (data.labelHeight) {
                const heightField = document.getElementById('label-height');
                if (heightField) {
                    heightField.value = data.labelHeight;
                    // Trigger input event to sync with die selection
                    heightField.dispatchEvent(new Event('input', { bubbles: true }));
                    console.log('? Set height:', data.labelHeight);
                } else {
                    console.warn('? Height field not found');
                }
            }

            // Diameter/Radius - for circular labels
            if (data.diameter) {
                const diameterField = document.getElementById('label-radius');
                if (diameterField) {
                    // Check if option exists
                    const existingOption = Array.from(diameterField.options).find(opt => opt.value === data.diameter);

                    if (!existingOption) {
                        // Add the option
                        const newOption = document.createElement('option');
                        newOption.value = data.diameter;
                        newOption.textContent = `${data.diameter}"`;
                        diameterField.appendChild(newOption);
                        console.log('? Added diameter option:', data.diameter);
                    }

                    diameterField.value = data.diameter;
                    console.log('? Set diameter:', data.diameter);
                } else {
                    console.warn('? Diameter field not found');
                }
            }

            // Material - select dropdown, might need to wait for it to load
            if (data.material) {
                const materialField = document.getElementById('material-select');
                if (materialField) {
                    // Try to find matching option (case-insensitive)
                    const materialLower = data.material.toLowerCase();
                    const matchingOption = Array.from(materialField.options).find(opt => 
                        opt.textContent.toLowerCase().includes(materialLower) ||
                        opt.value.toLowerCase().includes(materialLower)
                    );

                    if (matchingOption) {
                        materialField.value = matchingOption.value;
                        materialField.dispatchEvent(new Event('change', { bubbles: true }));
                        console.log('? Set material:', matchingOption.textContent);
                    } else {
                        console.warn('? Material not found in dropdown:', data.material);
                        console.log('Available materials:', Array.from(materialField.options).map(o => o.textContent));
                    }
                } else {
                    console.warn('? Material field not found');
                }
            }

            // Total Quantity - first quantity input
            if (data.totalQuantity) {
                const qtyField = document.querySelector('input[name="quantity"]');
                if (qtyField) {
                    qtyField.value = data.totalQuantity;
                    console.log('? Set quantity:', data.totalQuantity);
                } else {
                    console.warn('? Quantity field not found');
                }
            }

            // Scroll to top of form to show updates
            setTimeout(() => {
                const descField = document.getElementById('description');
                if (descField) {
                    descField.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 500);
        }

        chatSend.addEventListener('click', sendMessage);
        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        chatClear.addEventListener('click', async () => {
            try {
                await fetch('/Api/ChatStream?handler=Reset', { method: 'POST' });
                chatMessages.innerHTML = '<div class="chat-message assistant">Conversation cleared. How can I help with your next label project?</div>';
            } catch (err) {
                console.error('Failed to reset:', err);
            }
        });
    })();

    // Initialize form with saved quote data when available
    (function() {
        const savedQuoteElement = document.getElementById('saved-quote-data');
        if (!savedQuoteElement) {
            return;
        }

        let savedQuote = null;
        try {
            savedQuote = JSON.parse(savedQuoteElement.textContent);
        } catch (error) {
            console.error('Failed to parse saved quote data:', error);
            return;
        }

        if (!savedQuote) {
            return;
        }

        console.log('Initializing form with saved quote:', savedQuote);

        // Helper function to wait for dropdown options to be populated
        function waitForDropdownOptions(selectElement, maxWaitMs = 5000) {
            return new Promise((resolve) => {
                const startTime = Date.now();
                const checkInterval = setInterval(() => {
                    if (selectElement.options.length > 1 || Date.now() - startTime > maxWaitMs) {
                        clearInterval(checkInterval);
                        resolve();
                    }
                }, 100);
            });
        }

        // Helper function to select printing by ID
        async function selectPrintingById(printingValueId, printingLabel) {
            const printingFilter = document.getElementById('printing-filter');
            if (!printingFilter) return;

            // Wait for printing buttons to be loaded
            await new Promise(resolve => {
                const checkInterval = setInterval(() => {
                    const buttons = printingFilter.querySelectorAll('button');
                    if (buttons.length > 0) {
                        clearInterval(checkInterval);
                        resolve();
                    }
                }, 100);
                setTimeout(resolve, 5000); // Timeout after 5 seconds
            });

            // Try to find button by ID first, then by label
            const buttons = Array.from(printingFilter.querySelectorAll('button'));
            let matchingButton = buttons.find(btn => btn.getAttribute('data-printing-id') === printingValueId);

            if (!matchingButton && printingLabel) {
                matchingButton = buttons.find(btn => 
                    btn.getAttribute('data-printing-text')?.toLowerCase() === printingLabel.toLowerCase()
                );
            }

            if (matchingButton) {
                matchingButton.click();
                console.log('? Selected printing option:', printingValueId || printingLabel);
            } else {
                console.warn('? Printing option not found:', printingValueId, printingLabel);
            }
        }

        // Helper function to select finish by ID or label
        async function selectFinishById(finishValue, finishLabel) {
            const finishSelect = document.getElementById('finish-select');
            if (!finishSelect) return;

            // Wait for finish options to be loaded
            await waitForDropdownOptions(finishSelect);

            const normalizedValue = (finishValue || '').toLowerCase();
            const normalizedLabel = (finishLabel || '').toLowerCase();

            // Try to match by value or label
            const matchingOption = Array.from(finishSelect.options).find(opt => 
                opt.value.toLowerCase() === normalizedValue ||
                opt.value.toLowerCase() === normalizedLabel ||
                opt.textContent.toLowerCase() === normalizedLabel
            );

            if (matchingOption) {
                finishSelect.value = matchingOption.value;
                finishSelect.dispatchEvent(new Event('change', { bubbles: true }));
                console.log('? Selected finish:', matchingOption.value);
            } else {
                console.warn('? Finish not found:', finishValue, finishLabel);
            }
        }

        // Helper function to select packing procedure
        async function selectPackingProcedure(packingValue) {
            if (!packingValue) return;

            const packingSelect = document.getElementById('packing-procedure-select');
            if (!packingSelect) return;

            // Wait for packing options to be loaded
            await waitForDropdownOptions(packingSelect);

            const normalizedValue = packingValue.toLowerCase();
            const matchingOption = Array.from(packingSelect.options).find(opt => 
                opt.value.toLowerCase() === normalizedValue ||
                opt.textContent.toLowerCase().includes(normalizedValue)
            );

            if (matchingOption) {
                packingSelect.value = matchingOption.value;
                packingSelect.dispatchEvent(new Event('change', { bubbles: true }));
                console.log('? Selected packing procedure:', matchingOption.value);
            } else {
                console.warn('? Packing procedure not found:', packingValue);
            }
        }

        // Helper function to populate quantities
        function populateQuantities(quantities) {
            if (!quantities || !Array.isArray(quantities) || quantities.length === 0) {
                return;
            }

            const quantityInputs = document.querySelectorAll('input[name="quantity"]');
            quantities.forEach((qty, index) => {
                if (index < quantityInputs.length) {
                    const input = quantityInputs[index];
                    const row = input.closest('.quantity-row');

                    input.value = qty;

                    // Show the row if it's hidden
                    if (row && row.classList.contains('d-none')) {
                        row.classList.remove('d-none');
                    }

                    console.log(`? Set quantity ${index + 1}:`, qty);
                }
            });
        }

        // Initialize form fields asynchronously
        (async function() {
            // Populate material (wait for dropdown to load)
            if (savedQuote.MaterialValue || savedQuote.Material) {
                const materialSelect = document.getElementById('material-select');
                if (materialSelect) {
                    await waitForDropdownOptions(materialSelect);

                    const materialId = savedQuote.MaterialValue; // SubstrateId from CERM
                    const materialLabel = savedQuote.Material;   // Description from CERM (may be en-US or en-GB)

                    // Match by substrate ID (data-material-id attribute)
                    let matchingOption = null;
                    if (materialId) {
                        matchingOption = Array.from(materialSelect.options).find(opt => 
                            opt.dataset.materialId === materialId
                        );
                    }

                    // Fallback: match by option value
                    if (!matchingOption && materialId) {
                        matchingOption = Array.from(materialSelect.options).find(opt => 
                            opt.value === materialId
                        );
                    }

                    // Check both en-US and en-GB descriptions for text match
                    if (!matchingOption && materialLabel) {
                        const normalizedLabel = materialLabel.toLowerCase();
                        matchingOption = Array.from(materialSelect.options).find(opt => {
                            const usDescription = (opt.textContent || '').toLowerCase();
                            const gbDescription = (opt.dataset.gbDescription || '').toLowerCase();

                            // Check if saved label matches either en-US or en-GB description
                            return usDescription.includes(normalizedLabel) ||
                                   normalizedLabel.includes(usDescription) ||
                                   (gbDescription && gbDescription.includes(normalizedLabel)) ||
                                   (gbDescription && normalizedLabel.includes(gbDescription));
                        });
                    }

                    if (matchingOption) {
                        materialSelect.value = matchingOption.value;
                        materialSelect.dispatchEvent(new Event('change', { bubbles: true }));
                        console.log('? Material selected:', matchingOption.textContent);
                    } else {
                        console.warn('? Material not found - ID:', materialId, 'Label:', materialLabel);
                    }
                }
            }

            // Populate printing (ColorCodeId or Printing label)
            if (savedQuote.PrintingValue || savedQuote.Printing) {
                await selectPrintingById(savedQuote.PrintingValue, savedQuote.Printing);
            }

            // Populate finish (FinishingTypeId or Finish label)
            if (savedQuote.FinishValue || savedQuote.Finish) {
                await selectFinishById(savedQuote.FinishValue, savedQuote.Finish);
            }

            // Populate packing procedure
            if (savedQuote.PackingProcedure) {
                await selectPackingProcedure(savedQuote.PackingProcedure);
            }

            // Populate corners for rectangles
            if (savedQuote.Corners || savedQuote.CornersValue) {
                const cornersValue = savedQuote.CornersValue || savedQuote.Corners;
                const cornerButton = document.querySelector(`.corner-option[data-value="${cornersValue}"]`);
                if (cornerButton) {
                    cornerButton.click();
                    console.log('? Selected corners:', cornersValue);
                }
            }

            // Populate unwind direction
            if (savedQuote.UnwindDirectionValue || savedQuote.UnwindDirection) {
                // Prioritize the numeric ID (UnwindDirectionValue) as it's what CERM returns
                const savedUnwindValue = (savedQuote.UnwindDirectionValue || savedQuote.UnwindDirection || '').trim();
                // Try to find button by exact value match first
                let unwindButton = document.querySelector(`.unwind-option[data-value="${savedUnwindValue}"]`);

                // If not found, try to extract the ID from the beginning of the string (e.g., "1" from "1 - Head off first")
                if (!unwindButton) {
                    const idMatch = savedUnwindValue.match(/^(\d+)/);
                    if (idMatch) {
                        unwindButton = document.querySelector(`.unwind-option[data-value="${idMatch[1]}"]`);
                    }
                }

                // Last resort: try to find by label match
                if (!unwindButton) {
                    unwindButton = Array.from(document.querySelectorAll('.unwind-option')).find(btn =>
                        btn.dataset.label?.toLowerCase() === savedUnwindValue.toLowerCase()
                    );
                }

                if (unwindButton) {
                    unwindButton.click();
                    console.log('? Selected unwind direction:', savedUnwindValue);
                } else {
                    console.warn('? Unwind direction not found:', savedUnwindValue);
                }
            }

            // Populate quantities if available
            if (savedQuote.Quantities) {
                populateQuantities(savedQuote.Quantities);
            }

            console.log('? Form initialization complete');
        })();
    })();
</script>
}
