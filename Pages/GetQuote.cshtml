            // Custom Combobox Class
            class Combobox {
                constructor(element, options = []) {
                    this.element = element;
                    this.input = element.querySelector('.custom-combobox-input');
                    this.dropdown = element.querySelector('.custom-combobox-dropdown');
                    this.arrow = element.querySelector('.custom-combobox-arrow');
                    this.options = options;
                    this.filteredOptions = [...options];
                    this.highlightedIndex = -1;
                    this.isOpen = false;

                    this.init();
                }

                init() {
                    this.input.addEventListener('click', () => this.open());
                    this.input.addEventListener('input', (e) => this.handleInput(e));
                    this.input.addEventListener('keydown', (e) => this.handleKeydown(e));
                    this.input.addEventListener('blur', () => this.handleBlur());

                    this.arrow.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        if (this.isOpen) {
                            this.close();
                        } else {
                            this.open();
                        }
                    });

                    this.renderOptions();
                }

                setOptions(options) {
                    this.options = options;
                    this.filteredOptions = [...options];
                    if (this.isOpen) {
                        this.renderOptions();
                    }
                }

                open() {
                    this.isOpen = true;
                    this.element.classList.add('open');
                    this.filteredOptions = [...this.options];
                    this.renderOptions();
                    this.highlightedIndex = -1;
                }

                close() {
                    this.isOpen = false;
                    this.element.classList.remove('open');
                    this.highlightedIndex = -1;
                }

                handleInput(e) {
                    const value = e.target.value.trim().toLowerCase();

                    if (!this.isOpen) {
                        this.open();
                    }

                    this.filteredOptions = this.options.filter(option => 
                        option.toLowerCase().includes(value)
                    );

                    this.renderOptions();
                    this.highlightedIndex = -1;

                    // Dispatch custom input event for die size sync
                    this.input.dispatchEvent(new CustomEvent('combobox-input', {
                        detail: { value: e.target.value }
                    }));
                }

                handleKeydown(e) {
                    if (!this.isOpen && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
                        e.preventDefault();
                        this.open();
                        return;
                    }

                    if (!this.isOpen) return;

                    switch(e.key) {
                        case 'ArrowDown':
                            e.preventDefault();
                            this.highlightNext();
                            break;
                        case 'ArrowUp':
                            e.preventDefault();
                            this.highlightPrevious();
                            break;
                        case 'Enter':
                            e.preventDefault();
                            if (this.highlightedIndex >= 0) {
                                this.selectOption(this.filteredOptions[this.highlightedIndex]);
                            }
                            break;
                        case 'Escape':
                            e.preventDefault();
                            this.close();
                            break;
                    }
                }

                handleBlur() {
                    setTimeout(() => {
                        this.close();
                    }, 200);
                }

                highlightNext() {
                    if (this.filteredOptions.length === 0) return;

                    this.highlightedIndex = Math.min(
                        this.highlightedIndex + 1, 
                        this.filteredOptions.length - 1
                    );
                    this.updateHighlight();
                    this.scrollToHighlighted();
                }

                highlightPrevious() {
                    if (this.filteredOptions.length === 0) return;

                    this.highlightedIndex = Math.max(this.highlightedIndex - 1, 0);
                    this.updateHighlight();
                    this.scrollToHighlighted();
                }

                updateHighlight() {
                    const items = this.dropdown.querySelectorAll('.custom-combobox-option:not(.no-results)');
                    items.forEach((item, index) => {
                        if (index === this.highlightedIndex) {
                            item.classList.add('highlighted');
                        } else {
                            item.classList.remove('highlighted');
                        }
                    });
                }

                scrollToHighlighted() {
                    const highlighted = this.dropdown.querySelector('.highlighted');
                    if (highlighted) {
                        highlighted.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                }

                selectOption(value) {
                    this.input.value = value;
                    this.close();

                    this.input.dispatchEvent(new CustomEvent('combobox-select', { 
                        detail: { value },
                        bubbles: true
                    }));
                }

                renderOptions() {
                    this.dropdown.innerHTML = '';

                    if (this.filteredOptions.length === 0) {
                        const li = document.createElement('li');
                        li.className = 'custom-combobox-option no-results';
                        li.textContent = 'No matches found';
                        this.dropdown.appendChild(li);
                        return;
                    }

                    this.filteredOptions.forEach((option, index) => {
                        const li = document.createElement('li');
                        li.className = 'custom-combobox-option';
                        li.textContent = `${option}"`;

                        li.addEventListener('mousedown', (e) => {
                            e.preventDefault();
                        });

                        li.addEventListener('click', () => {
                            this.selectOption(option);
                        });

                        this.dropdown.appendChild(li);
                    });
                }
            }

            (function () {
                const dieSection = document.getElementById('existing-die-section');
                const dieSelect = document.getElementById('existing-die-select');
                const dieLoading = document.getElementById('die-loading');
                const dieError = document.getElementById('die-error');
                const printingInput = document.getElementById('printing-input');
                const widthInput = document.getElementById('label-width');
                const heightInput = document.getElementById('label-height');
                const widthComboboxEl = document.getElementById('width-combobox');
                const heightComboboxEl = document.getElementById('height-combobox');
                const radiusSelect = document.getElementById('label-radius');

                if (!dieSection || !dieSelect || !dieLoading || !dieError || !printingInput || 
                    !widthInput || !heightInput || !radiusSelect || !widthComboboxEl || !heightComboboxEl) {
                    return;
                }

                // Initialize comboboxes
                const widthCombobox = new Combobox(widthComboboxEl, []);
                const heightCombobox = new Combobox(heightComboboxEl, []);

                let dieOptionsCache = [];
                let cachedPrintingKey = null;
                let suppressRadiusSync = false;
                let suppressDimensionSync = false;
                let radiusInitialValue = (radiusSelect.dataset.initialValue || '').trim();
                let widthInitialValue = (widthInput.dataset.initialValue || '').trim();
                let heightInitialValue = (heightInput.dataset.initialValue || '').trim();
                const widthToHeights = new Map();
                const heightToWidths = new Map();
                const dimensionMap = new Map();
                const customDieWarning = document.getElementById('custom-die-warning');
                const customDimensionsSpan = document.getElementById('custom-dimensions');

                function formatDimension(value) {
                    const num = Number(value);
                    if (!Number.isFinite(num)) {
                        return '';
                    }
                    return (Math.round(num * 1000) / 1000).toString();
                }

                function checkCustomDieWarning() {
                    const widthValue = widthInput.value.trim();
                    const heightValue = heightInput.value.trim();
                    const isCustomDieInput = document.getElementById('is-custom-die');
                    const dieSizeInfoInput = document.getElementById('die-size-info');

                    // Only show warning if both dimensions are entered
                    if (!widthValue || !heightValue) {
                        customDieWarning?.classList.add('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        return;
                    }

                    // Check if this combination exists in our die sizes
                    const key = `${widthValue}|${heightValue}`;
                    const hasMatchingDie = dimensionMap.has(key);
                    const dieSizeInfo = `${widthValue}" × ${heightValue}"`;

                    // ALWAYS update hidden fields with current dimensions
                    if (dieSizeInfoInput) {
                        dieSizeInfoInput.value = dieSizeInfo;
                    }

                    if (!hasMatchingDie && customDieWarning && customDimensionsSpan) {
                        // Show custom die warning
                        customDimensionsSpan.textContent = dieSizeInfo;
                        customDieWarning.classList.remove('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'true';
                    } else {
                        // Hide warning if dimensions match a die, but still capture the size
                        customDieWarning?.classList.add('d-none');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                    }
                }

                function clearWidthOptions() {
                    widthCombobox.setOptions([]);
                    suppressDimensionSync = true;
                    widthInput.value = '';
                    suppressDimensionSync = false;
                }

                function clearHeightOptions() {
                    heightCombobox.setOptions([]);
                    suppressDimensionSync = true;
                    heightInput.value = '';
                    suppressDimensionSync = false;
                }

                function clearRadiusOptions(message = 'Select a radius') {
                    radiusSelect.innerHTML = `<option value="">${message}</option>`;
                    suppressRadiusSync = true;
                    radiusSelect.value = '';
                    suppressRadiusSync = false;
                }

                function clearDimensions() {
                    suppressDimensionSync = true;
                    widthInput.value = '';
                    heightInput.value = '';
                    suppressDimensionSync = false;
                    suppressRadiusSync = true;
                    radiusSelect.value = '';
                    suppressRadiusSync = false;
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                }

                function selectDieByDimensions(widthValue, heightValue) {
                    const key = `${widthValue}|${heightValue}`;
                    const match = dimensionMap.get(key);
                    if (!match) {
                        return false;
                    }
                    if (dieSelect.value !== match.dieValue) {
                        dieSelect.value = match.dieValue;
                    }
                    return true;
                }

                function syncRadiusSelection(dieValue, radiusValue) {
                    if (!radiusSelect) {
                        return;
                    }
                    suppressRadiusSync = true;
                    let matched = null;
                    if (dieValue) {
                        matched = Array.from(radiusSelect.options).find(opt => opt.dataset?.dieValue === dieValue);
                    }
                    if (!matched && radiusValue) {
                        matched = Array.from(radiusSelect.options).find(opt => opt.value === radiusValue);
                    }
                    radiusSelect.value = matched ? matched.value : '';
                    suppressRadiusSync = false;
                }

                function syncDimensionsFromDie() {
                    const option = dieSelect.selectedOptions[0];
                    if (!option || !option.value) {
                        clearDimensions();
                        return;
                    }

                    const widthValue = formatDimension(option.dataset.width);
                    const heightValue = formatDimension(option.dataset.height);
                    suppressDimensionSync = true;

                    // Simply set the values - datalist will show suggestions
                    if (widthValue) {
                        widthInput.value = widthValue;
                    }
                    if (heightValue) {
                        heightInput.value = heightValue;
                    }

                    suppressDimensionSync = false;
                    const radiusValue = formatDimension(option.dataset.radius);
                    syncRadiusSelection(option.value, radiusValue);

                    // Update die size info (should not be custom since we selected from die list)
                    checkCustomDieWarning();

                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof validateDiameter === 'function') validateDiameter();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                }

                function rebuildWidthHeightOptions() {
                    clearWidthOptions();
                    clearHeightOptions();
                    dimensionMap.clear();
                    widthToHeights.clear();
                    heightToWidths.clear();

                    dieOptionsCache.forEach(option => {
                        const ref = option.StnsRef || option.stnsRef || '';
                        const widthValue = formatDimension(option.etiket_b ?? option.etiket_B ?? '');
                        const heightValue = formatDimension(option.etiket_h ?? option.etiket_H ?? '');
                        if (!ref || !widthValue || !heightValue) {
                            return;
                        }
                        const key = `${widthValue}|${heightValue}`;
                        if (!dimensionMap.has(key)) {
                            dimensionMap.set(key, {
                                dieValue: ref,
                                width: widthValue,
                                height: heightValue,
                                radius: formatDimension(option.Radius__ ?? option.radius__ ?? '')
                            });
                        }
                        if (!widthToHeights.has(widthValue)) {
                            widthToHeights.set(widthValue, new Set());
                        }
                        widthToHeights.get(widthValue).add(heightValue);
                        if (!heightToWidths.has(heightValue)) {
                            heightToWidths.set(heightValue, new Set());
                        }
                        heightToWidths.get(heightValue).add(widthValue);
                    });

                    if (!widthToHeights.size) {
                        // No options available but user can still enter custom values
                        return;
                    }

                    // Populate comboboxes with available die sizes
                    const sortedWidths = Array.from(widthToHeights.keys()).sort((a, b) => parseFloat(a) - parseFloat(b));
                    widthCombobox.setOptions(sortedWidths);

                    const sortedHeights = Array.from(heightToWidths.keys()).sort((a, b) => parseFloat(a) - parseFloat(b));
                    heightCombobox.setOptions(sortedHeights);

                    // Set initial values if they exist
                    if (widthInitialValue) {
                        widthInput.value = widthInitialValue;
                    }
                    if (heightInitialValue) {
                        heightInput.value = heightInitialValue;
                    }
                }

                function rebuildRadiusOptions() {
                    clearRadiusOptions('Select a radius');
                    const radiusMap = new Map();
                    dieOptionsCache.forEach(option => {
                        const radiusRaw = option.Radius__ ?? option.radius__ ?? option.radius ?? '';
                        const ref = option.StnsRef || option.stnsRef || '';
                        if (!radiusRaw || !ref) {
                            return;
                        }
                        const radiusValue = formatDimension(radiusRaw);
                        if (!radiusValue) {
                            return;
                        }
                        if (!radiusMap.has(radiusValue)) {
                            radiusMap.set(radiusValue, { dieValue: ref });
                        }
                    });

                    if (radiusMap.size === 0) {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No radius values available';
                        option.disabled = true;
                        option.selected = true;
                        radiusSelect.appendChild(option);
                        suppressRadiusSync = true;
                        radiusSelect.value = '';
                        suppressRadiusSync = false;
                        return;
                    }

                    const sortedRadii = Array.from(radiusMap.entries())
                        .sort((a, b) => parseFloat(a[0]) - parseFloat(b[0]));

                    sortedRadii.forEach(([radiusValue, meta]) => {
                        const radiusOption = document.createElement('option');
                        radiusOption.value = radiusValue;
                        radiusOption.textContent = `${radiusValue}"`;
                        radiusOption.dataset.dieValue = meta.dieValue;
                        radiusSelect.appendChild(radiusOption);
                    });

                    if (radiusInitialValue) {
                        const match = radiusSelect.querySelector(`option[value="${radiusInitialValue}"]`);
                        if (match) {
                            radiusSelect.value = radiusInitialValue;
                            if (match.dataset.dieValue) {
                                dieSelect.value = match.dataset.dieValue;
                            }
                        }
                        radiusInitialValue = '';
                    }
                }

                function clearDieOptions(message = 'Select a die size') {
                    dieSelect.innerHTML = `<option value="">${message}</option>`;
                    clearRadiusOptions('Select a radius');
                    clearDimensions();
                }

                function rebuildDieOptions() {
                    dieSelect.innerHTML = '<option value="">Select a die size</option>';
                    if (!dieOptionsCache.length) {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No die sizes available';
                        option.disabled = true;
                        option.selected = true;
                        dieSelect.appendChild(option);
                        clearWidthOptions('No widths available');
                        clearHeightOptions('No heights available');
                        clearRadiusOptions('No radius values available');
                        clearDimensions();
                        return;
                    }

                    dieOptionsCache.forEach(option => {
                        const dieOption = document.createElement('option');
                        const ref = option.StnsRef || option.stnsRef || '';
                        const description = option.StnsOms || option.stnsOms || ref || 'Unnamed Die';
                        const across = option.etiket_b ?? option.etiket_B ?? '';
                        const around = option.etiket_h ?? option.etiket_H ?? '';
                        const radius = option.Radius__ ?? option.radius__ ?? '';
                        dieOption.value = ref;
                        dieOption.textContent = description;
                        if (across || around) {
                            dieOption.textContent += ` (${across}" x ${around}")`;
                        }
                        if (radius) {
                            dieOption.textContent += ` • Radius ${radius}"`;
                        }
                        if (across) dieOption.dataset.width = across;
                        if (around) dieOption.dataset.height = around;
                        if (radius) dieOption.dataset.radius = radius;
                        dieSelect.appendChild(dieOption);
                    });

                    rebuildWidthHeightOptions();
                    rebuildRadiusOptions();

                    if (widthInitialValue && heightInitialValue) {
                        selectDieByDimensions(widthInitialValue, heightInitialValue);
                    }

                    syncDimensionsFromDie();
                    widthInitialValue = '';
                    heightInitialValue = '';
                }

                async function loadDieOptions({ suppressErrors = false } = {}) {
                    const printingSelection = (printingInput.value || '').trim();
                    if (!printingSelection) {
                        if (!suppressErrors) {
                            dieError.textContent = 'Select a printing option to see die sizes.';
                            dieError.classList.remove('d-none');
                        } else {
                            dieError.classList.add('d-none');
                        }
                        clearDieOptions('Select a printing option to see die sizes');
                        return;
                    }

                    if (cachedPrintingKey === printingSelection && dieOptionsCache.length) {
                        rebuildDieOptions();
                        return;
                    }

                    dieLoading.classList.remove('d-none');
                    dieError.classList.add('d-none');

                    try {
                        const response = await fetch(`/Api/CuttingDie?printing=${encodeURIComponent(printingSelection)}`, {
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!response.ok) {
                            const errorPayload = await response.json().catch(() => ({ }));
                            throw new Error(errorPayload.error || `Unable to load die sizes (${response.status})`);
                        }

                        const payload = await response.json();
                        dieOptionsCache = payload.cuttingDieOptions || payload.data || payload.items || payload.results || [];
                        cachedPrintingKey = printingSelection;
                        rebuildDieOptions();
                    } catch (error) {
                        console.error('Failed to load die sizes', error);
                        dieError.textContent = error.message || 'Unable to load die sizes right now.';
                        dieError.classList.remove('d-none');
                        clearDieOptions('Unable to load die sizes');
                    } finally {
                        dieLoading.classList.add('d-none');
                    }
                }

                dieSelect.addEventListener('change', () => {
                    syncDimensionsFromDie();
                });

                radiusSelect.addEventListener('change', () => {
                    if (suppressRadiusSync) {
                        return;
                    }
                    const selected = radiusSelect.selectedOptions[0];
                    const dieValue = selected?.dataset?.dieValue;
                    if (dieValue) {
                        dieSelect.value = dieValue;
                        syncDimensionsFromDie();
                    } else {
                        clearDimensions();
                    }
                });

                widthInput.addEventListener('input', () => {
                    if (suppressDimensionSync) {
                        return;
                    }
                    const widthValue = widthInput.value.trim();

                    if (!widthValue) {
                        dieSelect.value = '';
                        customDieWarning?.classList.add('d-none');
                        // Clear hidden fields
                        const isCustomDieInput = document.getElementById('is-custom-die');
                        const dieSizeInfoInput = document.getElementById('die-size-info');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        if (typeof validateLabelSize === 'function') validateLabelSize();
                        if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                        return;
                    }

                    // Check if this matches a die size
                    if (widthToHeights.has(widthValue)) {
                        const possibleHeights = Array.from(widthToHeights.get(widthValue));
                        let heightValue = heightInput.value.trim();
                        if (!heightValue || !possibleHeights.includes(heightValue)) {
                            suppressDimensionSync = true;
                            heightInput.value = possibleHeights[0];
                            suppressDimensionSync = false;
                            heightValue = possibleHeights[0];
                        }
                        if (selectDieByDimensions(widthValue, heightValue)) {
                            syncDimensionsFromDie();
                            return;
                        }
                    }

                    // Custom value or no match - check and update warning
                    dieSelect.value = '';
                    checkCustomDieWarning();
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                heightInput.addEventListener('input', () => {
                    if (suppressDimensionSync) {
                        return;
                    }
                    const heightValue = heightInput.value.trim();

                    if (!heightValue) {
                        dieSelect.value = '';
                        customDieWarning?.classList.add('d-none');
                        // Clear hidden fields
                        const isCustomDieInput = document.getElementById('is-custom-die');
                        const dieSizeInfoInput = document.getElementById('die-size-info');
                        if (isCustomDieInput) isCustomDieInput.value = 'false';
                        if (dieSizeInfoInput) dieSizeInfoInput.value = '';
                        if (typeof validateLabelSize === 'function') validateLabelSize();
                        if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                        return;
                    }

                    // Check if this matches a die size
                    if (heightToWidths.has(heightValue)) {
                        const possibleWidths = Array.from(heightToWidths.get(heightValue));
                        let widthValue = widthInput.value.trim();
                        if (!widthValue || !possibleWidths.includes(widthValue)) {
                            suppressDimensionSync = true;
                            widthInput.value = possibleWidths[0];
                            suppressDimensionSync = false;
                            widthValue = possibleWidths[0];
                        }
                        if (selectDieByDimensions(widthValue, heightValue)) {
                            syncDimensionsFromDie();
                            return;
                        }
                    }

                    // Custom value or no match - check and update warning
                    dieSelect.value = '';
                    checkCustomDieWarning();
                    if (typeof validateLabelSize === 'function') validateLabelSize();
                    if (typeof updateSummaryPanel === 'function') updateSummaryPanel();
                });

                // Use combobox-select event for die size selection
                widthInput.addEventListener('combobox-select', (e) => {
                    if (suppressDimensionSync) return;

                    const widthValue = e.detail.value;
                    if (widthToHeights.has(widthValue)) {
                        const possibleHeights = Array.from(widthToHeights.get(widthValue));
                        let heightValue = heightInput.value.trim();
                        if (!heightValue || !possibleHeights.includes(heightValue)) {
                            suppressDimensionSync = true;
                            heightInput.value = possibleHeights[0];
                            suppressDimensionSync = false;
                            heightValue = possibleHeights[0];
                        }
                        if (selectDieByDimensions(widthValue, heightValue)) {
                            syncDimensionsFromDie();
                            // Still check to update die size info
                            checkCustomDieWarning();
                        }
                    } else {
                        checkCustomDieWarning();
                    }
                });

                heightInput.addEventListener('combobox-select', (e) => {
                    if (suppressDimensionSync) return;

                    const heightValue = e.detail.value;
                    if (heightToWidths.has(heightValue)) {
                        const possibleWidths = Array.from(heightToWidths.get(heightValue));
                        let widthValue = widthInput.value.trim();
                        if (!widthValue || !possibleWidths.includes(widthValue)) {
                            suppressDimensionSync = true;
                            widthInput.value = possibleWidths[0];
                            suppressDimensionSync = false;
                            widthValue = possibleWidths[0];
                        }
                        if (selectDieByDimensions(widthValue, heightValue)) {
                            syncDimensionsFromDie();
                            // Still check to update die size info
                            checkCustomDieWarning();
                        }
                    } else {
                        checkCustomDieWarning();
                    }
                });

                window.addEventListener('printingSelectionChanged', () => {
                    cachedPrintingKey = null;
                    dieOptionsCache = [];
                    loadDieOptions({ suppressErrors: true });
                });

                if ((printingInput.value || '').trim()) {
                    loadDieOptions({ suppressErrors: true });
                } else {
                    clearDieOptions('Select a printing option to see die sizes');
                }
            })();

            (function () {
                const addButton = document.getElementById('add-quantity');
                const rows = Array.from(document.querySelectorAll('#quantity-list .quantity-row'));
                if (!addButton || !rows.length) {
                    return;
                }

                function updateAddState() {
                    const hasHidden = rows.some(row => row.classList.contains('d-none'));
                    addButton.disabled = !hasHidden;
                }

                function showNextRow() {
                    const next = rows.find(row => row.classList.contains('d-none'));
                    if (next) {
                        next.classList.remove('d-none');
                    }
                }

                addButton.addEventListener('click', () => {
                    showNextRow();
                    updateAddState();
                });

                rows.forEach(row => {
                    const removeBtn = row.querySelector('.remove-quantity');
                    const input = row.querySelector('input[name="quantity"]');
                    if (!removeBtn || !input) {
                        return;
                    }

                    removeBtn.addEventListener('click', () => {
                        input.value = '';
                        row.classList.add('d-none');
                        updateAddState();
                    });
                });

                updateAddState();
            })();
        </script>
            </div>
        </div>
    </main>

    <!-- AI Chat Assistant Popup Panel -->
    <div id="chat-assistant" class="chat-assistant-panel">
        <div class="chat-assistant-header">
            <div>
                <h3 class="h6 mb-0">🤖 AI Quote Assistant</h3>
                <small class="text-muted">Describe your label needs</small>
            </div>
            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="chat-close" title="Close">
                ✕
            </button>
        </div>
        <div class="chat-assistant-messages" id="chat-messages">
            <div class="chat-message assistant">
                Hi! I can help you describe your label needs. Just tell me about your project in plain language, and I'll extract the specifications to fill out this form.
            </div>
        </div>
        <div class="chat-assistant-input">
            <textarea 
                id="chat-input" 
                class="form-control" 
                placeholder="E.g., I need 5000 vinyl labels, 2x3 inches..."
                rows="2"></textarea>
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="chat-clear">Clear</button>
                <button type="button" class="btn btn-sm btn-primary flex-grow-1" id="chat-send">Send</button>
            </div>
        </div>
    </div>

    <!-- Floating Chat Button -->
    <button type="button" class="chat-assistant-toggle" id="chat-toggle" title="Open AI Assistant">
        🤖 AI Assistant
    </button>
</div>

