@page "/GetQuote"
@model GetQuoteModel
@using System.Collections.Generic
@{
    ViewData["Title"] = "Get a Quote";
}

@if (Model.SavedQuoteRequest != null)
{
    <script id="saved-quote-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SavedQuoteRequest))</script>
    <script>
        console.log('Saved quote data available on page:', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SavedQuoteRequest)));
    </script>
}
<script id="printing-finish-filters" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PrintingFinishFilters ?? new Dictionary<string, string[]>()))
</script>

<div class="dashboard-container">
    @await Html.PartialAsync("_LeftSidebar")
    <main class="dashboard-main">
        <div class="quote-page-container">
            <div class="quote-main-content">
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCustomerName))
        {
            <div class="quote-form-header">
                <h1>@Model.SelectedCustomerName</h1>
            </div>
        }

        <form class="quote-form" method="post" id="quote-form" asp-page-handler="Submit">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">
                        @{
                            foreach (var entry in ViewData.ModelState.Values)
                            {
                                foreach (var error in entry.Errors)
                                {
                                    if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            }
                        }
                    </ul>
                </div>
            }

            <div class="mb-4">
                <label for="description" class="form-label fw-semibold">Project description</label>
                <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="3"
                    maxlength="50"
                    placeholder="What are we quoting?"
                >@(Model.SavedQuoteRequest?.Description ?? string.Empty)</textarea>
                <div class="form-text">Up to 50 characters. Prefilled when you start from a past quote.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="shape-input">Shape</label>
                <input type="hidden" id="shape-input" name="shape" value="@(Model.SavedQuoteRequest?.Shape ?? string.Empty)" />
                <input type="hidden" id="shape-outline" name="shapeValue" value="@(Model.SavedQuoteRequest?.ShapeValue ?? string.Empty)" />
                <div class="d-flex flex-wrap gap-2" id="shape-options">
                    @{ var shapes = new (string Key, string Label, string OutlineId)[]
                        {
                            ("rectangle", "Rectangle", "1"),
                            ("square", "Square", "2"),
                            ("circle", "Circle", "3"),
                            ("oval", "Oval", "4")
                        };
                        var savedShape = (Model.SavedQuoteRequest?.Shape ?? string.Empty).Trim();
                        var savedShapeValue = (Model.SavedQuoteRequest?.ShapeValue ?? string.Empty).Trim();
                        var shapeIcons = new Dictionary<string, string>
                        {
                            ["rectangle"] = "<svg width=\"32\" height=\"20\" viewBox=\"0 0 32 20\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"1\" y=\"1\" width=\"30\" height=\"18\" rx=\"2\" ry=\"2\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>",
                            ["square"] = "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"2\" ry=\"2\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>",
                            ["circle"] = "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>",
                            ["oval"] = "<svg width=\"32\" height=\"20\" viewBox=\"0 0 32 20\" aria-hidden=\"true\" focusable=\"false\"><ellipse cx=\"16\" cy=\"10\" rx=\"13\" ry=\"8\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>"
                        };
                    }
                    @foreach (var shape in shapes)
                    {
                        var isActive = shape.Label.Equals(savedShape, StringComparison.OrdinalIgnoreCase)
                            || shape.Key.Equals(savedShape, StringComparison.OrdinalIgnoreCase)
                            || shape.OutlineId.Equals(savedShapeValue, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-outline-secondary shape-option @(isActive ? "active" : string.Empty)"
                                data-value="@shape.Key"
                                data-shape-key="@shape.Key"
                                data-outline-id="@shape.OutlineId"
                                data-label="@shape.Label">
                            <span class="shape-icon me-1">@Html.Raw(shapeIcons[shape.Key])</span>
                            @shape.Label
                        </button>
                    }
                </div>
            </div>

                    <div class="mb-4 d-none" id="corner-options">
                        <label class="form-label fw-semibold" for="corners-input">Corners</label>
                        <input type="hidden" id="corners-input" name="corners" value="@(Model.SavedQuoteRequest?.Corners ?? string.Empty)" />
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                var cornerChoices = new (string Value, string Label)[]
                                {
                                                        ("rounded", "Rounded"),
                                                        ("square", "Square")
                                };
                                var savedCorner = (Model.SavedQuoteRequest?.Corners ?? string.Empty).Trim();
                            }
                            @foreach (var corner in cornerChoices)
                            {
                                var cornerActive = corner.Label.Equals(savedCorner, StringComparison.OrdinalIgnoreCase) || corner.Value.Equals(savedCorner, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="btn btn-outline-secondary corner-option @(cornerActive ? "active" : string.Empty)"
                                        data-value="@corner.Value"
                                        data-label="@corner.Label">
                                    @corner.Label
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-4 d-none" id="existing-die-section">
                        <label class="form-label fw-semibold" for="existing-die-select">Existing Die Size</label>
                        <select class="form-select" id="existing-die-select" name="existingDie">
                            <option value="">Select a die size</option>
                        </select>
                        <div id="die-loading" class="form-text text-muted d-none">Loading die sizes…</div>
                        <div id="die-error" class="form-text text-danger d-none"></div>
                    </div>
            <div class="mb-4" id="dimensions-rectangles">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="label-width" class="form-label fw-semibold">Width (inches)</label>
                        <div class="custom-combobox" id="width-combobox">
                            <input 
                                type="text" 
                                class="form-control custom-combobox-input" 
                                id="label-width"
                                name="labelWidth"
                                placeholder="Enter or select width"
                                autocomplete="off"
                                value="@(Model.SavedQuoteRequest?.LabelWidth ?? string.Empty)"
                                data-initial-value="@(Model.SavedQuoteRequest?.LabelWidth ?? string.Empty)">
                            <span class="custom-combobox-arrow">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                                    <path d="M2 4l4 4 4-4H2z"/>
                                </svg>
                            </span>
                            <ul class="custom-combobox-dropdown"></ul>
                        </div>
                        <div class="form-text">Enter a custom size or select from available die sizes</div>
                    </div>
                    <div class="col-md-6">
                        <label for="label-height" class="form-label fw-semibold">Height (inches)</label>
                        <div class="custom-combobox" id="height-combobox">
                            <input 
                                type="text" 
                                class="form-control custom-combobox-input" 
                                id="label-height"
                                name="labelHeight"
                                placeholder="Enter or select height"
                                autocomplete="off"
                                value="@(Model.SavedQuoteRequest?.LabelHeight ?? string.Empty)"
                                data-initial-value="@(Model.SavedQuoteRequest?.LabelHeight ?? string.Empty)">
                            <span class="custom-combobox-arrow">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                                    <path d="M2 4l4 4 4-4H2z"/>
                                </svg>
                            </span>
                            <ul class="custom-combobox-dropdown"></ul>
                        </div>
                        <div class="form-text">Enter a custom size or select from available die sizes</div>
                    </div>
                </div>
                <div id="custom-die-warning" class="alert alert-warning mt-3 d-none" role="alert">
                    <strong>⚠️ Custom Die Required</strong>
                    <p class="mb-0">The dimensions you entered (<span id="custom-dimensions"></span>) don't match any existing die sizes. A custom die will need to be created for this job, which may affect pricing and lead time.</p>
                </div>

                <!-- Hidden fields to track die size information -->
                <input type="hidden" id="die-size-info" name="dieSizeInfo" value="">
                <input type="hidden" id="is-custom-die" name="isCustomDie" value="false">
            </div>

            <div class="mb-4 d-none" id="dimensions-radius">
                <label for="label-radius" class="form-label fw-semibold">Radius (inches)</label>
                <select class="form-select"
                        id="label-radius"
                        name="diameter"
                        data-initial-value="@(Model.SavedQuoteRequest?.Diameter ?? string.Empty)">
                    <option value="">Select a radius</option>
                </select>
                <div class="form-text">Displayed for circle or oval labels and populated from available die sizes.</div>
            </div>

            <div class="mb-4">
                <label for="material-select" class="form-label fw-semibold">Material</label>
                <select
                    class="form-select"
                    id="material-select"
                    name="material"
                    size="8"
                    data-initial-value="@(Model.SavedQuoteRequest?.MaterialValue ?? string.Empty)"
                    data-initial-label="@(Model.SavedQuoteRequest?.Material ?? string.Empty)">
                    <option value="">Loading materials…</option>
                </select>
                <input type="hidden" id="material-display" name="materialDisplay" value="@(Model.SavedQuoteRequest?.Material ?? string.Empty)" />
                <div id="material-loading" class="form-text text-muted">Loading materials…</div>
                <div id="material-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="printing-input">Printing</label>
                <input type="hidden" id="printing-input" name="printing" value="@(Model.SavedQuoteRequest?.Printing ?? string.Empty)" />
                <input type="hidden" id="printing-value" name="printingValue" value="@(Model.SavedQuoteRequest?.PrintingValue ?? string.Empty)" />
                <div id="printing-loading" class="form-text text-muted">Loading printing options…</div>
                <div id="printing-filter" class="printing-filter d-flex flex-wrap gap-2"
                     data-initial-id="@(Model.SavedQuoteRequest?.PrintingValue ?? string.Empty)"
                     data-initial-label="@(Model.SavedQuoteRequest?.Printing ?? string.Empty)">
                </div>
                <div id="printing-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <label for="finish-select" class="form-label fw-semibold">Finish</label>
                <select
                    class="form-select"
                    id="finish-select"
                    name="finish"
                    data-initial-value="@(Model.SavedQuoteRequest?.Finish ?? string.Empty)">
                    <option value="">Loading finishes…</option>
                </select>
                <div id="finish-loading" class="form-text text-muted">Loading finishes…</div>
                <div id="finish-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <label for="packing-procedure-select" class="form-label fw-semibold">Packing Procedure</label>
                <select
                    class="form-select"
                    id="packing-procedure-select"
                    name="packingProcedure"
                    data-initial-value="@(Model.SavedQuoteRequest?.PackingProcedure ?? string.Empty)">
                    <option value="">Loading packing procedures…</option>
                </select>
                <div id="packing-procedure-loading" class="form-text text-muted">Loading packing procedures…</div>
                <div id="packing-procedure-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="unwind-input">Unwind Direction / Copy Position</label>
                <input type="hidden" id="unwind-input" name="unwindDirection" value="@(Model.SavedQuoteRequest?.UnwindDirection ?? string.Empty)" />
                <div class="row row-cols-2 row-cols-md-4 g-2" id="unwind-options">
                    @{ var unwindOptions = new (string Value, string Label, string Description)[]
                        {
                            ("1", "1 - Top off first", "Labels feed with top edge leading"),
                            ("2", "2 - Bottom off first", "Bottom edge leads"),
                            ("3", "3 - Right off first", "Right edge leads"),
                            ("4", "4 - Left off first", "Left edge leads")
                        };
                        var savedUnwind = (Model.SavedQuoteRequest?.UnwindDirection ?? string.Empty).Trim();
                    }
                    @foreach (var option in unwindOptions)
                    {
                        var isActive = option.Label.Equals(savedUnwind, StringComparison.OrdinalIgnoreCase)
                            || option.Value.Equals(savedUnwind, StringComparison.OrdinalIgnoreCase);
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-secondary w-100 text-start unwind-option @(isActive ? "active" : string.Empty)"
                                    data-value="@option.Value"
                                    data-label="@option.Label">
                                <span class="d-flex align-items-center">
                                    <span class="unwind-icon me-2">
                                        @switch (option.Value)
                                        {
                                            case "1":
                                                @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="6" y="12" width="20" height="8" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><path d="M16 6v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                break;
                                            case "2":
                                                @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="6" y="12" width="20" height="8" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><path d="M16 26v-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 22l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                break;
                                            case "3":
                                                @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="12" y="6" width="8" height="20" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><path d="M26 16h-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M22 12l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                break;
                                            default:
                                                @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="12" y="6" width="8" height="20" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><path d="M6 16h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M10 12l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                break;
                                        }
                                    </span>
                                    <span>
                                        <span class="fw-semibold d-block">@option.Label</span>
                                        <small class="text-muted">@option.Description</small>
                                    </span>
                                </span>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Quantities to Quote</label>
                <div class="form-text mb-2">Add up to five breakouts so estimating can price each run size.</div>
                <div id="quantity-list" class="d-flex flex-column gap-2">
                    @{
                        var savedQuantities = Model.SavedQuoteRequest?.Quantities ?? new List<int>();
                        for (var i = 0; i < 5; i++)
                        {
                            var preset = i < savedQuantities.Count ? savedQuantities[i].ToString() : string.Empty;
                            var isVisible = i == 0 || !string.IsNullOrEmpty(preset);
                            <div class="quantity-row row g-2 @(isVisible ? string.Empty : "d-none")" data-index="@i">
                                <div class="col">
                                    <label class="form-label">Quantity @(i + 1)</label>
                                    <input type="number"
                                            class="form-control"
                                            name="quantity"
                                            min="1"
                                            step="1"
                                            value="@preset"
                                            placeholder="e.g., 5000" />
                                </div>
                                <div class="col-auto d-flex align-items-end">
                                    @if (i > 0)
                                    {
                                        <button type="button" class="btn btn-outline-danger remove-quantity" aria-label="Remove quantity @(i + 1)">
                                            Remove
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <button type="button" id="add-quantity" class="btn btn-outline-secondary btn-sm mt-2">Add another quantity</button>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="contact-name">Contact Information</label>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="contact-name" class="form-label">Full name</label>
                        <input type="text"
                               class="form-control"
                               id="contact-name"
                               name="name"
                               placeholder="Jane Doe"
                               value="@(Model.SavedQuoteRequest?.Name ?? string.Empty)" />
                    </div>
                    <div class="col-md-6">
                        <label for="contact-company" class="form-label">Company</label>
                        <input type="text"
                               class="form-control"
                               id="contact-company"
                               name="company"
                               placeholder="Acme Corp"
                               value="@(Model.SavedQuoteRequest?.Company ?? string.Empty)" />
                    </div>
                    <div class="col-md-6">
                        <label for="contact-email" class="form-label">Email address</label>
                        <input type="email"
                               class="form-control"
                               id="contact-email"
                               name="email"
                               placeholder="name@example.com"
                               value="@(Model.SavedQuoteRequest?.Email ?? string.Empty)" />
                    </div>
                    <div class="col-md-6">
                        <label for="contact-phone" class="form-label">Phone number</label>
                        <input type="tel"
                               class="form-control"
                               id="contact-phone"
                               name="phone"
                               placeholder="555-123-4567"
                               value="@(Model.SavedQuoteRequest?.Phone ?? string.Empty)" />
                    </div>
                    <div class="col-12">
                        <label for="contact-comments" class="form-label">Comments</label>
                        <textarea class="form-control" id="contact-comments" name="comments" rows="3" placeholder="Anything else we should know?">@(Model.SavedQuoteRequest?.Comments ?? string.Empty)</textarea>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary">Get Quote Prices</button>
            </div>

        </form>

        <script>
            (function () {
                const materialSelect = document.getElementById('material-select');
                if (!materialSelect) {
                    return;
                }

                const materialLoading = document.getElementById('material-loading');
                const materialError = document.getElementById('material-error');
                const materialDisplayInput = document.getElementById('material-display');
                const initialValue = (materialSelect.dataset.initialValue || '').trim();
                const initialLabel = (materialSelect.dataset.initialLabel || '').trim();

                function updateMaterialDisplay() {
                    if (!materialDisplayInput) {
                        return;
                    }
                    const selected = materialSelect.options[materialSelect.selectedIndex];
                    const displayText = selected?.dataset.display || selected?.textContent || '';
                    materialDisplayInput.value = displayText;
                }

                function getDescription(material) {
                    const descriptions = material.Descriptions || material.descriptions || [];
                    const en = descriptions.find(d => (d.ISOLanguageCode || d.isoLanguageCode || '').toLowerCase() === 'en-us');
                    const fallback = descriptions[0];
                    return (en && (en.Description || en.description))
                        || (fallback && (fallback.Description || fallback.description))
                        || material.Id
                        || material.id
                        || 'Unknown Material';
                }

                function populateMaterials(materials) {
                    materialSelect.innerHTML = '<option value="">Select a material</option>';
                    materials.forEach(material => {
                        const materialId = material.SubstrateId || material.substrateId || material.Id || material.id || '';
                        const description = getDescription(material);
                        const option = document.createElement('option');
                        option.value = materialId || description;
                        option.textContent = description;
                        option.dataset.display = description;
                        option.dataset.materialId = materialId;
                        if (initialValue && option.value === initialValue) {
                            option.selected = true;
                        } else if (!initialValue && initialLabel && description.toLowerCase() === initialLabel.toLowerCase()) {
                            option.selected = true;
                        }
                        materialSelect.appendChild(option);
                    });

                    if (!materialSelect.value && initialValue) {
                        materialSelect.value = initialValue;
                    }

                    updateMaterialDisplay();
                }

                async function loadMaterials() {
                    try {
                        materialLoading.classList.remove('d-none');
                        materialError.classList.add('d-none');
                        const response = await fetch('/Api/Materials', { headers: { 'Accept': 'application/json' } });
                        if (!response.ok) {
                            const errorData = await response.json().catch(() => ({ error: 'Unable to load materials right now.' }));
                            throw new Error(errorData.error || `Unable to load materials (${response.status})`);
                        }

                        const payload = await response.json();
                        const materials = payload.materials || payload.data || payload.items || payload.results || payload;
                        if (!Array.isArray(materials) || materials.length === 0) {
                            throw new Error('No materials were returned.');
                        }
                        populateMaterials(materials);
                    } catch (error) {
                        console.error('Failed to load materials', error);
                        materialError.textContent = error.message || 'Unable to load materials right now.';
                        materialError.classList.remove('d-none');
                        materialSelect.innerHTML = '<option value="">Unable to load materials</option>';
                    } finally {
                        materialLoading.classList.add('d-none');
                    }
                }

                materialSelect.addEventListener('change', updateMaterialDisplay);

                loadMaterials();
            })();

            (function () {
                const printingFilter = document.getElementById('printing-filter');
                const printingLoading = document.getElementById('printing-loading');
                const printingError = document.getElementById('printing-error');
                const printingInput = document.getElementById('printing-input');
                const printingValueInput = document.getElementById('printing-value');
                if (!printingFilter || !printingInput || !printingValueInput) {
                    return;
                }

                const initialId = (printingFilter.dataset.initialId || '').trim();
                const initialLabel = (printingFilter.dataset.initialLabel || '').trim();

                const slugify = (text) => (text || '')
                    .toString()
                    .trim()
                    .toLowerCase()
                    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

                const deriveLegacyKey = (label) => {
                    const normalized = (label || '').toLowerCase();
                    if (!normalized) return '';
                    if (normalized.includes('white') && normalized.includes('cmyk')) return 'white-cmyk-digital';
                    if (normalized.includes('black') && normalized.includes('digital')) return 'black-only-digital';
                    if (normalized.includes('process') && normalized.includes('digital')) return 'process-digital';
                    if (normalized.includes('spot') && normalized.includes('2')) return 'spot-2-standard';
                    if (normalized.includes('spot') && normalized.includes('1')) return 'spot-1-standard';
                    if (normalized.includes('flexo')) return 'flexo';
                    if (normalized.includes('digital')) return 'digital';
                    return '';
                };

                const dispatchSelection = (detail) => {
                    window.dispatchEvent(new CustomEvent('printingSelectionChanged', { detail }));
                };

                const setActive = (button, raiseEvent = true) => {
                    printingFilter.querySelectorAll('button').forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');

                    const label = button.getAttribute('data-printing-text') || button.textContent.trim();
                    const id = button.getAttribute('data-printing-id') || '';
                    const legacyKey = button.getAttribute('data-printing-key') || slugify(label);

                    printingInput.value = label;
                    printingValueInput.value = id;

                    if (raiseEvent) {
                        dispatchSelection({
                            id,
                            label,
                            key: legacyKey,
                            slug: slugify(label)
                        });
                    }
                };

                const normalizePayload = (payload) => {
                    if (!payload) return [];
                    const candidates = [payload, payload.data, payload.Data, payload.items, payload.Items, payload.results, payload.Results, payload.colourCodes, payload.ColourCodes];
                    for (const candidate of candidates) {
                        if (Array.isArray(candidate)) {
                            return candidate;
                        }
                    }
                    return [];
                };

                const extractId = (entry) => {
                    const colourBacking = entry?.ColourBacking || entry?.colourBacking;
                    return colourBacking?.Id || entry?.Id || entry?.id || entry?.ColourCodeId || entry?.colourCodeId || entry?.ColorCodeId || entry?.colorCodeId || '';
                };

                const extractDescription = (entry) => {
                    const colourBacking = entry?.ColourBacking || entry?.colourBacking;
                    const source = colourBacking || entry;
                    const descriptions = source?.Descriptions || source?.Discriptions || source?.descriptions || source?.discriptions;
                    if (Array.isArray(descriptions) && descriptions.length) {
                        const preferred = descriptions.find(d => (d?.ISOLanguageCode || d?.isoLanguageCode || '').toLowerCase() === 'en-us') || descriptions[0];
                        return preferred?.Description || preferred?.description || '';
                    }
                    return '';
                };

