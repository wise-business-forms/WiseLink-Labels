@page "/GetQuote"
@model GetQuoteModel
@using System.Collections.Generic
@{
    ViewData["Title"] = "Get a Quote";

    string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 Bytes";
        var k = 1024.0;
        var sizes = new[] { "Bytes", "KB", "MB", "GB" };
        var i = (int)Math.Floor(Math.Log(bytes) / Math.Log(k));
        return $"{Math.Round(bytes / Math.Pow(k, i), 2)} {sizes[i]}";
    }
}

@if (Model.SavedQuoteRequest != null)
{
    <script id="saved-quote-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SavedQuoteRequest))</script>
    <script>
        console.log('Saved quote data available on page:', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SavedQuoteRequest)));
    </script>
}
<script id="printing-finish-filters" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PrintingFinishFilters ?? new Dictionary<string, string[]>()))
</script>

<div class="dashboard-container">
    @await Html.PartialAsync("_LeftSidebar")
    <main class="dashboard-main">
        <div class="quote-page-container">
            <div class="quote-main-content">
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCustomerName))
        {
            <div class="quote-form-header">
                <h1>@Model.SelectedCustomerName</h1>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SavedQuoteRequest?.CalculationId) || !string.IsNullOrWhiteSpace(Model.SavedQuoteRequest?.EstimateId))
        {
            <div class="alert alert-info d-flex align-items-center justify-content-between mb-4" role="alert">
                <div>
                    <strong>?? Reference Quote:</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.SavedQuoteRequest.EstimateId))
                    {
                        <span class="badge bg-primary me-2">Estimate ID: @Model.SavedQuoteRequest.EstimateId</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SavedQuoteRequest.CalculationId))
                    {
                        <span class="badge bg-secondary">Calculation ID: @Model.SavedQuoteRequest.CalculationId</span>
                    }
                </div>
                <small class="text-muted">This form is pre-filled from a past quote</small>
            </div>
        }

        <form class="quote-form" method="post" id="quote-form" asp-page-handler="Submit" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="customerId" value="@(Model.SavedQuoteRequest?.CustomerId ?? string.Empty)" />
            <input type="hidden" name="customerDisplayName" value="@(Model.SavedQuoteRequest?.CustomerDisplayName ?? string.Empty)" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">
                        @{
                            foreach (var entry in ViewData.ModelState.Values)
                            {
                                foreach (var error in entry.Errors)
                                {
                                    if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            }
                        }
                    </ul>
                </div>

                @if (!string.IsNullOrEmpty(Model.ApiRequestJson) || !string.IsNullOrEmpty(Model.ApiResponseJson))
                {
                    <div class="card mt-3 mb-4 border-secondary" style="font-family:'Segoe UI',Roboto,Arial,sans-serif;">
                        <div class="card-header bg-secondary bg-opacity-10 p-2">
                            <h6 class="mb-0">
                                <button class="btn btn-link text-decoration-none w-100 text-start d-flex justify-content-between align-items-center py-0"
                                        type="button" data-bs-toggle="collapse"
                                        data-bs-target="#debugApiErrorCollapse"
                                        aria-expanded="false" aria-controls="debugApiErrorCollapse">
                                    <span>&#x1F527; Debug: API Request/Response</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-down" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                    </svg>
                                </button>
                            </h6>
                        </div>
                        <div class="collapse" id="debugApiErrorCollapse">
                            <div class="card-body p-3">
                                @if (!string.IsNullOrEmpty(Model.ApiRequestJson))
                                {
                                    <p class="text-muted small mb-2 fw-bold">Request JSON sent to CERM API:</p>
                                    <pre class="bg-light p-3 rounded border mb-3" style="max-height: 400px; overflow-y: auto; font-size: 0.8rem; white-space: pre-wrap; word-wrap: break-word;"><code>@Model.ApiRequestJson</code></pre>
                                }
                                @if (!string.IsNullOrEmpty(Model.ApiResponseJson))
                                {
                                    <p class="text-muted small mb-2 fw-bold">Response from CERM API:</p>
                                    <pre class="bg-light p-3 rounded border" style="max-height: 400px; overflow-y: auto; font-size: 0.8rem; white-space: pre-wrap; word-wrap: break-word;"><code>@Model.ApiResponseJson</code></pre>
                                }
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="mb-4">
                <label for="description" class="form-label fw-semibold">Project description</label>
                <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="3"
                    maxlength="50"
                    placeholder="What are we quoting?"
                >@(Model.SavedQuoteRequest?.Description ?? string.Empty)</textarea>
                <div class="form-text">Up to 50 characters. Prefilled when you start from a past quote.</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="shape-input">Shape</label>
                <input type="hidden" id="shape-input" name="shape" value="@(Model.SavedQuoteRequest?.Shape ?? string.Empty)" />
                <input type="hidden" id="shape-outline" name="shapeValue" value="@(Model.SavedQuoteRequest?.ShapeValue ?? string.Empty)" />
                <div class="d-flex flex-wrap gap-2" id="shape-options">
                    @{ var shapes = new (string Key, string Label, string OutlineId)[]
                        {
                            ("rectangle", "Rectangle", "1"),
                            ("circle", "Circle", "2")
                        };
                        var savedShape = (Model.SavedQuoteRequest?.Shape ?? string.Empty).Trim();
                        var savedShapeValue = (Model.SavedQuoteRequest?.ShapeValue ?? string.Empty).Trim();
                        var shapeIcons = new Dictionary<string, string>
                        {
                            ["rectangle"] = "<svg width=\"32\" height=\"20\" viewBox=\"0 0 32 20\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"1\" y=\"1\" width=\"30\" height=\"18\" rx=\"2\" ry=\"2\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>",
                            ["circle"] = "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"currentColor\" opacity=\"0.15\" stroke=\"currentColor\" stroke-width=\"2\" /></svg>"
                        };
                    }
                    @foreach (var shape in shapes)
                    {
                        var isActive = shape.Label.Equals(savedShape, StringComparison.OrdinalIgnoreCase)
                            || shape.Key.Equals(savedShape, StringComparison.OrdinalIgnoreCase)
                            || shape.OutlineId.Equals(savedShapeValue, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-outline-secondary shape-option @(isActive ? "active" : string.Empty)"
                                data-value="@shape.Key"
                                data-shape-key="@shape.Key"
                                data-outline-id="@shape.OutlineId"
                                data-label="@shape.Label">
                            <span class="shape-icon me-1">@Html.Raw(shapeIcons[shape.Key])</span>
                            @shape.Label
                        </button>
                    }
                </div>
            </div>

                    <div class="mb-4 d-none" id="corner-options">
                        <label class="form-label fw-semibold" for="corners-input">Corners</label>
                        @if (Model.SavedQuoteRequest != null && string.IsNullOrWhiteSpace(Model.SavedQuoteRequest.Corners))
                        {
                            <div class="alert alert-warning alert-sm mb-2" role="alert" id="corner-warning-alert">
                                <strong>?? Selection Required:</strong> Please select the corner type for your labels.
                            </div>
                        }
                        <input type="hidden" id="corners-input" name="corners" value="@(Model.SavedQuoteRequest?.Corners ?? string.Empty)" />
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                var cornerChoices = new (string Value, string Label)[]
                                {
                                                        ("rounded", "Rounded"),
                                                        ("square", "Square")
                                };
                                var savedCorner = (Model.SavedQuoteRequest?.Corners ?? string.Empty).Trim();
                            }
                            @foreach (var corner in cornerChoices)
                            {
                                var cornerActive = corner.Label.Equals(savedCorner, StringComparison.OrdinalIgnoreCase) || corner.Value.Equals(savedCorner, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="btn btn-outline-secondary corner-option @(cornerActive ? "active" : string.Empty)"
                                        data-value="@corner.Value"
                                        data-label="@corner.Label">
                                    @corner.Label
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-4 d-none" id="existing-die-section">
                        <label class="form-label fw-semibold" for="existing-die-select">Existing Die Size</label>
                        <select class="form-select" id="existing-die-select" name="existingDie">
                            <option value="">Select a die size</option>
                        </select>
                        <div id="die-loading" class="form-text text-muted d-none">Loading die sizes…</div>
                        <div id="die-error" class="form-text text-danger d-none"></div>
                    </div>
            <div class="mb-4" id="dimensions-rectangles">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="label-width" class="form-label fw-semibold">Width (inches)</label>
                        <div class="custom-combobox" id="width-combobox">
                            <input 
                                type="text" 
                                class="form-control custom-combobox-input" 
                                id="label-width"
                                name="labelWidth"
                                placeholder="Enter or select width"
                                autocomplete="off"
                                value="@(Model.SavedQuoteRequest?.LabelWidth ?? string.Empty)"
                                data-initial-value="@(Model.SavedQuoteRequest?.LabelWidth ?? string.Empty)">
                            <span class="custom-combobox-arrow">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                                    <path d="M2 4l4 4 4-4H2z"/>
                                </svg>
                            </span>
                            <ul class="custom-combobox-dropdown"></ul>
                        </div>
                        <div class="form-text">Enter a custom size or select from available die sizes</div>
                    </div>
                    <div class="col-md-6">
                        <label for="label-height" class="form-label fw-semibold">Height (inches)</label>
                        <div class="custom-combobox" id="height-combobox">
                            <input 
                                type="text" 
                                class="form-control custom-combobox-input" 
                                id="label-height"
                                name="labelHeight"
                                placeholder="Enter or select height"
                                autocomplete="off"
                                value="@(Model.SavedQuoteRequest?.LabelHeight ?? string.Empty)"
                                data-initial-value="@(Model.SavedQuoteRequest?.LabelHeight ?? string.Empty)">
                            <span class="custom-combobox-arrow">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                                    <path d="M2 4l4 4 4-4H2z"/>
                                </svg>
                            </span>
                            <ul class="custom-combobox-dropdown"></ul>
                        </div>
                        <div class="form-text">Enter a custom size or select from available die sizes</div>
                    </div>
                </div>
                <div id="custom-die-warning" class="alert alert-warning mt-3 d-none" role="alert">
                    <strong>?? Custom Die Required</strong>
                    <p class="mb-0">The dimensions you entered (<span id="custom-dimensions"></span>) don't match any existing die sizes. A custom die will need to be created for this job, which may affect pricing and lead time.</p>
                </div>

                <!-- Hidden fields to track die size information -->
                <input type="hidden" id="die-size-info" name="dieSizeInfo" value="">
                <input type="hidden" id="is-custom-die" name="isCustomDie" value="false">
            </div>

            <div class="mb-4 d-none" id="dimensions-radius">
                <label for="label-radius" class="form-label fw-semibold">Radius (inches)</label>
                <div class="custom-combobox" id="radius-combobox">
                    <input 
                        type="text" 
                        class="form-control custom-combobox-input" 
                        id="label-radius"
                        name="diameter"
                        placeholder="Enter or select radius"
                        autocomplete="off"
                        value="@(Model.SavedQuoteRequest?.Diameter ?? string.Empty)"
                        data-initial-value="@(Model.SavedQuoteRequest?.Diameter ?? string.Empty)">
                    <span class="custom-combobox-arrow">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
                            <path d="M2 4l4 4 4-4H2z"/>
                        </svg>
                    </span>
                    <ul class="custom-combobox-dropdown"></ul>
                </div>
                <div class="form-text">Enter a custom size or select from available die sizes</div>
                <div id="custom-die-warning-radius" class="alert alert-warning mt-3 d-none" role="alert">
                    <strong>?? Custom Die Required</strong>
                    <p class="mb-0">The radius you entered (<span id="custom-radius"></span>) doesn't match any existing die sizes. A custom die will need to be created for this job, which may affect pricing and lead time.</p>
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <label for="material-select" class="form-label fw-semibold mb-0">Material</label>
                    <button type="button" id="material-retry" class="btn btn-sm btn-outline-secondary d-none">&#x21BA; Retry</button>
                </div>
                <select
                    class="form-select"
                    id="material-select"
                    name="material"
                    size="8"
                    data-initial-value="@(Model.SavedQuoteRequest?.MaterialValue ?? string.Empty)"
                    data-initial-label="@(Model.SavedQuoteRequest?.Material ?? string.Empty)">
                    <option value="">Loading materials…</option>
                </select>
                <input type="hidden" id="material-display" name="materialDisplay" value="@(Model.SavedQuoteRequest?.Material ?? string.Empty)" />
                <div id="material-loading" class="form-text text-muted">Loading materials…</div>
                <div id="material-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <label class="form-label fw-semibold mb-0" for="printing-input">Printing</label>
                    <button type="button" id="printing-retry" class="btn btn-sm btn-outline-secondary d-none">&#x21BA; Retry</button>
                </div>
                <input type="hidden" id="printing-input" name="printing" value="@(Model.SavedQuoteRequest?.Printing ?? string.Empty)" />
                <input type="hidden" id="printing-value" name="printingValue" value="@(Model.SavedQuoteRequest?.PrintingValue ?? string.Empty)" />
                <div id="printing-loading" class="form-text text-muted">Loading printing options…</div>
                <div id="printing-filter" class="printing-filter d-flex flex-wrap gap-2"
                     data-initial-id="@(Model.SavedQuoteRequest?.PrintingValue ?? string.Empty)"
                     data-initial-label="@(Model.SavedQuoteRequest?.Printing ?? string.Empty)">
                </div>
                <div id="printing-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4 d-none" id="line-items-section">
                <h5 class="form-label fw-semibold mb-3">Line Items</h5>
                <div class="border rounded p-3">
                    @if (Model.SavedQuoteRequest != null)
                    {
                        <div class="alert alert-warning alert-sm mb-3 d-none" role="alert" id="line-items-warning-alert">
                            <strong>?? Action Required:</strong> Please review and fill out the line item fields below based on your quote requirements.
                        </div>
                    }

                    <div class="mb-3 d-none" id="color-changes-section">
                        <label for="color-changes" class="form-label fw-semibold">Number of Color Changes</label>
                        <input 
                            type="number" 
                            class="form-control" 
                            id="color-changes"
                            name="colorChanges"
                            min="0"
                            step="1"
                            placeholder="Enter number of color changes"
                            value="@(Model.SavedQuoteRequest?.ColorChanges?.ToString() ?? string.Empty)">
                        <div class="form-text">Enter the number of color changes needed for this job. Each change will be charged separately.</div>
                    </div>

                    <div class="mb-3 d-none" id="digital-version-changes-section">
                        <label for="digital-version-changes" class="form-label fw-semibold">Number of Digital Full Color Version Changes</label>
                        <input 
                            type="number" 
                            class="form-control" 
                            id="digital-version-changes"
                            name="digitalVersionChanges"
                            min="0"
                            step="1"
                            placeholder="Enter number of version changes"
                            value="@(Model.SavedQuoteRequest?.DigitalVersionChanges?.ToString() ?? string.Empty)">
                        <div class="form-text">Enter the number of version changes needed for this digital job. Each version change will be charged separately.</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input 
                                class="form-check-input" 
                                type="checkbox" 
                                id="needs-press-proof"
                                name="needsPressProof"
                                value="true"
                                @(Model.SavedQuoteRequest?.NeedsPressProof == true ? "checked" : "")>
                            <label class="form-check-label" for="needs-press-proof">
                                Press Proof - Print Only, Not Die Cut
                            </label>
                        </div>
                        <div class="mt-2 d-none" id="press-proof-quantity-section">
                            <label for="press-proof-quantity" class="form-label">Press Proof Quantity</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="press-proof-quantity"
                                name="pressProofQuantity"
                                min="1"
                                step="1"
                                placeholder="1"
                                value="@(Model.SavedQuoteRequest?.PressProofQuantity ?? 1)">
                            <div class="form-text">Enter the quantity for the press proof.</div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <div class="form-check">
                            <input 
                                class="form-check-input" 
                                type="checkbox" 
                                id="needs-spot-color-plate-change"
                                name="needsSpotColorPlateChange"
                                value="true"
                                @(Model.SavedQuoteRequest?.NeedsSpotColorPlateChange == true ? "checked" : "")>
                            <label class="form-check-label" for="needs-spot-color-plate-change">
                                Spot Color Plate/Copy Change
                            </label>
                        </div>
                        <div class="mt-2 d-none" id="spot-color-plate-change-quantity-section">
                            <label for="spot-color-plate-change-quantity" class="form-label">Plate/Copy Change Quantity</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="spot-color-plate-change-quantity"
                                name="spotColorPlateChangeQuantity"
                                min="1"
                                step="1"
                                placeholder="1"
                                value="@(Model.SavedQuoteRequest?.SpotColorPlateChangeQuantity ?? 1)">
                            <div class="form-text">Enter the quantity for plate/copy changes.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4" id="finish-section">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <label for="finish-select" class="form-label fw-semibold mb-0">Finish</label>
                    <button type="button" id="finish-retry" class="btn btn-sm btn-outline-secondary d-none">&#x21BA; Retry</button>
                </div>
                @if (Model.SavedQuoteRequest != null && string.IsNullOrWhiteSpace(Model.SavedQuoteRequest.Finish) && string.IsNullOrWhiteSpace(Model.SavedQuoteRequest.FinishValue))
                {
                    <div class="alert alert-warning alert-sm mb-2" role="alert" id="finish-warning-alert">
                        <strong>? Selection Required:</strong> Please select a finish type for your labels.
                    </div>
                }
                <input type="hidden" id="finish-value" name="finishValue" value="@(Model.SavedQuoteRequest?.FinishValue ?? string.Empty)" />
                <select
                    class="form-select"
                    id="finish-select"
                    name="finish"
                    data-initial-value="@(Model.SavedQuoteRequest?.FinishValue ?? Model.SavedQuoteRequest?.Finish ?? string.Empty)">
                    <option value="">Loading finishes…</option>
                </select>
                <div id="finish-loading" class="form-text text-muted">Loading finishes…</div>
                <div id="finish-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <label for="packing-procedure-select" class="form-label fw-semibold mb-0">Packing Procedure</label>
                    <button type="button" id="packing-retry" class="btn btn-sm btn-outline-secondary d-none">&#x21BA; Retry</button>
                </div>
                <select
                    class="form-select"
                    id="packing-procedure-select"
                    name="packingProcedure"
                    data-initial-value="@(Model.SavedQuoteRequest?.PackingProcedure ?? string.Empty)">
                    <option value="">Loading packing procedures…</option>
                </select>
                <input type="hidden" id="packing-procedure-value" name="packingProcedureValue" value="@(Model.SavedQuoteRequest?.PackingProcedureValue ?? string.Empty)" />
                <div id="packing-procedure-loading" class="form-text text-muted">Loading packing procedures…</div>
                <div id="packing-procedure-error" class="form-text text-danger d-none"></div>
            </div>

            <div class="mb-4 d-none" id="packing-quantity-section">
                <label for="packing-quantity" class="form-label fw-semibold">Labels per Roll</label>
                <input
                    type="number"
                    class="form-control"
                    id="packing-quantity"
                    name="packingQuantity"
                    min="1"
                    step="1"
                    placeholder="Enter number of labels per roll"
                    value="@(Model.SavedQuoteRequest?.PackingQuantity?.ToString() ?? string.Empty)">
                <div class="form-text">Specify how many labels should be on each roll</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold" for="unwind-input">Unwind Direction / Copy Position</label>
                <input type="hidden" id="unwind-input" name="unwindDirection" value="@(Model.SavedQuoteRequest?.UnwindDirection ?? string.Empty)" />
                <input type="hidden" id="unwind-value-input" name="unwindDirectionValue" value="@(Model.SavedQuoteRequest?.UnwindDirectionValue ?? string.Empty)" />
                <div class="row row-cols-2 row-cols-md-4 g-2" id="unwind-options">
                    @{ var unwindOptions = new (string Value, string Label, string Description)[]
                        {
                            ("0", "0 - TBD", "No Preference / Plant Choice"),
                            ("1", "1 - Top off first", "Labels feed with top edge leading"),
                            ("2", "2 - Bottom off first", "Bottom edge leads"),
                            ("3", "3 - Right off first", "Right edge leads"),
                            ("4", "4 - Left off first", "Left edge leads"),
                            ("-", "- N/A", "Not Applicable / Blank")
                        };
                        var savedUnwind = (Model.SavedQuoteRequest?.UnwindDirection ?? string.Empty).Trim();
                        var savedUnwindValue = (Model.SavedQuoteRequest?.UnwindDirectionValue ?? string.Empty).Trim();
                    }
                    @foreach (var option in unwindOptions)
                    {
                        // Match by: exact label match, exact value match (check both UnwindDirection and UnwindDirectionValue), or saved value starts with option value
                        var isActive = option.Label.Equals(savedUnwind, StringComparison.OrdinalIgnoreCase)
                            || option.Value.Equals(savedUnwind, StringComparison.OrdinalIgnoreCase)
                            || option.Value.Equals(savedUnwindValue, StringComparison.OrdinalIgnoreCase)
                            || (!string.IsNullOrEmpty(savedUnwind) && savedUnwind.StartsWith(option.Value + " ", StringComparison.OrdinalIgnoreCase))
                            || (!string.IsNullOrEmpty(savedUnwind) && savedUnwind.StartsWith(option.Value + "-", StringComparison.OrdinalIgnoreCase));
                        <div class="col">
                            <button type="button"
                                    class="btn btn-outline-secondary w-100 text-start unwind-option @(isActive ? "active" : string.Empty)"
                                    data-value="@option.Value"
                                    data-label="@option.Label">
                                <span class="d-flex align-items-center">
                                    <span class="unwind-icon me-2">
                                        @switch (option.Value)
                                         {
                                             case "0":
                                                 @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="12" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><text x="16" y="21" text-anchor="middle" font-size="15" font-weight="bold" fill="currentColor">?</text></svg>
                                                 break;
                                             case "1":
                                                 @:<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="6" y="12" width="20" height="8" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="2"/><path d="M16 6v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                 break;
                                             case "2":
